# Número de WhatsApp de Roda, con código de país y sin "+" ni espacios (ej.: 5491112345678)
PUBLIC_WHATSAPP=

# Dirección final de la web, sin barra al final (ej.: https://roda.studio). La usa la imagen para compartir.
SITE_URL=
# Mail de Roda (todavía no existe). Vacío: la web muestra el formulario de contacto en su lugar.
PUBLIC_MAIL=
# Link de la agenda (Cal.com o similar). Con él, el formulario de contacto deja agendar la reunión directo.
PUBLIC_AGENDA=
