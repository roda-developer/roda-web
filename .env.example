# Número de WhatsApp de Roda, con código de país y sin "+" ni espacios (ej.: 5491112345678)
PUBLIC_WHATSAPP=

# Dirección final de la web, sin barra al final (ej.: https://roda.studio). La usa la imagen para compartir.
SITE_URL=
# Mail de Roda (si no está, va rodadevelop@gmail.com).
PUBLIC_MAIL=
# Link de la agenda (si no está, va https://cal.com/roda-develop/30min).
PUBLIC_AGENDA=
# Clave de Web3Forms (si no está, va la de Roda). Con ella, el formulario de contacto llega al mail.
PUBLIC_WEB3FORMS_KEY=
