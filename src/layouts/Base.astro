---
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/inter-tight/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { MAIL, WHATSAPP } from '../content/contacto';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = 'Roda — Estudio web',
  descripcion = 'Webs que cuentan una historia. Roda es Giuliana y Facundo: diseño y desarrollo web a medida.',
} = Astro.props;
const imagen = new URL('/og.png', Astro.site ?? Astro.url).href;
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// Los datos de la empresa para Google (schema.org)
const empresa = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Roda',
  description: 'Estudio de diseño y desarrollo web en Buenos Aires: landings, webs multisección y tiendas online.',
  url: new URL('/', Astro.site ?? Astro.url).href,
  image: imagen,
  areaServed: 'AR',
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  founder: [{ '@type': 'Person', name: 'Giuliana Di Rocco' }, { '@type': 'Person', name: 'Facundo Thibaut' }],
  sameAs: ['https://instagram.com/roda.development'],
  email: MAIL,
  telephone: '+' + WHATSAPP,
};
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f2ee" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(empresa)} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png?v=3" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      window.scrollTo(0, 0);
      document.documentElement.classList.add('js');
      // Si el JS de movimiento no arranca, nada queda oculto.
      setTimeout(function () { if (!window.__rodaMotion) document.documentElement.classList.remove('js'); }, 4000);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
