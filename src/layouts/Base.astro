---
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/inter-tight/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { MAIL, WHATSAPP } from '../content/contacto';
// Visitas por página, sin cookies (Vercel Web Analytics: se activa en el panel de Vercel)
import Analytics from '@vercel/analytics/astro';
import { HTML_LANG, IDIOMAS, OG_LOCALE, equivalente, idiomaDe, textos } from '../i18n';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const idioma = idiomaDe(Astro.currentLocale);
const { metas } = textos(idioma);
const { titulo = metas.inicio.titulo, descripcion = metas.inicio.descripcion } = Astro.props;
const imagen = new URL('/og.png', Astro.site ?? Astro.url).href;
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// La misma página en los otros idiomas, para que Google muestre la versión de cada país (hreflang)
// Con la barra final, igual que la canónica y el sitemap
const conBarra = (ruta: string) => (ruta.endsWith('/') ? ruta : ruta + '/');
const alternativas = IDIOMAS.map((l) => ({ hreflang: HTML_LANG[l], href: new URL(conBarra(equivalente(Astro.url.pathname, l)), Astro.site ?? Astro.url).href }));
const porDefecto = new URL(conBarra(equivalente(Astro.url.pathname, 'es')), Astro.site ?? Astro.url).href;
// Los datos de la empresa para Google (schema.org)
const empresa = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Roda',
  description: metas.empresa,
  url: new URL('/', Astro.site ?? Astro.url).href,
  image: imagen,
  // Trabajamos para cualquier país
  areaServed: 'Worldwide',
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  founder: [{ '@type': 'Person', name: 'Giuliana Di Rocco' }, { '@type': 'Person', name: 'Facundo Thibaut' }],
  sameAs: ['https://instagram.com/roda.development'],
  email: MAIL,
  telephone: '+' + WHATSAPP,
};
---
<!doctype html>
<html lang={HTML_LANG[idioma]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f3f2ee" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <!-- Verificación de Google Search Console -->
    <meta name="google-site-verification" content="3tEIVGU7KAhx047kPRdxamCFTjkJUOXC69We-PIyEgw" />
    <link rel="canonical" href={canonica} />
    {alternativas.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={porDefecto} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(empresa)} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content={OG_LOCALE[idioma]} />
    {IDIOMAS.filter((l) => l !== idioma).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon-32.png?v=3" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-512.png?v=3" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }
      // La página arranca arriba (las animaciones lo necesitan), salvo al volver atrás: ahí vuelve a la altura donde estabas
      window.__rodaVolverA = 0;
      try {
        var navegacion = performance.getEntriesByType('navigation')[0];
        if (navegacion && navegacion.type === 'back_forward') {
          window.__rodaVolverA = Number(sessionStorage.getItem('roda:scroll:' + location.pathname)) || 0;
        }
      } catch (e) {}
      window.scrollTo(0, 0);
      addEventListener('pagehide', function () {
        try { sessionStorage.setItem('roda:scroll:' + location.pathname, String(Math.round(scrollY))); } catch (e) {}
      });
      document.documentElement.classList.add('js');
      // Si el JS de movimiento no arranca, nada queda oculto. Espera 20s: en celus lentos tarda, y si lo saca antes, las secciones fijas se desarman y la página salta.
      setTimeout(function () { if (!window.__rodaMotion) document.documentElement.classList.remove('js'); }, 20000);
    </script>
  </head>
  <body>
    <slot />
    <Analytics />
    <script is:inline>
      // Lo que ya se ve al cargar no espera al JS de movimiento: aparece con un fundido en CSS (más rápido en celus lentos).
      // Lo de más abajo sigue apareciendo al scrollear, con GSAP.
      (function () {
        var alto = window.innerHeight;
        document.querySelectorAll('[data-revelar]').forEach(function (el) {
          if (el.getBoundingClientRect().top < alto) {
            el.style.setProperty('--retraso', (Number(el.dataset.revelar || 0) * 0.042).toFixed(2) + 's');
            el.removeAttribute('data-revelar');
            el.classList.add('revelar-css');
          }
        });
      })();
      // Sin animaciones (movimiento reducido), volver atrás también recupera la altura
      if (window.__rodaVolverA && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        addEventListener('load', function () { window.scrollTo(0, window.__rodaVolverA); });
      }
    </script>
  </body>
</html>
