---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const {
  titulo = 'Roda — Estudio web',
  descripcion = 'Webs que cuentan una historia. Roda es Giuliana y Facundo: diseño y desarrollo web a medida.',
} = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a0a0b" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // Tono elegido en esta sesión, antes de pintar: sin saltos al recargar.
      try {
        var e = JSON.parse(sessionStorage.getItem('roda:respuestas') || '{}').estilo;
        if (typeof e === 'number') {
          document.documentElement.style.setProperty('--intensidad', String(Math.min(1, Math.max(0, e))));
          document.documentElement.dataset.tono = e >= 0.5 ? 'grita' : 'susurra';
        }
      } catch (err) {}
      // Si el JS de movimiento no arranca, nada queda oculto.
      setTimeout(function () { if (!window.__rodaMotion) document.documentElement.classList.remove('js'); }, 4000);
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
