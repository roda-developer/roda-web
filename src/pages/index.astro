---
import Base from '../layouts/Base.astro';
import Timecode from '../components/Timecode.astro';
import Motion from '../components/Motion.astro';
import Loader from '../sections/Loader.astro';
import Nav from '../sections/Nav.astro';
import Apertura from '../sections/Apertura.astro';
import ActoUno from '../sections/ActoUno.astro';
import ActoDos from '../sections/ActoDos.astro';
import Giro from '../sections/Giro.astro';
import Technicolor from '../sections/Technicolor.astro';
import ActoTres from '../sections/ActoTres.astro';
import Adelanto from '../sections/Adelanto.astro';
import Planes from '../sections/Planes.astro';
import Creativos from '../components/Creativos.astro';
import Cierre from '../sections/Cierre.astro';
import Pie from '../components/Pie.astro';
import { cierre } from '../content/guion';
---
<Base>
  <Loader />
  <Nav />
  <main id="pelicula" class="relative z-10 min-h-svh">
    <Apertura />
    <ActoUno />
    <ActoDos />
    <Giro />
    <Technicolor />
    <ActoTres />
    <Adelanto />
    <Planes />
    <Creativos />
    <Cierre />
  </main>
  <Pie />
  <!-- Escena post-créditos: para quienes se quedan hasta el final -->
  <div class="relative z-10 grid min-h-[50svh] place-items-center px-5 pb-16">
    <p class="max-w-[28ch] text-center text-2xl leading-snug text-tinta/55 italic md:text-3xl" data-revelar="18">
      {cierre.postCreditos}
    </p>
  </div>
  <Timecode />
  <Motion />
</Base>
