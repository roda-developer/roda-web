---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Pie from '../components/Pie.astro';
import Marca from '../components/Marca.astro';
import { nosotros as t } from '../content/guion';
import { WHATSAPP } from '../content/contacto';
import juntos from '../assets/nosotros/juntos.jpg';
import viaje from '../assets/nosotros/viaje.jpg';

const fondos = { juntos, viaje } as const;

// El video de fondo es opcional: alcanza con dejar public/nosotros/fondo.mp4 (y, si hay, fondo-vertical.mp4 para el celular).
// Mientras no esté, la secuencia usa las fotos con un zoom lento.
const publico = (archivo: string) => existsSync(join(process.cwd(), 'public', 'nosotros', archivo));
const video = publico('fondo.mp4') ? '/nosotros/fondo.mp4' : null;
const videoVertical = publico('fondo-vertical.mp4') ? '/nosotros/fondo-vertical.mp4' : null;

const { secuencia } = t;
// Sin movimiento (o sin JS) queda quieta la placa de los protagonistas, sobre su foto
const quieto = Math.max(0, secuencia.cuadros.findIndex((c) => c.tipo === 'credito'));
const link = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(t.mensaje)}`;
const textoSecuencia = secuencia.cuadros
  .filter((c) => c.tipo !== 'cierre')
  .map((c) => (c.tipo === 'credito' ? `${c.rol} ${c.nombres.join(' ')}` : c.tipo === 'tagline' ? c.lineas.join(' ') : c.tipo === 'titulo' ? c.palabras.join(' ') : c.texto))
  .join('. ');
---
<Base titulo="Nosotros — Roda" descripcion="Roda es Giuliana y Facundo: pareja, socios y desarrolladores web egresados de la UNLaM.">
  <Nav enHome={false} />
  <main class="relative z-10">
    <!-- La secuencia de títulos: el fondo corre como un video y el título cambia de a una palabra al bajar -->
    <section class="secuencia" data-secuencia aria-labelledby="nosotros-titulo">
      <h1 id="nosotros-titulo" class="sr-only">{t.grande}: {textoSecuencia}</h1>
      <div class="escenario">
        <div class="pantalla">
        {video
          ? (
            <video class="fondo" data-fondo="video" autoplay muted loop playsinline preload="metadata" aria-hidden="true">
              {videoVertical && <source src={videoVertical} type="video/mp4" media="(orientation: portrait)" />}
              <source src={video} type="video/mp4" />
            </video>
          )
          : Object.entries(fondos).map(([id, foto]) => (
            <Image src={foto} alt="" widths={[640, 1280, 1920]} sizes="100vw" loading="eager" class:list={['fondo', { visible: secuencia.cuadros[quieto].fondo === id }]} data-fondo={id} aria-hidden="true" />
          ))}
        <div class="velo" aria-hidden="true"></div>
        <div class="cuadros" aria-hidden="true">
          {secuencia.cuadros.map((c, i) => (
            <div class:list={['cuadro', `cuadro-${c.tipo}`, c.disposicion && `d-${c.disposicion}`, { activo: i === quieto }]} data-cuadro={c.fondo} data-ms={c.ms}>
              {c.tipo === 'presenta' && <p class="presenta"><Marca class="presenta-logo" /><span>{c.texto.replace(/^Rodas*/, '')}</span></p>}
              {c.tipo === 'titulo' && (
                <>
                  <p class="lado lado-izq">{c.lados[0]}</p>
                  <p class="escalera">{c.palabras.map((w, j) => <span class="grande" style={`--j:${j}`}>{w}</span>)}</p>
                  <p class="lado lado-der">{c.lados[1]}</p>
                </>
              )}
              {c.tipo === 'cierre' && <p class="cierre-logo"><Marca /></p>}
              {c.tipo === 'tagline' && <p class="tagline">{c.lineas.map((l) => <span>{l}</span>)}</p>}
              {c.tipo === 'credito' && (
                <>
                  <p class="rol">{c.rol}</p>
                  {c.nombres.map((n, j) => <p class={`nombre nombre-${j}`}>{n}</p>)}
                </>
              )}
            </div>
          ))}
        </div>
        <button type="button" class="otra-vez" data-otra-vez hidden>↺ {secuencia.otraVez}</button>
        <p class="legal" aria-hidden="true">{secuencia.legal}</p>
        </div>
      </div>
    </section>

    <!-- Nosotros, como la página de un libro: la palabra gigante y la foto que se le cruza -->
    <section class="sobre px-5 pt-24 md:px-12 md:pt-32" aria-labelledby="sobre-titulo">
      <p class="mono text-center">{t.bajo}</p>
      <h2 id="sobre-titulo" class="palabra" data-revelar>{t.grande}</h2>
      <div class="cuerpo">
        <figure class="foto" data-revelar="4">
          <Image src={juntos} alt={t.foto.alt} widths={[480, 960]} sizes="(min-width: 768px) 40vw, 80vw" />
        </figure>
        <div class="textos" data-revelar="6">
          <p class="text-lg leading-relaxed md:text-xl">{t.bajada}</p>
          {t.personas.map((p) => (
            <p class="mt-5 text-lg leading-relaxed text-tinta/75 md:text-xl"><strong class="font-medium text-tinta">{p.nombre}.</strong> {p.texto}</p>
          ))}
          <p class="mt-5 text-lg leading-relaxed text-tinta/75 md:text-xl">{t.juntos}</p>
        </div>
      </div>
    </section>

    <!-- Los créditos, en rosa -->
    <section class="creditos mt-24 md:mt-32" aria-labelledby="creditos-titulo">
      <h2 id="creditos-titulo" class="mono text-center">Roda</h2>
      <dl class="rollo">
        {t.creditos.map(([rol, quien]) => (
          <div><dt>{rol}</dt><dd>{quien}</dd></div>
        ))}
      </dl>
      <p class="aviso">{t.aviso}</p>
    </section>

    <!-- Escena post-créditos -->
    <section class="flex flex-col items-center gap-10 px-5 py-28 text-center md:py-40" aria-label="Contacto">
      <p class="font-titulo text-[clamp(2.8rem,9vw,6.5rem)] leading-[0.92] tracking-[-0.045em]">
        ¿Filmamos<br /><em class="text-tinta/52">la tuya?</em>
      </p>
      <a href={link} target="_blank" rel="noopener" class="cta">{t.cta}</a>
    </section>
  </main>
  <Pie />
  <Motion />
</Base>

<style>
  /* ── La secuencia ───────────────────────────────────────────────
     Sin movimiento (o sin JS) se lee como un afiche: todos los títulos, uno abajo del otro, sobre la foto. */
  .secuencia { position: relative; color: var(--color-tc-rosa); }
  /* El escenario es papel; la pantalla, un recuadro con márgenes, como una proyección dentro de la página */
  .escenario { position: relative; min-height: 100svh; padding: 4.5rem 1.25rem 1.25rem; display: grid; }
  @media (min-width: 768px) { .escenario { padding: 5.5rem 3rem 2rem; } }
  .pantalla { position: relative; overflow: hidden; display: grid; place-items: center; padding: 5rem 1.25rem; background: var(--color-negro); }
  .fondo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 48% 40%; opacity: 0; transition: opacity 0.6s; filter: saturate(0.8) contrast(1.05); }
  .fondo.visible { opacity: 1; }
  /* Las placas sobre negro van sin el velo: negro puro */
  .pantalla:has(.fondo.visible) .velo { opacity: 1; }
  .velo { opacity: 0; transition: opacity 0.6s; }
  /* En la foto del barco están los dos a la derecha: en pantalla vertical se corre el encuadre */
  @media (orientation: portrait) { .fondo[data-fondo='viaje'] { object-position: 64% 45%; } }
  .velo { position: absolute; inset: 0; background: linear-gradient(rgb(8 10 20 / 0.55), rgb(8 10 20 / 0.72)); }
  .legal, .cuadros { position: relative; z-index: 1; }
  /* Las placas livianas: el estudio, la producción y los créditos, en papel */
  /* Las placas livianas, como los créditos de cine actuales: mayúsculas con mucho aire entre letras */
  .presenta { display: flex; align-items: baseline; justify-content: center; gap: 0.9em; color: var(--color-papel); font-family: var(--font-titulo); font-weight: 500; font-size: clamp(0.85rem, 1.6vw, 1.2rem); letter-spacing: 0.42em; text-transform: uppercase; }
  .presenta :global(.presenta-logo) { font-size: clamp(2.2rem, 4.6vw, 3.6rem); letter-spacing: -0.01em; text-transform: none; }
  .rol { font-family: var(--font-titulo); font-weight: 500; font-size: clamp(0.62rem, 1vw, 0.78rem); letter-spacing: 0.45em; text-transform: uppercase; color: color-mix(in oklab, var(--color-papel) 72%, transparent); }
  .nombre { margin-top: 0.4em; font-family: var(--font-titulo); font-weight: 500; font-size: clamp(1.05rem, 2.4vw, 1.9rem); line-height: 1.35; letter-spacing: 0.3em; text-transform: uppercase; color: var(--color-papel); text-wrap: balance; }
  .rol + .nombre { margin-top: 1.4em; }
  /* La frase clave: más grande que los créditos, la segunda línea en rosa */
  .cuadro-tagline { place-content: center start !important; padding-inline: 7% !important; }
  .tagline { display: grid; gap: 0.6em; max-width: 26ch; text-align: left; font-size: clamp(1.3rem, 3.2vw, 2.6rem) !important; color: var(--color-papel); font-family: var(--font-titulo); font-weight: 500; font-size: clamp(1.1rem, 2.8vw, 2.3rem); line-height: 1.25; letter-spacing: 0.2em; text-transform: uppercase; text-wrap: balance; }
  .tagline span:last-child { color: var(--color-tc-rosa); }
  /* El título en escalera: cada palabra en su lugar, y se van sumando como placas */
  .cuadro-titulo { place-content: stretch !important; padding: 7% 6% 4.5rem !important; }
  .escalera { display: grid; height: 100%; align-content: space-between; }
  .escalera .grande { font-size: min(17vw, 24svh); }
  .escalera .grande:nth-child(1) { justify-self: start; }
  .escalera .grande:nth-child(2) { justify-self: end; }
  .escalera .grande:nth-child(3) { justify-self: start; }
  :global(.secuencia-animada) .cuadro-titulo.activo .grande { animation: corte 0.01s steps(1) both; animation-delay: calc(var(--j) * 0.6s); }
  @keyframes corte { from { opacity: 0; } to { opacity: 1; } }
  .lado { position: absolute; top: 50%; translate: 0 -50%; font-family: var(--font-titulo); font-style: italic; font-size: clamp(0.9rem, 1.6vw, 1.25rem); }
  .lado-izq { left: 1.5%; } .lado-der { right: 1.5%; }
  @media (orientation: portrait) { .lado { display: none; } }
  /* Los protagonistas, a los costados: enmarcan las caras */
  .d-lados { place-content: stretch !important; grid-template-rows: auto 1fr; padding: 7% 4% !important; text-align: center; }
  .d-lados .nombre { position: absolute; top: 50%; translate: 0 -50%; max-width: 38%; margin: 0; line-height: 1.5; }
  @media (max-width: 767px) { .d-lados .nombre { letter-spacing: 0.2em; } }
  .d-lados .nombre-0 { left: 4%; text-align: left; }
  .d-lados .nombre-1 { right: 4%; text-align: right; }
  @media (orientation: portrait) {
    .d-lados .nombre-0 { top: 30%; }
    .d-lados .nombre-1 { top: 72%; }
  }
  /* La locación, chiquita abajo a la izquierda, como el rótulo de una escena */
  .d-esquina { place-content: end start !important; padding: 0 5% 4.5rem !important; text-align: left; }
  .d-esquina .rol + .nombre { margin-top: 0.8em; }
  /* La placa final: el logo solo, sobre negro, como el cierre de un estudio */
  .cierre-logo { color: var(--color-papel); font-size: clamp(3rem, 8vw, 6rem); }
  .legal {
    position: absolute;
    bottom: 1.25rem;
    inset-inline: 1.25rem;
    text-align: center;
    font-family: var(--font-grito);
    font-weight: 700;
    font-size: clamp(0.55rem, 1.1vw, 0.75rem);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .cuadros { display: grid; gap: 2.5rem; justify-items: center; text-align: center; }
  .grande {
    font-family: var(--font-grito);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: min(28vw, 40svh);
    line-height: 0.82;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Una sola pantalla. Sin movimiento (o sin JS) se ve directo el título final */
  .escenario { height: 100svh; min-height: 32rem; }
  .pantalla { padding: 0; }
  .cuadros { position: absolute; inset: 0; display: block; }
  .cuadro { position: absolute; inset: 0; display: grid; place-content: center; padding: 0 1.25rem; opacity: 0; }
  .cuadro.activo { opacity: 1; }
  :global(.secuencia-animada) .cuadro { transform: scale(1.06); transition: opacity 0.25s, transform 0.9s var(--ease-cine); }
  :global(.secuencia-animada) .cuadro.activo { transform: none; }
  /* El fondo se acerca despacio mientras corre, como una toma */
  :global(.secuencia-animada) .fondo.visible { animation: acerca 14s linear both; }
  @keyframes acerca { from { transform: scale(1.04); } to { transform: scale(1.18); } }
  .otra-vez {
    position: absolute;
    z-index: 2;
    right: 1rem;
    bottom: 2.75rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid color-mix(in oklab, var(--color-papel) 40%, transparent);
    border-radius: 999px;
    color: var(--color-papel);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .otra-vez:hover { background: var(--color-papel); color: var(--color-negro); }

  /* ── Nosotros: la palabra gigante y la foto que se le cruza ───── */
  .sobre .mono { color: var(--color-gris); }
  .palabra {
    margin-top: 1rem;
    font-family: var(--font-grito);
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
    font-size: 25vw;
    line-height: 0.8;
    letter-spacing: -0.01em;
    text-align: center;
  }
  .cuerpo { display: grid; gap: 2.5rem; margin-top: -6vw; }
  .foto { position: relative; z-index: 1; width: 78%; margin: 0; }
  .foto :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 55% 50%; }
  @media (min-width: 768px) {
    .cuerpo { grid-template-columns: 0.9fr 1fr; gap: 4rem; align-items: end; padding-inline: 2vw; margin-top: -9vw; }
    .foto { width: 100%; }
    .textos { max-width: 38ch; }
  }


  /* ── Los créditos ─────────────────────────────────────────────── */
  .creditos { background: var(--color-tc-rosa); color: var(--color-tinta); padding: 5rem 1.25rem; }
  .rollo { display: grid; gap: 0.9rem; max-width: 46rem; margin: 3rem auto 0; }
  .rollo div { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; align-items: baseline; }
  .rollo dt { text-align: right; font-style: italic; font-size: clamp(0.95rem, 2vw, 1.15rem); }
  .rollo dd { font-weight: 600; font-size: clamp(0.95rem, 2vw, 1.15rem); }
  .aviso { margin-top: 3.5rem; text-align: center; font-style: italic; }
</style>

<script>
  import { movimientoPermitido } from '../motion/index';

  // La intro corre sola, como un video, cuando la pantalla entra en vista. Termina quieta en el título.
  const seccion = document.querySelector<HTMLElement>('[data-secuencia]');
  if (seccion && movimientoPermitido()) {
    const cuadros = [...seccion.querySelectorAll<HTMLElement>('.cuadro')];
    const fondos = [...seccion.querySelectorAll<HTMLElement>('[data-fondo]')];
    const otraVez = seccion.querySelector<HTMLButtonElement>('[data-otra-vez]')!;
    document.documentElement.classList.add('secuencia-animada');

    let reloj = 0;
    const mostrar = (i: number) => {
      cuadros.forEach((c, j) => c.classList.toggle('activo', j === i));
      const fondo = cuadros[i].dataset.cuadro;
      // El video (si hay) corre en las placas con imagen; las de 'negro' van sobre negro puro
      fondos.forEach((f) => f.classList.toggle('visible', f.dataset.fondo === fondo || (f.dataset.fondo === 'video' && fondo !== 'negro')));
    };
    const correr = (i = 0) => {
      clearTimeout(reloj);
      otraVez.hidden = true;
      mostrar(i);
      const ms = Number(cuadros[i].dataset.ms);
      if (i < cuadros.length - 1) reloj = window.setTimeout(() => correr(i + 1), ms);
      else otraVez.hidden = false;
    };

    mostrar(0);
    const obs = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      obs.disconnect();
      correr();
    }, { threshold: 0.5 });
    obs.observe(seccion);
    otraVez.addEventListener('click', () => correr());
  }
</script>
