---
/** La banderita de cada idioma, dibujada (los emojis de banderas no se ven en Windows).
 *  Español → Argentina (Roda es de Buenos Aires), inglés → Estados Unidos, portugués → Brasil (pt-BR). */
import type { Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  class?: string;
}
const { idioma, class: clase } = Astro.props;
---
<svg class:list={['bandera', clase]} viewBox="0 0 30 20" aria-hidden="true">
  {idioma === 'es' && (
    <>
      <rect width="30" height="20" fill="#74ACDF" />
      <rect y="6.67" width="30" height="6.67" fill="#fff" />
      <circle cx="15" cy="10" r="2.3" fill="#F6B40E" />
    </>
  )}
  {idioma === 'en' && (
    <>
      <rect width="30" height="20" fill="#fff" />
      {[0, 2, 4, 6, 8, 10, 12].map((i) => <rect y={(i * 20) / 13} width="30" height={20 / 13} fill="#B22234" />)}
      <rect width="13" height={(7 * 20) / 13} fill="#3C3B6E" />
    </>
  )}
  {idioma === 'pt' && (
    <>
      <rect width="30" height="20" fill="#009C3B" />
      <path d="M15 2.5 27 10 15 17.5 3 10Z" fill="#FFDF00" />
      <circle cx="15" cy="10" r="4.2" fill="#002776" />
    </>
  )}
</svg>

<style>
  .bandera {
    width: 1.3rem; height: auto; flex: none;
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }
</style>
