---
/** La tira de proyectos: en mobile se desliza de costado; en computadora la fila entera, y la que mirás crece. */
import { Image } from 'astro:assets';
import { PROYECTOS } from '../content/proyectos';
import { capturas } from '../content/capturas';
import { proyectosPagina } from '../content/guion';
---
<ul class="tira" data-tira>
  {PROYECTOS.map((p, i) => (
    <li class="tira-item" data-rubro={p.rubro} data-orden={i}>
      <a href={`/proyectos/${p.slug}`} class="tira-link">
        <span class="mono tira-meta">
          <span>({String(i + 1).padStart(2, '0')})</span> {p.titulo}
          <span class="tira-cerca" hidden>· {proyectosPagina.cerca}</span>
        </span>
        <span class="tira-foto">
          <Image src={capturas(p.slug).portada} alt="" widths={[400, 720]} sizes="(min-width: 1024px) 30vw, 72vw" loading="lazy" class="foto-tono size-full object-cover object-top" />
        </span>
        <span class="mono tira-meta text-gris">{p.genero} · {p.anio}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .tira {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 1.25rem 0.5rem;
    scrollbar-width: none;
  }
  .tira::-webkit-scrollbar { display: none; }
  .tira-item { flex: none; width: 72vw; scroll-snap-align: start; }
  .tira-link { display: grid; gap: 0.6rem; }
  .tira-meta { display: flex; gap: 0.5rem; }
  .tira-foto { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: color-mix(in oklab, var(--color-tinta) 8%, transparent); }
  .tira-link:hover :global(.foto-tono), .tira-link:focus-visible :global(.foto-tono) { filter: none; }

  @media (min-width: 1024px) {
    /* Alto fijo = el del proyecto agrandado (ocupa 2,6 de 7,6 partes del ancho, foto 16:10, más las dos líneas de texto).
       Así, al agrandarse uno, nada de alrededor se mueve. */
    .tira {
      overflow: visible;
      padding: 0 3rem;
      gap: 0.6rem;
      align-items: center;
      height: calc((100vw - 9rem) * 2.6 / 7.6 * 10 / 16 + 3.6rem);
    }
    .tira-item { flex: 1 1 0; width: auto; min-width: 0; transition: flex-grow 0.8s var(--ease-cine); }
    .tira-item:hover, .tira-item:focus-within { flex-grow: 2.6; }
    .tira-meta { white-space: nowrap; overflow: hidden; }
  }
</style>
