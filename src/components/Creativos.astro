---
import { idiomaDe, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { creativos } = textos(idioma);

const link = `${ruta(idioma, 'contacto')}?tipo=nose&mensaje=${encodeURIComponent(creativos.mensaje)}`;
---
<!-- Para quien diseña o maneja marcas: una línea, sin ocupar una sección -->
<p class="mono mx-5 mt-24 mb-8 border-t border-tinta/15 pt-3 text-gris md:mx-12">
  {creativos.pregunta}{' '}
  <a href={link} class="enlace text-tinta underline underline-offset-4">{creativos.cta} →</a>
</p>
