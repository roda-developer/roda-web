---
/** Lo que dicen los clientes: testimonios reales y textuales (no se resumen). La primera va grande; las demás, en dos columnas.
 *  Las largas se cortan con … y se abren con "Leer más", así todas quedan de un largo parecido. */
import type { Testimonio } from '../content/proyectos';
import { textos } from '../i18n';

interface Props {
  testimonios: Testimonio[];
  titulo?: string;
}
const { laCritica, ui } = textos(Astro.currentLocale);
const { testimonios, titulo = laCritica.completo } = Astro.props;
const unaSola = testimonios.length === 1;
---
<section class="criticas" aria-labelledby="criticas-titulo">
  <h2 id="criticas-titulo" class="criticas-titulo" data-revelar>{titulo}</h2>
  <ul class:list={['criticas-lista', { 'una-sola': unaSola }]}>
    {testimonios.map((c, i) => (
      <li class:list={[{ destacada: i === 0 && !unaSola }]} data-revelar={i * 3} data-critica>
        <blockquote class="cita">
          <p class:list={['cita-texto', { cortable: !unaSola }]} id={`critica-${i}`}>“{c.texto}”</p>
        </blockquote>
        {!unaSola && (
          <button type="button" class="leer mono" aria-expanded="false" aria-controls={`critica-${i}`} data-mas={ui.leerMas} data-menos={ui.leerMenos} hidden>{ui.leerMas}</button>
        )}
        <p class="firma mono"><span class="text-tinta">{c.nombre}</span> · {c.rol}{c.traducido && <span class="block mt-1 normal-case">({ui.traducido})</span>}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .criticas-titulo { font-family: var(--font-titulo); font-weight: 800; text-transform: uppercase; font-size: clamp(2.4rem, 6vw, 4rem); line-height: 0.9; }
  .criticas-lista { display: grid; gap: 3rem; margin-top: 2.5rem; }
  @media (min-width: 1024px) { .criticas-lista:not(.una-sola) { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 4rem; } }
  .criticas-lista > li { display: grid; gap: 1.1rem; align-content: start; }
  /* La primera, a lo ancho y más grande */
  .criticas-lista > li.destacada { grid-column: 1 / -1; }
  .destacada .cita { font-size: clamp(1.6rem, 3.2vw, 2.4rem); line-height: 1.2; max-width: 34ch; }
  .cita { margin: 0; font-size: clamp(1.25rem, 3.6vw, 1.6rem); line-height: 1.3; letter-spacing: -0.02em; font-weight: 500; max-width: 46ch; text-wrap: pretty; }
  /* Hasta 6 renglones; el resto queda detrás de "Leer más" */
  .cortable { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 6; line-clamp: 6; overflow: hidden; }
  .abierta .cortable { display: block; -webkit-line-clamp: unset; line-clamp: none; }
  .leer {
    justify-self: start; margin-top: -0.4rem; padding: 0.35rem 0; min-height: 2.75rem;
    background: none; border: 0; cursor: pointer; color: var(--color-tinta);
    text-decoration: underline; text-underline-offset: 4px;
  }
  .leer[hidden] { display: none; }
  .firma { color: var(--color-gris); }
</style>

<script>
  // "Leer más" aparece solo en las críticas que de verdad quedaron cortadas
  const revisar = () => {
    document.querySelectorAll<HTMLElement>('[data-critica]').forEach((li) => {
      const texto = li.querySelector<HTMLElement>('.cortable');
      const boton = li.querySelector<HTMLButtonElement>('.leer');
      if (!texto || !boton || li.classList.contains('abierta')) return;
      boton.hidden = texto.scrollHeight <= texto.clientHeight + 2;
    });
  };
  document.querySelectorAll<HTMLButtonElement>('.leer').forEach((boton) => {
    boton.addEventListener('click', () => {
      const li = boton.closest('[data-critica]');
      const abierta = !li?.classList.contains('abierta');
      li?.classList.toggle('abierta', abierta);
      boton.setAttribute('aria-expanded', String(abierta));
      boton.textContent = (abierta ? boton.dataset.menos : boton.dataset.mas) ?? '';
    });
  });
  revisar();
  document.fonts?.ready.then(revisar);
  addEventListener('resize', revisar, { passive: true });
</script>
