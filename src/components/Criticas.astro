---
/** Lo que dice la crítica: testimonios reales de clientes, citados como las críticas en un afiche de estreno. */
import type { Testimonio } from '../content/proyectos';
import Rotulo from './Rotulo.astro';

interface Props {
  testimonios: Testimonio[];
  rotulo?: readonly string[];
  titulo?: string;
}
const { testimonios, rotulo, titulo = 'Lo que dice la crítica' } = Astro.props;
---
<section class="criticas" aria-labelledby="criticas-titulo">
  {rotulo && <Rotulo rotulo={rotulo} tipo="Parte" />}
  <h2 id="criticas-titulo" class:list={['criticas-titulo', { 'mt-8': rotulo }]} data-revelar>{titulo}</h2>
  <ul class:list={['criticas-lista', { 'una-sola': testimonios.length === 1 }]}>
    {testimonios.map((c, i) => (
      <li data-revelar={i * 3}>
        <blockquote class="cita">
          <p>“{c.texto}”</p>
        </blockquote>
        <p class="firma mono"><span class="text-tinta">{c.nombre}</span> · {c.rol}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .criticas-titulo { font-family: var(--font-titulo); font-weight: 500; font-size: clamp(2rem, 7vw, 3.6rem); line-height: 1; letter-spacing: -0.045em; }
  .criticas-lista { display: grid; gap: 2.5rem; margin-top: 2.5rem; }
  @media (min-width: 1024px) { .criticas-lista:not(.una-sola) { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 3rem; } }
  .criticas-lista > li { display: grid; gap: 1.1rem; align-content: start; padding-top: 1.25rem; border-top: 1px solid var(--color-tinta); }
  .cita { margin: 0; font-size: clamp(1.25rem, 3.6vw, 1.6rem); line-height: 1.3; letter-spacing: -0.02em; font-weight: 500; max-width: 46ch; text-wrap: pretty; }
  .firma { color: var(--color-gris); }
</style>
