---
/**
 * Lo que dicen los clientes: el mockup entero y chico de la web, y al lado la frase corta y grande del cliente, sobre el papel.
 * Se cambia tocando el nombre de la marca. Las frases son textuales. Pasa solo y se frena al pasar el mouse, al enfocar o para siempre al elegir una marca.
 * Sin movimiento: cambia de una y no pasa solo. Sin JS: se ve el primero. Sin mockup: la portada de su web.
 */
import { Image } from 'astro:assets';
import { capturas } from '../content/capturas';
import type { TestimonioDe } from '../content/proyectos';
import { textos } from '../i18n';

interface Props {
  testimonios: TestimonioDe[];
  titulo?: string;
}
const { laCritica, ui } = textos(Astro.currentLocale);
const { testimonios, titulo = laCritica.completo } = Astro.props;
const n = testimonios.length;
const fotoDe = (slug: string) => { const c = capturas(slug); return c.mockup ?? c.portada; };
// En un caso con varios comentarios de la misma marca, el selector usa el nombre de cada persona
const marcasDistintas = new Set(testimonios.map((t) => t.marca)).size === n;
---
<section class="criticas" aria-labelledby="criticas-titulo" data-rollo data-total={n} data-revelar>
  <div class="fotos pila" aria-hidden="true">
    {testimonios.map((t, i) => (
      <Image src={fotoDe(t.slug)} alt="" widths={[240, 480, 720]} sizes="(min-width: 768px) 18vw, 42vw" quality={84} loading="lazy" class:list={['foto', { activo: i === 0 }]} data-pieza={i} />
    ))}
  </div>
  <div class="cuerpo">
    <h2 id="criticas-titulo" class="criticas-titulo font-titulo">{titulo}</h2>
    <div class="texto">
      <div class="pila">
        {testimonios.map((t, i) => (
          <blockquote class:list={['cita font-titulo', { activo: i === 0 }]} data-pieza={i} aria-hidden={i === 0 ? undefined : 'true'}>“{t.destacado ?? t.texto}”</blockquote>
        ))}
      </div>
      <div class="pie">
        <div class="pila">
          {testimonios.map((t, i) => (
            <p class:list={['firma', { activo: i === 0 }]} data-pieza={i} aria-hidden={i === 0 ? undefined : 'true'}><b>{t.nombre}</b><span class="sr-only"> {t.marca}</span>{t.traducido && <span class="nota"> · {ui.traducido}</span>}</p>
          ))}
        </div>
        {n > 1 && (
          <div class="marcas">
            {testimonios.map((t, i) => (
              <button type="button" class="marca" data-ir={i} aria-pressed={i === 0 ? 'true' : 'false'}>{marcasDistintas ? t.marca : t.nombre}</button>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .criticas { display: grid; gap: 1.25rem; }
  .criticas-titulo { font-size: clamp(1.5rem, 2.2vw, 2rem); line-height: 1; }

  /* El mockup entero, sin recortar */
  .fotos { width: 42vw; max-width: 15rem; }
  .fotos :global(.foto) { display: block; width: 100%; height: auto; aspect-ratio: 1136 / 1408; object-fit: cover; }

  .cuerpo { display: grid; gap: 1.25rem; align-content: space-between; min-width: 0; }
  @media (min-width: 768px) {
    .criticas { grid-template-columns: clamp(12rem, 18vw, 15rem) minmax(0, 1fr); column-gap: clamp(2rem, 4vw, 4rem); }
    .fotos { width: 100%; max-width: none; }
  }

  /* Todo lo que cambia va en la misma celda, así el alto no salta */
  .pila { display: grid; }
  .pila > :global(*) { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity 110ms ease, transform 110ms var(--ease-ui), visibility 0s 110ms; }
  .pila > :global(.activo) { opacity: 1; visibility: visible; transform: none; transition: opacity 180ms ease 110ms, transform 240ms var(--ease-ui) 110ms, visibility 0s; }

  .cita { margin: 0; font-size: clamp(2.5rem, 4.6vw, 4.25rem); line-height: 0.97; text-wrap: balance; }
  .pie { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.25rem 2rem; margin-top: 0.75rem; }
  .firma { font-size: 1.0625rem; line-height: 1.35; }
  .firma b { font-weight: 600; }
  .firma .nota { color: #55524c; }

  /* El selector: los nombres de las marcas, como los links de texto de la web */
  .marcas { display: flex; flex-wrap: wrap; gap: 0 1.25rem; margin-inline: -0.25rem; }
  .marca { position: relative; min-height: 2.75rem; padding-inline: 0.25rem; background: none; border: 0; font: inherit; font-size: 1.0625rem; color: #55524c; cursor: pointer; transition: color 160ms ease; }
  .marca::after { content: ''; position: absolute; left: 0.25rem; right: 0.25rem; bottom: 0.6rem; height: 1.5px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform 220ms var(--ease-ui); }
  .marca[aria-pressed='true'] { color: var(--color-tinta); }
  .marca[aria-pressed='true']::after { transform: none; }
  @media (hover: hover) and (pointer: fine) { .marca:hover { color: var(--color-tinta); } }
  .marca:active { opacity: 0.7; }
  .marca:focus-visible { outline: 2px solid var(--color-tinta); outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .pila > :global(*), .pila > :global(.activo), .marca, .marca::after { transition: none; }
    .pila > :global(*) { transform: none; }
  }
</style>

<script>
  import { movimientoPermitido } from '../motion/index';

  document.querySelectorAll<HTMLElement>('[data-rollo]').forEach((raiz) => {
    const n = Number(raiz.dataset.total);
    if (n < 2) return;
    const piezas = [...raiz.querySelectorAll<HTMLElement>('[data-pieza]')];
    const marcas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-ir]')];
    let actual = 0;

    const ir = (i: number) => {
      actual = (i + n) % n;
      piezas.forEach((p) => {
        const activa = Number(p.dataset.pieza) === actual;
        p.classList.toggle('activo', activa);
        if (!p.classList.contains('foto')) p.setAttribute('aria-hidden', String(!activa));
      });
      marcas.forEach((m, k) => m.setAttribute('aria-pressed', String(k === actual)));
    };

    // Pasa solo cada 7 segundos mientras está en pantalla; se frena con el mouse encima, con el foco adentro, o para siempre si eligen una marca
    let reloj = 0, tocado = false, visible = false, encima = false;
    const decidir = () => {
      clearInterval(reloj);
      if (!tocado && visible && !encima && movimientoPermitido()) reloj = window.setInterval(() => ir(actual + 1), 7000);
    };
    marcas.forEach((m, k) => m.addEventListener('click', () => { tocado = true; decidir(); ir(k); }));
    raiz.addEventListener('pointerenter', () => { encima = true; decidir(); });
    raiz.addEventListener('pointerleave', () => { encima = false; decidir(); });
    raiz.addEventListener('focusin', () => { encima = true; decidir(); });
    raiz.addEventListener('focusout', () => { encima = false; decidir(); });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; decidir(); }).observe(raiz);
  });
</script>
