---
/** Carta de acto: el número romano gigante, en contorno de luz, y el nombre del acto. */
interface Props { texto: string }
const [numero, nombre] = Astro.props.texto.split(' — ');
---
<div class="plano">
  <p class="text-center">
    <span class="numeral block" data-revelar aria-hidden="true">{numero}</span>
    <span class="mt-6 block text-[0.7rem] tracking-[0.4em] text-[var(--acento)] uppercase" data-revelar="8">
      <span class="sr-only">Acto {numero}: </span>{nombre}
    </span>
  </p>
</div>

<style>
  .numeral {
    font-family: var(--font-titulo);
    font-style: italic;
    font-size: clamp(8rem, 48vw, 24rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--acento) 80%, transparent);
    text-shadow: 0 0 60px color-mix(in oklab, var(--acento) 18%, transparent);
  }
</style>
