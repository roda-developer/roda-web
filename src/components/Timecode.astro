---
---
<div
  class="timecode pointer-events-none fixed top-1/2 right-1 z-40 flex -translate-y-1/2 items-center gap-2 font-texto text-[10px] tracking-[0.2em] text-pantalla/45 tabular-nums md:right-3"
  aria-hidden="true"
>
  <span class="size-1.5 rounded-full bg-tungsteno animate-pulse"></span>
  <span data-timecode>00:00:00:00</span>
</div>

<style>
  .timecode { writing-mode: vertical-rl; }
</style>

<script>
  import { formatearTimecode } from '../motion/timecode';

  const salida = document.querySelector<HTMLElement>('[data-timecode]');
  let pendiente = false;
  const pintar = () => {
    pendiente = false;
    const max = document.documentElement.scrollHeight - innerHeight;
    if (salida) salida.textContent = formatearTimecode(max > 0 ? scrollY / max : 0);
  };
  addEventListener('scroll', () => {
    if (!pendiente) { pendiente = true; requestAnimationFrame(pintar); }
  }, { passive: true });
  pintar();
</script>
