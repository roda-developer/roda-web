---
/** El pie con los créditos: quiénes somos, la ficha técnica y cómo escribirnos. */
import Marca from './Marca.astro';
import { creditos } from '../content/guion';
import { INSTAGRAM, MAIL } from '../content/contacto';
const [giuli, facu] = creditos.nombres;
---
<footer class="relative z-10 px-5 pt-16 pb-6 md:px-12" aria-label="Créditos">
  <div class="grid gap-10 border-t border-tinta/15 pt-5 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="mono text-gris">({creditos.intro})</p>
      <p class="mt-3 font-titulo text-[clamp(2.2rem,7vw,4rem)] leading-[0.95] tracking-[-0.045em]">
        {giuli.nombre} y {facu.nombre}.
      </p>
      <p class="mt-2 text-xl text-tinta/60">{creditos.lema.join(' ')}</p>
    </div>
    <dl class="mono grid content-start gap-3">
      {creditos.ficha.map(([k, v]) => (
        <div>
          <dt class="text-gris">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
    <div class="mono grid content-start gap-3">
      <p><span class="block text-gris">Escribinos</span>{MAIL
        ? <a class="enlace-pie" href={`mailto:${MAIL}`}>{MAIL}</a>
        : <a class="enlace-pie" href="/contacto">Contacto</a>}</p>
      <p><span class="block text-gris">Seguinos</span><a class="enlace-pie" href={`https://instagram.com/${INSTAGRAM}`} target="_blank" rel="noopener">@{INSTAGRAM}</a></p>
      <p><span class="block text-gris">Mirá</span><span class="flex flex-wrap gap-x-4"><a class="enlace-pie" href="/proyectos">Proyectos</a><a class="enlace-pie" href="/nosotros">Nosotros</a><a class="enlace-pie" href="/precios">Precios</a><a class="enlace-pie" href="/contacto">Contacto</a></span></p>
    </div>
  </div>
  <div class="mt-16 flex items-end justify-between gap-6">
    <p class="text-[clamp(4rem,22vw,15rem)] leading-[0.8]"><Marca /></p>
    <p class="mono pb-2 text-right text-gris">© {new Date().getFullYear()}</p>
  </div>
</footer>

<style>
  /* Links del pie: subrayados y con 44px de alto para tocarlos cómodo con el dedo */
  .enlace-pie { display: inline-flex; align-items: center; min-height: 2.75rem; text-decoration: underline; text-underline-offset: 4px; }
</style>
