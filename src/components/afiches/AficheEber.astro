---
/**
 * Eber: un mosaico con portadas de sus trabajos (el color lo ponen los proyectos) y la frase de su
 * portada en letra gigante, como un afiche de cine independiente. Sin su retrato: el protagonista es el trabajo.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';


// Portadas de 47 Street, Owoko, Violetta, Topa, Zpëzia y Tecnópolis (de su portfolio, en Cloudinary)
const archivos = import.meta.glob<{ default: ImageMetadata }>('../../assets/proyectos/eber/obra-*.jpg', { eager: true });
const obras = Object.keys(archivos).sort().map((k) => archivos[k].default);

// La frase de su portada, con cada letra del color que tiene en su web (rojo, amarillo, azul, blanco)
const r = '#f2333f', a = '#ffb000', z = '#1f7aea', b = '#ffffff';
const lineas = [
  [['D', r], ['I', a], ['S', z], ['E', b], ['Ñ', r], ['O', a], [' ', b], ['&', b]],
  [['D', z], ['I', b], ['R', r], ['E', a], ['C', z], ['C', b], ['I', r], ['Ó', a], ['N', z]],
];
---
<div class="eber" aria-hidden="true">
  <div class="eber-obras">
    {obras.map((o) => (
      <div class="eber-obra">
        <Image src={o} alt="" widths={[240, 400]} sizes="(min-width: 768px) 11vw, 33vw" loading="lazy" />
      </div>
    ))}
  </div>
  <p class="eber-nombre">EBER</p>

  <div class="eber-pie">
    <p class="eber-titulo">{lineas.map((linea) => <span class="eber-renglon">{linea.map(([letra, color]) => <span style={`color:${color}`}>{letra}</span>)}</span>)}</p>
  </div>
</div>

<style>
  .eber { position: absolute; inset: 0; overflow: hidden; background: #0a0a0b; color: #fff; }

  /* Mosaico 3 × 2 de portadas, entero dentro del afiche, que se funde en negro hacia la frase */
  .eber-obras {
    position: absolute; inset: 13cqi 6cqi 30% 6cqi;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4cqi; align-content: start;
  }
  .eber-obras::after {
    content: ''; position: absolute; inset: -3cqi -6cqi;
    background: linear-gradient(180deg, rgb(10 10 11 / 0.35) 0%, transparent 22%, transparent 45%, #0a0a0b 88%);
  }
  .eber-obra { aspect-ratio: 4 / 5; border-radius: 1.4cqi; overflow: hidden; background: #1a1a1c; }
  /* Columnas desfasadas, como un muro de afiches */
  .eber-obra:nth-child(3n + 2) { translate: 0 3cqi; }
  .eber-obra :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .eber-nombre {
    position: absolute; top: 4.5cqi; left: 0; right: 0; text-align: center; z-index: 1;
    font-family: var(--font-titulo); font-weight: 800; font-size: max(0.7rem, 3.6cqi); letter-spacing: -0.02em;
  }

  .eber-pie { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 5cqi 5cqi; }
  /* La frase de su portada: grotesca negra, apretada, ocupa todo el ancho */
  .eber-titulo {
    font-family: var(--font-titulo); font-weight: 900;
    font-size: 15.4cqi; line-height: 0.86; letter-spacing: -0.065em;
    text-align: center;
  }
  .eber-renglon { display: block; white-space: pre; }
</style>
