---
/**
 * El afiche de los proyectos cargados desde el admin: la portada de su web de fondo, el título enorme
 * sobre una franja de su color y los créditos al pie. Los proyectos de siempre tienen su afiche hecho a mano.
 */
import { Image } from 'astro:assets';
import { capturas } from '../../content/capturas';
import { PROYECTOS_ADMIN, proyectosEn } from '../../content/proyectos';
import { idiomaDe } from '../../i18n';

interface Props { slug: string }
const { slug } = Astro.props;
const idioma = idiomaDe(Astro.currentLocale);
const p = proyectosEn(idioma).find((x) => x.slug === slug)!;
const color = PROYECTOS_ADMIN.find((x) => x.slug === slug)?.color ?? '#ff6fd8';
// El afiche es vertical: mejor la captura del celular, si la hay
const fotos = capturas(slug);
const foto = fotos.mobile ?? fotos.afiche;
// Títulos largos: la letra se achica para que entre en una línea
const tam = Math.min(22, Math.max(9, 150 / Math.max(p.titulo.length, 1)));
---
<div class="gen" aria-hidden="true" style={`--acento:${color}`}>
  <Image src={foto} alt="" widths={[500, 900]} sizes="(min-width: 768px) 36vw, 100vw" loading="lazy" class="gen-foto" />
  <div class="gen-sombra"></div>
  <div class="gen-franja"><span class="gen-titulo" style={`font-size:${tam}cqi`}>{p.titulo}</span></div>
  <p class="gen-lema">{p.logline}</p>
</div>

<style>
  .gen { position: absolute; inset: 0; overflow: hidden; background: #111; color: #fff; }
  .gen-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; filter: saturate(0.9); }
  .gen-sombra { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(0 0 0 / 0.1) 0%, transparent 35%, rgb(0 0 0 / 0.82) 72%); }
  .gen-franja {
    position: absolute; left: 0; right: 0; bottom: 30%;
    display: grid; place-items: center; padding: 3cqi 4cqi;
    background: var(--acento); color: #111;
    box-shadow: 0 1.5cqi 6cqi rgb(0 0 0 / 0.35);
  }
  .gen-titulo { font-family: var(--font-titulo); font-weight: 800; line-height: 0.95; letter-spacing: -0.045em; white-space: nowrap; }
  .gen-lema {
    position: absolute; left: 7cqi; right: 7cqi; bottom: 17%; text-align: center;
    font-family: var(--font-titulo); font-size: 4.8cqi; line-height: 1.15; letter-spacing: -0.02em;
  }
</style>
