---
/** The Magical Duo: ellos dos con Mickey y Minnie, a sangre, como el afiche de una película de viajes.
 *  Su logo crema arriba y su frase en Playfair sobre un degradé bordó, los colores de su web. */
import { Image } from 'astro:assets';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/400-italic.css';
import { capturas } from '../../content/capturas';
import logo from '../../assets/proyectos/tmd/logo-recorte.png';
import Creditos from './Creditos.astro';

const foto = capturas('tmd').afiche;
---
<div class="tmd" aria-hidden="true">
  <Image src={foto} alt="" widths={[500, 900]} sizes="(min-width: 768px) 30vw, 100vw" loading="lazy" class="tmd-foto" />
  <div class="tmd-sombra"></div>

  <Image src={logo} alt="" widths={[240, 480]} sizes="12rem" loading="lazy" class="tmd-logo" />

  <div class="tmd-pie">
    <p class="tmd-frase">Tu viaje soñado,<em>a un mensaje de distancia.</em></p>
    <Creditos class="tmd-creditos" slug="tmd" />
  </div>
</div>

<style>
  .tmd { position: absolute; inset: 0; overflow: hidden; background: #2e2620; color: #fbf8f3; }
  .tmd-foto { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  /* Arriba se oscurece apenas para el logo; abajo, el bordó de su marca */
  .tmd-sombra {
    position: absolute; inset: 0;
    background:
      linear-gradient(180deg, rgb(46 38 32 / 0.55) 0%, transparent 22%),
      linear-gradient(180deg, transparent 48%, rgb(140 42 66 / 0.8) 72%, #5c1a2b 100%);
  }
  .tmd-logo { position: absolute; top: 5cqi; left: 50%; width: 30cqi; height: auto; transform: translateX(-50%); filter: drop-shadow(0 0.6cqi 1.6cqi rgb(0 0 0 / 0.35)); }

  .tmd-pie { position: absolute; left: 0; right: 0; bottom: 0; padding: 0 6cqi 5cqi; text-align: center; }
  .tmd-frase { font-family: 'Playfair Display', Georgia, serif; font-weight: 700; font-size: 7.6cqi; line-height: 1.04; letter-spacing: -0.01em; }
  .tmd-frase em { display: block; font-weight: 400; font-style: italic; }
  :global(.tmd-creditos) { margin-top: 5cqi; --creditos-tam: 2.3cqi; --creditos-color: rgb(251 248 243 / 0.7); --creditos-estreno: #fbf8f3; }
</style>
