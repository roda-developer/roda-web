---
import { creditos } from '../content/guion';
const ficha = [
  ['Diseño y desarrollo', 'Giuliana y Facundo'],
  ['Filmado con', 'Astro · React · GSAP'],
  ['Tipografías', 'Instrument Serif · Instrument Sans · Bricolage Grotesque'],
  ['Duración', 'Tres minutos, más o menos'],
];
---
<section id="creditos" class="plano" aria-label="Créditos">
  <div class="w-full max-w-3xl text-center">
    <p class="mb-12 text-[0.7rem] tracking-[0.4em] text-[var(--acento)] uppercase" data-revelar>{creditos.intro}</p>
    <div class="space-y-12">
      {creditos.nombres.map((n, i) => (
        <div data-revelar={i * 6}>
          <h2 class="adapta-titulo font-titulo text-[clamp(4rem,20vw,11rem)] leading-[0.85] tracking-[-0.03em]">{n.nombre}</h2>
          <p class="mt-3 text-[0.7rem] tracking-[0.35em] text-niebla uppercase">{n.rol}</p>
        </div>
      ))}
    </div>
    <p class="mt-16 font-titulo text-[clamp(1.8rem,7vw,3.2rem)] leading-tight italic" data-revelar="10">
      {creditos.lema[0]}<br /><span class="text-[var(--acento)]">{creditos.lema[1]}</span>
    </p>

    <dl class="mx-auto mt-24 grid max-w-xl gap-5 text-[0.7rem] tracking-[0.22em] uppercase" data-revelar="4">
      {ficha.map(([k, v]) => (
        <div class="grid gap-1 md:grid-cols-[1fr_1.4fr] md:gap-6 md:text-left">
          <dt class="text-niebla md:text-right">{k}</dt>
          <dd class="text-pantalla/85 normal-case tracking-[0.06em] text-sm">{v}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
