---
import '@fontsource-variable/bricolage-grotesque';
import { Image } from 'astro:assets';
import { idiomaDe, rellenar, ruta, textos } from '../i18n';
import { capturas } from '../content/capturas';
import { proyectosEn } from '../content/proyectos';
const idioma = idiomaDe(Astro.currentLocale);
const { technicolor, ui } = textos(idioma);
// Las cintas corren media pista y vuelven a empezar sin que se note: la mitad (5 vueltas) tiene que ser más ancha que cualquier pantalla
const cinta = technicolor.cinta;
const pista = Array.from({ length: 10 }, () => cinta).flat();

// El grito está medido para el español ("Y A VECES / MÁS / ES MÁS."). En otro idioma las palabras son más largas
// ("SOMETIMES", "MORE"): cada línea se achica en la misma proporción para que entre en la pantalla.
const ES = textos('es').technicolor;
const letras = (s: string) => [...s.replace(/\s+/g, ' ')].length;
const palabraMasLarga = (s: string) => Math.max(...s.split(/\s+/).map(letras));
const k = (ref: number, val: number) => Math.min(1, ref / val).toFixed(3);
const escala = [
  `--k1h: ${k(letras(ES.grito[0]), letras(technicolor.grito[0]))}`,
  `--k1v: ${k(palabraMasLarga(ES.grito[0]), palabraMasLarga(technicolor.grito[0]))}`,
  `--k3h: ${k(letras(ES.grito[2]), letras(technicolor.grito[2]))}`,
  `--k3v: ${k(palabraMasLarga(ES.grito[2]), palabraMasLarga(technicolor.grito[2]))}`,
  `--km: ${k(ES.letras.join('').length, technicolor.letras.join('').length)}`,
].join('; ');

// El tráiler: una web por vez, como los cortes de un tráiler. Las cuatro con la portada horizontal más fuerte.
const tomas = ['emme', 'unik', 'muda', 'craft'].map((slug) => {
  const p = proyectosEn(idioma).find((x) => x.slug === slug)!;
  return { slug, titulo: p.titulo, genero: p.genero, anio: p.anio, img: capturas(slug).portada };
});
const total = String(tomas.length).padStart(2, '0');
---
<section id="technicolor" aria-label={ui.technicolor}>
  <!-- La puerta: el color se abre en un círculo, como Dorothy saliendo del sepia -->
  <div class="puerta relative h-[180svh]" data-puerta>
    <div class="sticky top-0 h-svh overflow-hidden">
      <!-- Arriba el grito, abajo las bandas: cada uno en su lugar, sin taparse -->
      <div class="color absolute inset-0 grid grid-cols-[minmax(0,1fr)] grid-rows-[1fr_auto] place-items-center overflow-hidden bg-tc-rosa px-4 pt-[clamp(3.5rem,8svh,4.5rem)] pb-[clamp(1.5rem,4svh,2.5rem)] text-tinta">
        <p class="grito text-center" style={escala}>
          <span class="block">{technicolor.grito[0]}</span>
          <span class="mas block" aria-label={ui.mas}>{technicolor.letras.map((l) => <span>{l}</span>)}</span>
          <span class="block">{technicolor.grito[2]}</span>
        </p>
        <div class="cintas pointer-events-none w-screen" aria-hidden="true">
          <div class="cinta cinta-a"><div>{pista.map((c) => <span>{c} ✺</span>)}</div></div>
          <div class="cinta cinta-b"><div>{pista.map((c) => <span>{c} ✦</span>)}</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- El tráiler: los proyectos de a uno, con cortes secos, sobre el mismo rosa del círculo (un solo color) -->
  <div class="trailer relative h-[220svh]" data-trailer>
    <div class="sala sticky top-0 h-svh overflow-hidden bg-tc-rosa text-tinta">
      <p class="mono absolute top-20 left-5 z-20 md:top-24 md:left-12">({technicolor.firma})</p>
      {tomas.map((t, i) => (
        <a href={ruta(idioma, 'proyectos', t.slug)} class="toma" data-toma>
          <span class="toma-cuadro">
            <Image src={t.img} alt={rellenar(technicolor.webDe, { titulo: t.titulo })} widths={[640, 1200, 1800]} sizes="(min-width: 1024px) 60vw, 90vw" loading="lazy" class="toma-img" />
          </span>
          <span class="toma-pie">
            <span class="toma-titulo">{t.titulo}</span>
            <span class="mono">({String(i + 1).padStart(2, '0')} / {total}) · {t.genero} · {t.anio}</span>
          </span>
        </a>
      ))}
      <a href={ruta(idioma, 'proyectos')} class="ver-todos cta absolute bottom-[5svh] left-5 z-20 md:left-12">{technicolor.verTodos}</a>
    </div>
  </div>

  <!-- Corte seco a blanco: el remate, sin ocupar una pantalla entera -->
  <div class="plano !min-h-[65svh]">
    <p class="max-w-5xl font-titulo text-[clamp(2.4rem,10vw,7rem)] leading-[0.98] tracking-[-0.045em] [text-wrap:balance]">
      <span class="block text-tinta/52">{technicolor.corte[0]}</span>
      <span class="block">{technicolor.corteEnfasis[0]}<em>{technicolor.corteEnfasis[1]}</em></span>
    </p>
  </div>

</section>

<style>
  /* Afiche: cada línea llena el ancho del bloque, y el bloque es tan ancho como deje el alto de la pantalla */
  .grito {
    container-type: inline-size;
    white-space: nowrap;
    width: min(calc(100vw - 2rem), calc((100svh - 16rem) / 0.82));
    font-family: var(--font-grito);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.82;
    letter-spacing: -0.045em;
  }
  .grito > span:first-child { font-size: calc(19.6cqi * var(--k1h, 1)); }
  .grito > span:last-child { font-size: calc(24.6cqi * var(--k3h, 1)); }
  .mas {
    margin: 0.04em 0 0.02em;
    font-size: calc(45cqi * var(--km, 1));
    line-height: 0.8;
    letter-spacing: -0.06em;
  }
  /* En pantalla vertical, "Y A / VECES" y "ES / MÁS." en dos líneas: así todo puede ser más grande */
  @media (max-aspect-ratio: 3/4) {
    .grito { white-space: normal; width: calc(100vw - 2rem); }
    .grito > span:first-child { font-size: calc(30.5cqi * var(--k1v, 1)); }
    .grito > span:last-child { font-size: calc(37cqi * var(--k3v, 1)); }
    .mas { font-size: calc(46cqi * var(--km, 1)); white-space: nowrap; }
  }
  .mas span { display: inline-block; }
  .mas span:nth-child(1) { color: var(--color-tc-rojo); transform: rotate(-6deg); }
  .mas span:nth-child(2) { color: var(--color-tc-azul); transform: translateY(-0.06em); }
  .mas span:nth-child(3) { color: var(--color-tc-amarillo); transform: rotate(7deg); }

  .cinta {
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-grito);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(0.9rem, min(4.2vw, 2.8svh), 1.8rem);
    padding: 0.45em 0;
    width: 120%;
    margin-left: -10%;
  }
  .cinta > div { display: inline-flex; gap: 1.2em; padding-right: 1.2em; }
  .cinta-a { background: var(--color-tc-rojo); color: var(--color-papel); transform: rotate(-3deg); }
  .cinta-b { background: var(--color-tc-azul); color: var(--color-tc-amarillo); transform: rotate(2deg) translateY(-0.15em); }

  @media (prefers-reduced-motion: no-preference) {
    /* Misma velocidad que antes: ahora media pista son 5 vueltas, así que dura cinco veces más */
    .cinta-a > div { animation: corre 110s linear infinite; }
    .cinta-b > div { animation: corre 130s linear infinite reverse; }
  }
  @keyframes corre { to { transform: translateX(-50%); } }

  /* El tráiler: cada toma ocupa la pantalla; la captura derecha, en un marco de papel, y el nombre grande abajo */
  .toma { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 1.25rem; padding: 7.5rem 1.25rem 8rem; }
  .toma-cuadro { display: block; width: min(90vw, calc((100svh - 19rem) * 1.6)); padding: 0.4rem; overflow: hidden; background: var(--color-papel); box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.55); }
  @media (min-width: 1024px) { .toma-cuadro { width: min(60vw, calc((100svh - 17rem) * 1.6)); padding: 0.5rem; } }
  .toma-cuadro :global(.toma-img) { display: block; width: 100%; height: auto; }
  .toma-pie { display: grid; justify-items: center; gap: 0.45rem; text-align: center; }
  .toma-titulo { font-family: var(--font-titulo); font-weight: 500; font-size: clamp(2.2rem, 8vw, 4.5rem); line-height: 1; letter-spacing: -0.045em; }

  @media (prefers-reduced-motion: reduce) {
    .puerta { height: auto; }
    .puerta > div { position: relative; height: 100svh; }
    .trailer { height: auto; }
    .sala { position: relative; height: auto; padding: 8rem 1.25rem 3rem; display: grid; gap: 3.5rem; }
    .toma { position: relative; inset: auto; padding: 0; }
    .ver-todos { position: relative; bottom: auto; left: auto; justify-self: start; }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const puerta = document.querySelector<HTMLElement>('[data-puerta]');
  if (puerta && movimientoPermitido()) {
    const q = gsap.utils.selector(puerta);
    // El círculo se abre en dos tiempos (en px, recalculados si cambia el tamaño de la pantalla):
    // 1) mientras la sección entra, crece hasta un tamaño que no llega al borde de arriba de la sección (así no se corta);
    // 2) cuando la sección ya llena la pantalla, termina de expandirse hasta cubrirla entera.
    const centroY = () => puerta.querySelector<HTMLElement>('.color')!.offsetHeight * 0.72;
    const seguro = () => `circle(${Math.round(centroY() * 0.94)}px at 78% 72%)`;
    const entero = () => `circle(${Math.round(Math.hypot(innerWidth, innerHeight) * 1.1)}px at 78% 72%)`;
    // La sección mide 180svh y empieza a contar cuando asoma: llena la pantalla al 100/180 del recorrido
    const llena = 100 / 180;
    // Estado inicial fijado antes de la animación: así ninguna letra aparece entera antes de tiempo y salta
    gsap.set(q('.grito > span'), { yPercent: 60, opacity: 0 });
    gsap.set(q('.mas span'), { scale: 0.2, opacity: 0, rotate: (i: number) => [-40, 20, 50][i] });
    gsap
      .timeline({ scrollTrigger: { trigger: puerta, start: 'top bottom', end: 'bottom bottom', scrub: 0.5, invalidateOnRefresh: true } })
      .fromTo(q('.color'), { clipPath: 'circle(0px at 78% 72%)' }, { clipPath: seguro, ease: 'power1.out', duration: llena }, 0)
      .to(q('.color'), { clipPath: entero, ease: 'power2.in', duration: 0.3 }, llena)
      // El texto aparece mientras el círculo se abre (no después): así las letras de MÁS nunca quedan chiquitas esperando
      .to(q('.grito > span'), { yPercent: 0, opacity: 1, stagger: 0.06, duration: 0.25, ease: 'expo.out' }, llena * 0.35)
      .to(q('.mas span'), { scale: 1, opacity: 1, rotate: 0, stagger: 0.04, duration: 0.25, ease: 'expo.out' }, llena * 0.5)
      .to({}, { duration: 1 - (llena + 0.35) > 0 ? 1 - (llena + 0.35) : 0.05 });
  }

  const trailer = document.querySelector<HTMLElement>('[data-trailer]');
  if (trailer && movimientoPermitido()) {
    const q = gsap.utils.selector(trailer);
    const tomas = q('[data-toma]');
    gsap.set(tomas.slice(1), { autoAlpha: 0 });
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: trailer, start: 'top top', end: 'bottom bottom', scrub: 0.3 },
    });
    const tramo = 1 / tomas.length;
    tomas.forEach((toma, i) => {
      // Cada plano se acerca apenas mientras dura, como una cámara que empuja
      tl.fromTo(toma.querySelector('.toma-img'), { scale: 1.06 }, { scale: 1, duration: tramo }, i * tramo);
      // Corte seco al siguiente
      if (i > 0) tl.set(tomas[i - 1], { autoAlpha: 0 }, i * tramo).set(toma, { autoAlpha: 1 }, i * tramo);
    });
  }
</script>
