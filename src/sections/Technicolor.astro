---
import '@fontsource-variable/bricolage-grotesque';
import { Image } from 'astro:assets';
import { technicolor } from '../content/guion';
import { capturas } from '../content/capturas';

const cinta = ['Más color', 'Más ruido', 'Más vos', 'Más ganas', 'Más marca'];

// La explosión: webs que hicimos, tiradas sobre la mesa. Posición en % del cuadro, giro en grados.
const tarjetas = [
  { img: capturas('emme').portada, alt: 'Web de Emme Digital', x: 3, y: 9, giro: -6 },
  { img: capturas('unik').portada, alt: 'Web de Unik', x: 50, y: 5, giro: 5 },
  { img: capturas('eber').pantallas[0], alt: 'Web de Eber', x: 28, y: 33, giro: -3 },
  { img: capturas('unik').pantallas[1] ?? capturas('unik').portada, alt: 'Proyectos de Unik', x: 58, y: 47, giro: 7 },
  { img: capturas('emme').pantallas[1] ?? capturas('emme').portada, alt: 'Trabajos de Emme Digital', x: 1, y: 54, giro: 4 },
  { img: capturas('craft').portada, alt: 'Web de Craft Studio', x: 38, y: 66, giro: -5, soloGrande: true },
  { img: capturas('muda').portada, alt: 'Web de MUDA', x: 71, y: 19, giro: -8, soloGrande: true },
];
const fondos = ['var(--color-tc-rojo)', 'var(--color-tc-azul)', 'var(--color-tc-verde)'];
---
<section id="technicolor" aria-label="Technicolor: a veces más es más">
  <!-- La puerta: el color se abre en un círculo, como Dorothy saliendo del sepia -->
  <div class="puerta relative h-[180svh]" data-puerta>
    <div class="sticky top-0 h-svh overflow-hidden">
      <!-- Arriba el grito, abajo las bandas: cada uno en su lugar, sin taparse -->
      <div class="color absolute inset-0 grid grid-cols-[minmax(0,1fr)] grid-rows-[1fr_auto] place-items-center overflow-hidden bg-tc-rosa px-4 pt-[clamp(3.5rem,8svh,4.5rem)] pb-[clamp(1.5rem,4svh,2.5rem)] text-tinta">
        <p class="grito text-center">
          <span class="block">{technicolor.grito[0]}</span>
          <span class="mas block" aria-label="más"><span>M</span><span>Á</span><span>S</span></span>
          <span class="block">{technicolor.grito[2]}</span>
        </p>
        <div class="cintas pointer-events-none w-screen" aria-hidden="true">
          <div class="cinta cinta-a"><div>{[...cinta, ...cinta].map((c) => <span>{c} ✺</span>)}</div></div>
          <div class="cinta cinta-b"><div>{[...cinta, ...cinta].map((c) => <span>{c} ✦</span>)}</div></div>
        </div>
      </div>
    </div>
  </div>

  <!-- La explosión: webs reales que hicimos, cayendo sobre la mesa mientras cambia el color -->
  <div class="explosion relative h-[135svh]" data-explosion>
    <div class="mesa sticky top-0 h-svh overflow-hidden" style={`background:${fondos[0]}`}>
      <p class="mono absolute top-20 left-5 z-20 bg-tinta px-2 py-1 text-papel md:top-24 md:left-12">({technicolor.firma})</p>
      {tarjetas.map((t) => (
        <figure
          class:list={['tarjeta', { 'hidden md:block': t.soloGrande }]}
          style={`left:${t.x}%;top:${t.y}%;--giro:${t.giro}deg`}
        >
          <Image src={t.img} alt={t.alt} widths={[480, 800]} sizes="(min-width: 768px) 30vw, 46vw" loading="lazy" class="block w-full" />
        </figure>
      ))}
      <a href="/proyectos" class="ver-todos cta absolute bottom-[6svh] left-5 z-20 md:left-12">{technicolor.verTodos}</a>
    </div>
  </div>

  <!-- Corte seco a blanco: el remate, sin ocupar una pantalla entera -->
  <div class="plano !min-h-[65svh]">
    <p class="max-w-5xl font-titulo text-[clamp(2.4rem,10vw,7rem)] leading-[0.98] tracking-[-0.045em] [text-wrap:balance]">
      <span class="block text-tinta/52">{technicolor.corte[0]}</span>
      <span class="block">Es saber cuál necesita tu <em>marca.</em></span>
    </p>
  </div>

</section>

<style>
  /* Afiche: cada línea llena el ancho del bloque, y el bloque es tan ancho como deje el alto de la pantalla */
  .grito {
    container-type: inline-size;
    white-space: nowrap;
    width: min(calc(100vw - 2rem), calc((100svh - 16rem) / 0.82));
    font-family: var(--font-grito);
    font-weight: 800;
    text-transform: uppercase;
    line-height: 0.82;
    letter-spacing: -0.045em;
  }
  .grito > span:first-child { font-size: 19.6cqi; }
  .grito > span:last-child { font-size: 24.6cqi; }
  .mas {
    margin: 0.04em 0 0.02em;
    font-size: 45cqi;
    line-height: 0.8;
    letter-spacing: -0.06em;
  }
  /* En pantalla vertical, "Y A / VECES" y "ES / MÁS." en dos líneas: así todo puede ser más grande */
  @media (max-aspect-ratio: 3/4) {
    .grito { white-space: normal; width: calc(100vw - 2rem); }
    .grito > span:first-child { font-size: 30.5cqi; }
    .grito > span:last-child { font-size: 37cqi; }
    .mas { font-size: 46cqi; white-space: nowrap; }
  }
  .mas span { display: inline-block; }
  .mas span:nth-child(1) { color: var(--color-tc-rojo); transform: rotate(-6deg); }
  .mas span:nth-child(2) { color: var(--color-tc-azul); transform: translateY(-0.06em); }
  .mas span:nth-child(3) { color: var(--color-tc-amarillo); transform: rotate(7deg); }

  .cinta {
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-grito);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(0.9rem, min(4.2vw, 2.8svh), 1.8rem);
    padding: 0.45em 0;
    width: 120%;
    margin-left: -10%;
  }
  .cinta > div { display: inline-flex; gap: 1.2em; padding-right: 1.2em; }
  .cinta-a { background: var(--color-tc-rojo); color: var(--color-papel); transform: rotate(-3deg); }
  .cinta-b { background: var(--color-tc-azul); color: var(--color-tc-amarillo); transform: rotate(2deg) translateY(-0.15em); }

  @media (prefers-reduced-motion: no-preference) {
    .cinta-a > div { animation: corre 22s linear infinite; }
    .cinta-b > div { animation: corre 26s linear infinite reverse; }
  }
  @keyframes corre { to { transform: translateX(-50%); } }

  /* La mesa de luz: capturas tiradas como fotos sobre un fondo que cambia de color */
  .tarjeta {
    position: absolute;
    width: 46vw;
    margin: 0;
    padding: 0.35rem;
    background: var(--color-papel);
    box-shadow: 0 30px 60px -25px rgb(0 0 0 / 0.55);
    transform: rotate(var(--giro));
  }
  /* En el celu van cinco tarjetas (no siete): las bajamos para que no tapen el rótulo ni dejen vacío el pie */
  @media (max-width: 767px) { .tarjeta { margin-top: 14svh; } }
  @media (min-width: 768px) { .tarjeta { width: 30vw; padding: 0.5rem; } }

  @media (prefers-reduced-motion: reduce) {
    .puerta { height: auto; }
    .puerta > div { position: relative; height: 100svh; }
    .explosion { height: auto; }
    .mesa { position: relative; height: auto; min-height: 100svh; padding: 8rem 1.25rem 3rem; display: grid; gap: 2rem; }
    .tarjeta { position: relative; left: auto !important; top: auto !important; width: 100%; max-width: 32rem; }
    .ver-todos { position: relative; bottom: auto; left: auto; justify-self: start; }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const puerta = document.querySelector<HTMLElement>('[data-puerta]');
  if (puerta && movimientoPermitido()) {
    const q = gsap.utils.selector(puerta);
    // El círculo se abre en dos tiempos (en px, recalculados si cambia el tamaño de la pantalla):
    // 1) mientras la sección entra, crece hasta un tamaño que no llega al borde de arriba de la sección (así no se corta);
    // 2) cuando la sección ya llena la pantalla, termina de expandirse hasta cubrirla entera.
    const centroY = () => puerta.querySelector<HTMLElement>('.color')!.offsetHeight * 0.72;
    const seguro = () => `circle(${Math.round(centroY() * 0.94)}px at 78% 72%)`;
    const entero = () => `circle(${Math.round(Math.hypot(innerWidth, innerHeight) * 1.1)}px at 78% 72%)`;
    // La sección mide 180svh y empieza a contar cuando asoma: llena la pantalla al 100/180 del recorrido
    const llena = 100 / 180;
    gsap
      .timeline({ scrollTrigger: { trigger: puerta, start: 'top bottom', end: 'bottom bottom', scrub: 0.5, invalidateOnRefresh: true } })
      .fromTo(q('.color'), { clipPath: 'circle(0px at 78% 72%)' }, { clipPath: seguro, ease: 'power1.out', duration: llena }, 0)
      .to(q('.color'), { clipPath: entero, ease: 'power2.in', duration: 0.3 }, llena)
      .from(q('.grito > span'), { yPercent: 60, opacity: 0, stagger: 0.06, duration: 0.25, ease: 'expo.out' }, llena + 0.04)
      .from(q('.mas span'), { scale: 0.2, rotate: (i: number) => [-40, 20, 50][i], stagger: 0.04, duration: 0.25, ease: 'expo.out' }, llena + 0.1)
      .to({}, { duration: 1 - (llena + 0.35) > 0 ? 1 - (llena + 0.35) : 0.05 });
  }

  const explosion = document.querySelector<HTMLElement>('[data-explosion]');
  if (explosion && movimientoPermitido()) {
    explosion.classList.add('animada');
    const q = gsap.utils.selector(explosion);
    const fondos = ['--color-tc-rojo', '--color-tc-azul', '--color-tc-verde'].map((v) =>
      getComputedStyle(document.documentElement).getPropertyValue(v).trim(),
    );

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: explosion, start: 'top 75%', end: 'bottom bottom', scrub: 0.5 },
    });
    // Las webs caen sobre la mesa, una atrás de otra
    tl.from(q('.tarjeta'), {
      scale: 0.3,
      opacity: 0,
      yPercent: 80,
      rotate: (i: number) => (i % 2 ? 30 : -30),
      stagger: 0.18,
      duration: 0.5,
      ease: 'back.out(1.6)',
    }, 0);
    // La mesa cambia de color mientras caen las webs
    [1, 2].forEach((n) => {
      tl.to(q('.mesa'), { backgroundColor: fondos[n], duration: 0.15 }, n * 0.6);
    });
    // Las capturas se mueven distinto mientras bajás: la mesa respira
    tl.to(q('.tarjeta'), { yPercent: (i: number) => (i % 2 ? -18 : 12), rotate: (i: number) => (i % 2 ? '+=4' : '-=4'), duration: 2.2 }, 0.2);
  }
</script>
