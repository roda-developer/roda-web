---
/**
 * La primera pantalla: R○DA gigante y, en la O chica, píxeles sueltos. Al abrirse, el scroll los junta: una compu que arma una web
 * y termina diciendo R○DA. Al scrollear la O crece, las letras se van y el video se acomoda como banner a lo ancho
 * de la sección Estudio (media pantalla, nunca entera).
 * Sin movimiento (o sin JS): el nombre arriba y la sección Estudio abajo, quietos, con el video en pausa (su portada).
 */
import { idiomaDe, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { inicio } = textos(idioma);
---
<section class="portal" data-portal aria-labelledby="portal-titulo">
  <div class="escena">
    <div class="cabeza">
      <h1 id="portal-titulo" class="palabra font-titulo">
        <span class="sr-only">{inicio.hero.lector}</span>
        <span aria-hidden="true">R</span><span class="anillo" aria-hidden="true"></span><span aria-hidden="true">DA</span>
      </h1>
      <p class="linea">{inicio.hero.linea}</p>
      <a href={ruta(idioma, 'contacto')} class="cta hero-cta" data-hero-cta>{inicio.final.cta}</a>
    </div>
    <div class="marco">
      <video class="marco-video" src="/videos/roda-escritorio.mp4?v=7" poster="/videos/roda-escritorio.jpg?v=7" muted loop playsinline preload="metadata" aria-label={inicio.estudio.video} data-video-estudio></video>
    </div>
    <div class="estudio" id="estudio">
      <h2 class="font-titulo">{inicio.estudio.titulo}</h2>
      <p>{inicio.estudio.texto}</p>
      <a href="#trabajos" class="cta">{inicio.estudio.cta}</a>
    </div>
  </div>
</section>

<style>
  /* Quieto (sin movimiento o sin JS): el nombre, y abajo la sección Estudio con su banner */
  .portal { --margen: 1.25rem; padding: 6rem var(--margen) 0; }
  @media (min-width: 768px) { .portal { --margen: clamp(1.5rem, 3.5vw, 3rem); } }
  .escena { position: relative; }
  .cabeza { display: grid; justify-items: center; gap: 1.5rem; padding-block: 8svh 12svh; text-align: center; }
  .palabra { display: flex; align-items: baseline; justify-content: center; font-size: min(23vw, 40svh); line-height: 0.8; letter-spacing: 0; }
  @media (min-width: 768px) { .palabra { font-size: min(19vw, 44svh); } }
  /* La O es el anillo del logo: un círculo dibujado, con el hueco del tamaño de la imagen */
  .anillo { display: inline-block; width: 0.74em; height: 0.74em; border: 0.13em solid currentColor; border-radius: 50%; margin-inline: 0.03em; }
  .linea { max-width: 30ch; font-size: clamp(1.125rem, 1.6vw, 1.5rem); line-height: 1.35; }
  /* El video es un banner a lo ancho (7:3), sobre papel (el video tiene fondo blanco) */
  .marco { position: relative; margin-inline: calc(var(--margen) * -1); aspect-ratio: 7 / 3; overflow: hidden; background: var(--color-papel); }
  @media (min-width: 768px) { .marco { margin-inline: 0; } }
  .marco-video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .estudio { display: grid; gap: 1.25rem; justify-items: start; padding-block: 2.5rem 4rem; }
  .estudio h2 { font-size: clamp(3rem, 8vw, 6rem); line-height: 0.9; }
  .estudio p { max-width: 38ch; font-size: clamp(1.125rem, 1.5vw, 1.375rem); line-height: 1.45; }
  @media (min-width: 1024px) {
    .estudio { grid-template-columns: auto 1fr auto; align-items: end; column-gap: clamp(2rem, 4vw, 4rem); }
  }

  /* Con movimiento: la escena queda fija mientras la O se abre */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .portal { height: 240svh; padding: 0; }
    :global(.js) .escena { position: sticky; top: 0; height: 100svh; overflow: hidden; }
    :global(.js) .cabeza { position: absolute; inset: 0; z-index: 2; place-content: center; padding: 0 var(--margen); }
    :global(.js) .palabra { will-change: transform; }
    /* El banner a lo ancho: en celu de borde a borde, en compu con margen; el texto abajo */
    :global(.js) .marco { position: absolute; z-index: 1; margin: 0; aspect-ratio: auto; left: 0; right: 0; top: 13svh; height: 42svh; will-change: transform, clip-path; }
    /* El bloque no toma toques (mientras no se ve taparía el botón del hero); sus partes sí, cuando aparecen */
    :global(.js) .estudio { position: absolute; z-index: 3; left: var(--margen); right: var(--margen); top: calc(13svh + 42svh + 1.5rem); padding: 0; pointer-events: none; }
    :global(.js) .estudio > * { pointer-events: auto; }
    @media (min-width: 768px) {
      :global(.js) .marco { left: var(--margen); right: var(--margen); top: 13svh; height: 54svh; }
      :global(.js) .estudio { top: auto; bottom: 6svh; }
    }
    /* Hasta que el script mide la O, la imagen y Estudio no se ven (así no aparecen de golpe en su lugar final) */
    :global(.js) .portal:not(.listo) .marco, :global(.js) .portal:not(.listo) .estudio { visibility: hidden; }
  }
</style>

<script>
  import { ScrollTrigger, movimientoPermitido } from '../motion/index';

  const portal = document.querySelector<HTMLElement>('[data-portal]');
  if (portal && movimientoPermitido()) {
    const escena = portal.querySelector<HTMLElement>('.escena')!;
    const palabra = portal.querySelector<HTMLElement>('.palabra')!;
    const anillo = portal.querySelector<HTMLElement>('.anillo')!;
    const linea = portal.querySelector<HTMLElement>('.linea')!;
    const heroCta = portal.querySelector<HTMLElement>('[data-hero-cta]');
    const marco = portal.querySelector<HTMLElement>('.marco')!;
    const partesEstudio = [...portal.querySelectorAll<HTMLElement>('.estudio > *')];

    // Posición dentro de la escena con offset (no lo cambian los transform, así se puede medir en cualquier momento)
    const posicion = (el: HTMLElement) => {
      let x = 0, y = 0, n: HTMLElement | null = el;
      while (n && n !== escena) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null; }
      return { x, y };
    };
    // Dónde arranca la imagen: achicada y recortada en círculo justo en el hueco de la O
    let m = { x: 0, y: 0, s: 1, mx: 0, my: 0, radio: 0 };
    const medir = () => {
      const a = posicion(anillo);
      const borde = parseFloat(getComputedStyle(anillo).borderTopWidth);
      const hueco = anillo.offsetWidth - borde * 2 - 1;
      const cx = a.x + anillo.offsetWidth / 2, cy = a.y + anillo.offsetHeight / 2;
      const b = { x: marco.offsetLeft, y: marco.offsetTop, w: marco.offsetWidth, h: marco.offsetHeight };
      const lado = Math.min(b.w, b.h);
      m = { x: cx - (b.x + b.w / 2), y: cy - (b.y + b.h / 2), s: hueco / lado, mx: (b.w - lado) / 2, my: (b.h - lado) / 2, radio: lado / 2 };
      const p = posicion(palabra);
      palabra.style.transformOrigin = `${cx - p.x}px ${cy - p.y}px`;
    };

    // Cuándo la imagen llega a su tamaño dentro de la O (después se acomoda como banner)
    const tope = () => { const b = (1 / m.s - 1) / 8; return b <= 1 ? 0.1 + 0.4 * Math.sqrt(b) : 0.5; };

    // Todo sale del progreso del scroll (0 a 1): así nunca queda nada a mitad de camino al recalcular
    const tramo = (p: number, desde: number, largo: number) => Math.min(1, Math.max(0, (p - desde) / largo));
    const entraSale = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);
    const acelera = (t: number) => t * t;
    const frena = (t: number) => 1 - (1 - t) ** 3;
    const pintar = (p: number) => {
      linea.style.opacity = String(1 - tramo(p, 0.06, 0.08));
      // El botón se va con la frase: apenas empezás a bajar ya no hace falta (y no se puede tabular cuando no se ve)
      if (heroCta) {
        const c = 1 - tramo(p, 0.03, 0.07);
        heroCta.style.opacity = String(c);
        heroCta.style.visibility = c <= 0 ? 'hidden' : '';
      }
      // Las letras crecen desde el centro de la O (hasta 9 veces) y se apagan
      const b = acelera(tramo(p, 0.1, 0.4));
      const k = 1 + 8 * b;
      palabra.style.transform = `scale(${k})`;
      palabra.style.opacity = String(1 - b);
      palabra.style.visibility = b >= 1 ? 'hidden' : '';
      // Primero la foto crece igual que el anillo, así nunca se sale del hueco de la O.
      // Cuando llega a su tamaño (o el anillo ya se fue), se acomoda como banner.
      const pTope = tope();
      const escalaTope = Math.min(1, m.s * 9);
      let escala: number, r: number;
      if (p < pTope) {
        escala = Math.min(1, m.s * k);
        r = 1;
      } else {
        const a = entraSale(tramo(p, pTope, 0.2));
        escala = escalaTope + (1 - escalaTope) * a;
        r = 1 - a;
      }
      marco.style.transform = `translate(${m.x * r}px, ${m.y * r}px) scale(${escala})`;
      marco.style.clipPath = `inset(${m.my * r}px ${m.mx * r}px ${m.my * r}px ${m.mx * r}px round ${m.radio * r}px)`;
      const inicioEstudio = Math.max(0.56, pTope + 0.16);
      partesEstudio.forEach((el, i) => {
        const c = frena(tramo(p, inicioEstudio + i * 0.04, 0.14));
        el.style.opacity = String(c);
        el.style.transform = `translateY(${24 * (1 - c)}px)`;
        // Mientras no se ve, no se puede tocar ni tabular
        el.style.visibility = c <= 0 ? 'hidden' : '';
      });
    };

    // El video y el scroll: con la O cerrada, adentro solo hay píxeles sueltos (el primer cuadro, quieto).
    // Mientras la O se abre, el scroll junta los píxeles (los primeros 40 cuadros del video avanzan con vos).
    // Cuando ya es banner, el video sigue solo. Corre solo mientras la escena está en pantalla.
    const video = portal.querySelector<HTMLVideoElement>('[data-video-estudio]');
    const ARMADO = 40 / 24; // segundos del video en que los píxeles se juntan
    let visible = false, libre = false, tiempo = 0, cuadro = 0;
    const decidir = () => {
      if (!video) return;
      if (visible && libre) video.play().catch(() => {});
      else video.pause();
    };
    const buscar = () => {
      cuadro = 0;
      if (video && !libre && Math.abs(video.currentTime - tiempo) > 0.02) video.currentTime = tiempo;
    };
    const seguir = (p: number) => {
      const fin = tope() + 0.2;
      const ahora = p >= fin;
      tiempo = tramo(p, 0.03, fin - 0.03) * ARMADO;
      if (ahora !== libre) { libre = ahora; decidir(); }
      // Una búsqueda por cuadro de pantalla, como mucho
      if (!libre && !cuadro) cuadro = requestAnimationFrame(buscar);
    };

    medir();
    const disparador = ScrollTrigger.create({
      trigger: portal,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (self) => { pintar(self.progress); seguir(self.progress); },
      onRefresh: (self) => { medir(); pintar(self.progress); },
    });
    pintar(disparador.progress);
    portal.classList.add('listo');

    if (video) {
      video.poster = '/videos/roda-polvo.jpg?v=7';
      seguir(disparador.progress);
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; decidir(); }).observe(portal);
    }
  }
</script>
