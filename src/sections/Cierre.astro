---
import Final from '../components/Final.tsx';
import Marca from '../components/Marca.astro';
import { cierre } from '../content/guion';
import { MAIL } from '../content/contacto';
---
<section id="final" class="plano" aria-label="Tu historia">
  <Final client:idle />
</section>

<footer class="relative z-10 border-t border-pantalla/10 px-5 pt-10 pb-6 md:px-8">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <p class="text-5xl md:text-7xl"><Marca /></p>
    <div class="space-y-1 text-sm text-niebla md:text-right">
      <p><a class="text-pantalla hover:text-tungsteno" href={`mailto:${MAIL}`}>{MAIL}</a></p>
      <p>© {new Date().getFullYear()} Roda · Giuliana y Facundo</p>
    </div>
  </div>
</footer>

<!-- Escena post-créditos: para quienes se quedan hasta el final -->
<div class="post-creditos relative z-10 grid min-h-[60svh] place-items-center px-5 pb-16">
  <p class="max-w-[28ch] text-center font-titulo text-2xl leading-snug text-pantalla/60 italic md:text-3xl" data-revelar="18">
    {cierre.postCreditos}
  </p>
</div>
