---
import { cartelera } from '../content/guion';
import Rotulo from '../components/Rotulo.astro';
import Marca from '../components/Marca.astro';

const colores = {
  rosa: 'var(--color-tc-rosa)',
  verde: 'var(--color-tc-verde)',
  amarillo: 'var(--color-tc-amarillo)',
  rojo: 'var(--color-tc-rojo)',
  azul: 'var(--color-tc-azul)',
} as const;
const dias = Array.from({ length: 28 }, (_, i) => i + 1);
---
<!-- La cartelera: cada tipo de web es una película. En el celular se desliza de costado. -->
<section id="cartelera" class="py-24 md:py-32" aria-labelledby="cartelera-titulo">
  <div class="px-5 md:px-12">
    <Rotulo rotulo={cartelera.rotulo} tipo="Parte" />
    <h2 id="cartelera-titulo" class="mt-10 font-titulo text-[clamp(2.6rem,9vw,6rem)] leading-[0.95] tracking-[-0.045em] [text-wrap:balance]" data-revelar>
      <span class="block text-tinta/52">{cartelera.titulo[0]}</span>
      <span class="block">{cartelera.titulo[1]}</span>
    </h2>
  </div>

  <ul class="tira mt-14 md:mt-20" data-revelar="4">
    {cartelera.peliculas.map((p) => (
      <li>
        <a href="#planes" class="afiche" style={`--color:${colores[p.color]}`} aria-label={`${p.articulo} ${p.titulo}: ${p.frase} ${p.precio}`}>
          <div class="interior">
          <p class="presenta" aria-hidden="true"><Marca /><span>presenta</span></p>
          <div class="escena" aria-hidden="true">
            <span class="sol"></span>
            <div class={`dibujo dibujo-${p.id}`}>
              {p.id === 'portfolio' && Array.from({ length: 9 }, (_, i) => <i class:list={{ destacado: i === 4 }} style={`--o:${0.12 + (i % 3) * 0.1}`}></i>)}
              {p.id === 'agenda' && <><b>Octubre</b>{dias.map((d) => <i class:list={{ destacado: d === 18 }}>{d}</i>)}</>}
              {p.id === 'tienda' && <><span class="bolsa">2</span>{[0, 1, 2, 3].map((i) => <div><i class:list={{ destacado: i === 1 }}></i><s></s><u></u></div>)}</>}
              {p.id === 'landing' && <><s></s><s class="corta"></s><span class="boton">Escribinos →</span></>}
              {p.id === 'panel' && <><p>+ Nuevo proyecto</p>{['Publicado', 'Publicado', 'Borrador'].map((e, i) => <div><i></i><s></s><em class:list={{ destacado: i < 2 }}>{e}</em></div>)}</>}
            </div>
          </div>
          <p class="frase" aria-hidden="true">{p.frase}</p>
          <h3 class="titulo" aria-hidden="true"><small>{p.articulo}</small>{p.titulo}</h3>
          <p class="creditos" aria-hidden="true">{p.creditos}</p>
          <p class="pie" aria-hidden="true"><span class:list={['sello', { 'sello-claro': p.color === 'azul' }]}>{cartelera.enCartel}</span><span>{p.precio} →</span></p>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* La tira: en el celular se desliza; en la compu, las cinco entran a lo ancho */
  .tira {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(72vw, 20rem);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 1.25rem 2.5rem;
    scroll-padding: 0 1.25rem;
    scrollbar-width: none;
  }
  .tira::-webkit-scrollbar { display: none; }
  .tira > li { scroll-snap-align: start; }
  @media (min-width: 1024px) {
    .tira { grid-auto-flow: row; grid-template-columns: repeat(5, minmax(0, 1fr)); overflow: visible; padding: 0 3rem 2.5rem; }
  }

  /* Cada afiche mide en unidades de su propio ancho: se ve igual chico o grande */
  .afiche {
    container-type: inline-size;
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-papel);
    border: 1px solid color-mix(in oklab, var(--color-tinta) 8%, transparent);
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.45);
    transition: transform 0.6s var(--ease-cine), box-shadow 0.6s var(--ease-cine);
  }
  .afiche:hover { transform: translateY(-6px) rotate(-0.6deg); box-shadow: 0 40px 60px -30px rgb(0 0 0 / 0.5); }
  @media (prefers-reduced-motion: reduce) { .afiche, .afiche:hover { transition: none; transform: none; } }

  .interior { display: flex; flex-direction: column; height: 100%; padding: 6cqi; }
  .presenta { display: flex; align-items: baseline; justify-content: center; gap: 2.4cqi; font-size: 7.4cqi; }
  .presenta > span:last-child { font-family: var(--font-mono); font-size: 2.7cqi; letter-spacing: 0.3em; text-transform: uppercase; }

  .escena { position: relative; flex: 1; display: grid; place-items: center; margin: 3cqi 0 2cqi; }
  .sol { position: absolute; width: 64cqi; aspect-ratio: 1; border-radius: 50%; background: var(--color); right: -14cqi; top: 1cqi; opacity: 0.9; }
  .dibujo {
    position: relative;
    width: 66%;
    padding: 3.5cqi;
    background: #fbfaf7;
    box-shadow: 0 14px 30px -18px rgb(0 0 0 / 0.5);
    font-family: var(--font-mono);
    font-size: 2.6cqi;
    color: var(--color-tinta);
  }

  .frase { font-style: italic; font-size: 4.4cqi; color: var(--color-gris); }
  .titulo { font-family: var(--font-titulo); font-weight: 500; font-size: 22cqi; line-height: 0.86; letter-spacing: -0.055em; }
  .titulo small { display: block; font-size: 6cqi; font-style: italic; font-weight: 400; letter-spacing: -0.01em; margin-bottom: 1cqi; }
  .creditos {
    margin-top: 4cqi;
    padding-top: 2.6cqi;
    border-top: 1px solid color-mix(in oklab, var(--color-tinta) 20%, transparent);
    font-size: 2.5cqi;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }
  .pie { display: flex; justify-content: space-between; margin-top: 2.6cqi; font-family: var(--font-mono); font-size: 3cqi; letter-spacing: 0.16em; text-transform: uppercase; }
  .sello { background: var(--color); padding: 0.1em 0.4em; }
  .sello-claro { color: var(--color-papel); }

  /* Los dibujos: un pedacito de cada web */
  .destacado { background: var(--color) !important; opacity: 1 !important; }
  .dibujo-portfolio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqi; }
  .dibujo-portfolio i { aspect-ratio: 1; background: var(--color-tinta); opacity: var(--o); }
  .dibujo-agenda { display: grid; grid-template-columns: repeat(7, 1fr); gap: 1cqi; width: 76%; }
  .dibujo-agenda b { grid-column: 1 / -1; font-family: var(--font-titulo); font-weight: 500; font-size: 4.6cqi; margin-bottom: 1cqi; }
  .dibujo-agenda i { font-style: normal; aspect-ratio: 1; display: grid; place-items: center; border: 1px solid color-mix(in oklab, var(--color-tinta) 12%, transparent); font-size: 2.2cqi; }
  .dibujo-agenda i.destacado { border-color: transparent; font-weight: 700; }
  .dibujo-tienda { display: grid; grid-template-columns: 1fr 1fr; gap: 3cqi; }
  .dibujo-tienda div i { display: block; aspect-ratio: 1; background: var(--color-tinta); opacity: 0.15; }
  .dibujo-tienda s, .dibujo-tienda u { display: block; height: 1.6cqi; margin-top: 1.6cqi; width: 80%; background: color-mix(in oklab, var(--color-tinta) 20%, transparent); }
  .dibujo-tienda u { width: 40%; background: color-mix(in oklab, var(--color-tinta) 50%, transparent); }
  .bolsa { position: absolute; right: -3cqi; top: -3cqi; z-index: 1; width: 8cqi; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: var(--color); font-weight: 700; font-size: 3.4cqi; }
  .dibujo-landing { display: grid; gap: 2.4cqi; justify-items: start; }
  .dibujo-landing s { display: block; height: 6cqi; width: 100%; background: var(--color-tinta); }
  .dibujo-landing .corta { width: 60%; }
  .boton { margin-top: 2cqi; padding: 2cqi 4cqi; border-radius: 99px; background: var(--color); letter-spacing: 0.1em; text-transform: uppercase; }
  .dibujo-panel p { border: 1px dashed color-mix(in oklab, var(--color-tinta) 40%, transparent); padding: 2cqi; text-align: center; text-transform: uppercase; margin-bottom: 2cqi; }
  .dibujo-panel div { display: flex; align-items: center; gap: 2cqi; padding: 2cqi 0; border-bottom: 1px solid color-mix(in oklab, var(--color-tinta) 12%, transparent); }
  .dibujo-panel i { width: 8cqi; height: 6cqi; background: color-mix(in oklab, var(--color-tinta) 15%, transparent); }
  .dibujo-panel s { flex: 1; height: 1.6cqi; background: color-mix(in oklab, var(--color-tinta) 25%, transparent); }
  .dibujo-panel em { font-style: normal; padding: 0.3em 0.8em; border-radius: 99px; color: var(--color-papel); background: #bdbab3; }
</style>
