---
import { cartelera, planes } from '../content/guion';
import Rotulo from '../components/Rotulo.astro';
import Marca from '../components/Marca.astro';

const colores = {
  rosa: 'var(--color-tc-rosa)',
  verde: 'var(--color-tc-verde)',
  amarillo: 'var(--color-tc-amarillo)',
  rojo: 'var(--color-tc-rojo)',
  azul: 'var(--color-tc-azul)',
} as const;
---
<!-- La cartelera: cada tipo de web es una película. En el celular se desliza de costado. -->
<section id="cartelera" class="py-24 md:py-32" aria-labelledby="cartelera-titulo">
  <div class="px-5 md:px-12 flex flex-col md:flex-row md:items-end md:justify-between gap-6">
    <div>
      <Rotulo rotulo={cartelera.rotulo} tipo="Parte" />
      <h2 id="cartelera-titulo" class="mt-10 font-titulo text-[clamp(2.6rem,9vw,6rem)] leading-[0.95] tracking-[-0.045em] [text-wrap:balance]" data-revelar>
        <span class="block text-tinta/52">{cartelera.titulo[0]}</span>
        <span class="block">{cartelera.titulo[1]}</span>
      </h2>
    </div>

    <!-- Controles de navegación horizontal en mobile -->
    <div class="flex items-center justify-between sm:justify-start gap-4 lg:hidden" aria-label="Navegar cartelera">
      <span class="mono text-[0.75rem] text-tinta/60 tracking-wider flex items-center gap-1.5">
        <span class="inline-block w-2 h-2 rounded-full bg-tc-rosa animate-pulse"></span>
        {cartelera.deslizar}
      </span>
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="btn-tira-nav btn-prev inline-flex items-center justify-center w-11 h-11 rounded-full border border-tinta/15 bg-papel text-tinta active:scale-95 transition-transform"
          aria-label="Ver película anterior"
        >
          <!-- Flecha dibujada (no un carácter): así queda centrada exacta en el círculo -->
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
        </button>
        <button
          type="button"
          class="btn-tira-nav btn-next inline-flex items-center justify-center w-11 h-11 rounded-full border border-tinta/15 bg-papel text-tinta active:scale-95 transition-transform"
          aria-label="Ver siguiente película"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </div>
    </div>
  </div>

  <ul class="tira mt-10 md:mt-20" data-revelar="4" data-lenis-prevent="true">
    {cartelera.peliculas.map((p) => (
      <li>
        <a href={`/precios#${p.id}`} class="afiche" style={`--color:${colores[p.color]}`} aria-label={`${p.articulo} ${p.titulo}: ${p.frase} ${p.precio}`}>
          <div class="interior">
          <p class="presenta" aria-hidden="true"><Marca /><span>presenta</span></p>
          <div class="escena" aria-hidden="true">
            <span class="sol"></span>
            <div class={`dibujo dibujo-${p.dibujo}`}>
              {p.dibujo === 'portfolio' && Array.from({ length: 9 }, (_, i) => <i class:list={{ destacado: i === 4 }} style={`--o:${0.12 + (i % 3) * 0.1}`}></i>)}
              {p.dibujo === 'tienda' && <><span class="bolsa">2</span>{[0, 1, 2, 3].map((i) => <div><i class:list={{ destacado: i === 1 }}></i><s></s><u></u></div>)}</>}
              {p.dibujo === 'landing' && <><s></s><s class="corta"></s><span class="boton">Escribinos →</span></>}
            </div>
          </div>
          <p class="frase" aria-hidden="true">{p.frase}</p>
          <h3 class:list={['titulo', { 'titulo-largo': p.titulo.length > 8 }]} aria-hidden="true"><small>{p.articulo}</small>{p.titulo}</h3>
          <p class="creditos" aria-hidden="true">{p.creditos}</p>
          <p class="pie" aria-hidden="true"><span class:list={['sello', { 'sello-claro': p.color === 'azul' }]}>{cartelera.enCartel}</span><span>{p.precio} →</span></p>
          </div>
        </a>
      </li>
    ))}
  </ul>

  <!-- Los precios ya están en los afiches: abajo solo lo que incluyen todas y el detalle completo -->
  <div class="mt-4 flex flex-col gap-5 px-5 md:px-12 lg:flex-row lg:items-center lg:justify-between" data-revelar="6">
    <p class="mono text-gris">{planes.todas.join(' · ')}</p>
    <a href="/precios" class="cta self-start">{planes.verTodo}</a>
  </div>
</section>

<style>
  /* La tira: en el celular se desliza de costado suavemente; en la compu entran las tres */
  .tira {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(76vw, 20rem);
    gap: 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-x pan-y;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    padding: 0 1.25rem 2.5rem;
    scroll-padding: 0 1.25rem;
    scrollbar-width: none;
    cursor: grab;
  }
  .tira:active {
    cursor: grabbing;
  }
  .tira::-webkit-scrollbar { display: none; }
  .tira > li { scroll-snap-align: start; }
  @media (min-width: 1024px) {
    .tira {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
      padding: 0 3rem 2.5rem;
      cursor: default;
    }
  }

  /* Cada afiche mide en unidades de su propio ancho: se ve igual chico o grande */
  .afiche {
    container-type: inline-size;
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    background: var(--color-papel);
    border: 1px solid color-mix(in oklab, var(--color-tinta) 8%, transparent);
    box-shadow: 0 30px 50px -30px rgb(0 0 0 / 0.45);
    transition: transform 0.6s var(--ease-cine), box-shadow 0.6s var(--ease-cine);
  }
  /* El que detecta el mouse es el li, que no se mueve: si fuera el afiche, al subir se escaparía del cursor y temblaría */
  .tira > li:hover .afiche, .afiche:focus-visible { transform: translateY(-6px) rotate(-0.6deg); box-shadow: 0 40px 60px -30px rgb(0 0 0 / 0.5); }
  @media (prefers-reduced-motion: reduce) { .afiche, .tira > li:hover .afiche { transition: none; transform: none; } }

  .interior { display: flex; flex-direction: column; height: 100%; padding: 6cqi; }
  .presenta { display: flex; align-items: baseline; justify-content: center; gap: 2.4cqi; font-size: 7.4cqi; }
  .presenta > span:last-child { font-family: var(--font-mono); font-size: 2.7cqi; letter-spacing: 0.3em; text-transform: uppercase; }

  .escena { position: relative; flex: 1; display: grid; place-items: center; margin: 3cqi 0 2cqi; }
  .sol { position: absolute; width: 64cqi; aspect-ratio: 1; border-radius: 50%; background: var(--color); right: -14cqi; top: 1cqi; opacity: 0.9; }
  .dibujo {
    position: relative;
    width: 66%;
    padding: 3.5cqi;
    background: #fbfaf7;
    box-shadow: 0 14px 30px -18px rgb(0 0 0 / 0.5);
    font-family: var(--font-mono);
    font-size: 2.6cqi;
    color: var(--color-tinta);
  }

  .frase { font-style: italic; font-size: 4.4cqi; color: var(--color-gris); }
  .titulo { font-family: var(--font-titulo); font-weight: 500; font-size: 22cqi; line-height: 0.86; letter-spacing: -0.055em; }
  /* Los títulos largos (Multisección) se achican para entrar en el afiche */
  .titulo-largo { font-size: 15.5cqi; padding-top: 4.5cqi; }
  .titulo small { display: block; font-size: 6cqi; font-style: italic; font-weight: 400; letter-spacing: -0.01em; margin-bottom: 1cqi; }
  .creditos {
    margin-top: 4cqi;
    padding-top: 2.6cqi;
    border-top: 1px solid color-mix(in oklab, var(--color-tinta) 20%, transparent);
    font-size: 2.5cqi;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }
  .pie { display: flex; justify-content: space-between; margin-top: 2.6cqi; font-family: var(--font-mono); font-size: 3cqi; letter-spacing: 0.16em; text-transform: uppercase; }
  .sello { background: var(--color); padding: 0.1em 0.4em; }
  .sello-claro { color: var(--color-papel); }

  /* Los dibujos: un pedacito de cada web */
  .destacado { background: var(--color) !important; opacity: 1 !important; }
  .dibujo-portfolio { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2cqi; }
  .dibujo-portfolio i { aspect-ratio: 1; background: var(--color-tinta); opacity: var(--o); }
  .dibujo-tienda { display: grid; grid-template-columns: 1fr 1fr; gap: 3cqi; }
  .dibujo-tienda div i { display: block; aspect-ratio: 1; background: var(--color-tinta); opacity: 0.15; }
  .dibujo-tienda s, .dibujo-tienda u { display: block; height: 1.6cqi; margin-top: 1.6cqi; width: 80%; background: color-mix(in oklab, var(--color-tinta) 20%, transparent); }
  .dibujo-tienda u { width: 40%; background: color-mix(in oklab, var(--color-tinta) 50%, transparent); }
  .bolsa { position: absolute; right: -3cqi; top: -3cqi; z-index: 1; width: 8cqi; aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center; background: var(--color); font-weight: 700; font-size: 3.4cqi; }
  .dibujo-landing { display: grid; gap: 2.4cqi; justify-items: start; }
  .dibujo-landing s { display: block; height: 6cqi; width: 100%; background: var(--color-tinta); }
  .dibujo-landing .corta { width: 60%; }
  .boton { margin-top: 2cqi; padding: 2cqi 4cqi; border-radius: 99px; background: var(--color); letter-spacing: 0.1em; text-transform: uppercase; }
</style>

<script>
  const tira = document.querySelector<HTMLElement>('.tira');
  const btnPrev = document.querySelector<HTMLButtonElement>('.btn-prev');
  const btnNext = document.querySelector<HTMLButtonElement>('.btn-next');

  if (tira) {
    const avanzar = (delta: number) => {
      const primerItem = tira.querySelector<HTMLElement>('li');
      const distancia = primerItem ? primerItem.offsetWidth + 20 : 280;
      tira.scrollBy({ left: delta * distancia, behavior: 'smooth' });
    };

    btnPrev?.addEventListener('click', () => avanzar(-1));
    btnNext?.addEventListener('click', () => avanzar(1));

    // Soporte para arrastrar con mouse / touch además del swipe nativo
    let arrastrando = false;
    let posX = 0;
    let scrollX = 0;

    tira.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      arrastrando = true;
      posX = e.clientX;
      scrollX = tira.scrollLeft;
      tira.style.scrollSnapType = 'none';
      tira.style.scrollBehavior = 'auto';
    });

    const terminarArrastre = () => {
      if (!arrastrando) return;
      arrastrando = false;
      tira.style.scrollSnapType = 'x proximity';
      tira.style.scrollBehavior = 'smooth';
    };

    window.addEventListener('pointerup', terminarArrastre);
    window.addEventListener('pointercancel', terminarArrastre);

    tira.addEventListener('pointermove', (e) => {
      if (!arrastrando) return;
      const diff = e.clientX - posX;
      tira.scrollLeft = scrollX - diff;
    });
  }
</script>
