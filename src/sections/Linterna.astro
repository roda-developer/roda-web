---
/**
 * Segunda opción de primera pantalla: RODA gigante sobre papel y un círculo (como la O del logo) que sigue al cursor
 * y deja ver un trabajo escondido debajo. Las letras se invierten donde pasa. En el celu el círculo se mueve solo.
 * Sin movimiento: el círculo queda quieto.
 */
import { Image } from 'astro:assets';
import { capturas } from '../content/capturas';
import { idiomaDe, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { inicio } = textos(idioma);
// PENDIENTE (Giuli): la imagen de debajo la elige ella
const debajo = capturas('muda').afiche;
---
<section class="linterna" data-linterna aria-labelledby="linterna-titulo">
  <Image src={debajo} alt="" widths={[640, 1200, 1800, 2400]} sizes="100vw" loading="eager" fetchpriority="high" class="debajo" />
  <h1 id="linterna-titulo" class="palabra font-titulo">
    <span class="sr-only">{inicio.hero.lector}</span>
    <span aria-hidden="true">{inicio.hero.marca}</span>
  </h1>
  <div class="pie">
    <p class="linea">{inicio.hero.linea}</p>
    <div class="acciones">
      <a href={ruta(idioma, 'contacto')} class="cta">{inicio.hero.hablemos}</a>
      <a href="#trabajos" class="enlace">{inicio.hero.verTrabajos}</a>
    </div>
  </div>
</section>

<style>
  .linterna { --lx: 62%; --ly: 46%; --r: clamp(5.5rem, 13vw, 13rem); position: relative; height: 100svh; min-height: 34rem; overflow: hidden; isolation: isolate; }
  .linterna :global(.debajo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; clip-path: circle(var(--r) at var(--lx) var(--ly)); }
  /* Blanco con "difference": sobre el papel se lee negro, sobre la foto se invierte */
  .palabra, .pie { color: #fff; mix-blend-mode: difference; }
  .palabra { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-58%); text-align: center; font-size: min(36vw, 52svh); line-height: 0.8; letter-spacing: 0; pointer-events: none; }
  .pie { position: absolute; left: 1.25rem; right: 1.25rem; bottom: 2rem; display: grid; gap: 1.25rem; justify-items: start; }
  @media (min-width: 768px) {
    .pie { left: clamp(1.5rem, 3.5vw, 3rem); right: clamp(1.5rem, 3.5vw, 3rem); bottom: 3rem; grid-template-columns: 1fr auto; align-items: end; }
  }
  .linea { max-width: 30ch; font-size: clamp(1.125rem, 1.6vw, 1.5rem); line-height: 1.35; }
  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  /* El botón pierde el "difference" para que quede negro sólido, como en el resto de la web */
  .pie .cta { mix-blend-mode: normal; background: #fff; color: #000; }
  .enlace { display: inline-flex; min-height: 2.75rem; align-items: center; text-decoration: underline; text-underline-offset: 4px; }
</style>

<script>
  import { movimientoPermitido } from '../motion/index';

  const zona = document.querySelector<HTMLElement>('[data-linterna]');
  if (zona && movimientoPermitido()) {
    // El círculo va hacia el cursor con un poco de inercia; si nadie lo mueve (o es un celu), pasea solo
    let x = zona.offsetWidth * 0.62, y = zona.offsetHeight * 0.46, destinoX = x, destinoY = y;
    let humano = 0, t = 0, visible = true, cuadro = 0;
    zona.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const r = zona.getBoundingClientRect();
      destinoX = e.clientX - r.left;
      destinoY = e.clientY - r.top;
      humano = performance.now();
    });
    const paso = () => {
      if (performance.now() - humano > 2200) {
        t += 0.006;
        destinoX = zona.offsetWidth * (0.5 + 0.3 * Math.cos(t));
        destinoY = zona.offsetHeight * (0.46 + 0.16 * Math.sin(t * 1.7));
      }
      x += (destinoX - x) * 0.12;
      y += (destinoY - y) * 0.12;
      zona.style.setProperty('--lx', `${x}px`);
      zona.style.setProperty('--ly', `${y}px`);
      cuadro = visible ? requestAnimationFrame(paso) : 0;
    };
    // Fuera de pantalla no se dibuja nada
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !cuadro) cuadro = requestAnimationFrame(paso);
    }).observe(zona);
  }
</script>
