---
import { loader } from '../content/guion';
---
<div class="loader" aria-hidden="true">
  <p class="loader-presenta mono">{loader.presenta}</p>
  <p class="loader-linea">
    <span class="loader-frase" style={`--n:${loader.frase.length}`}>{loader.frase}</span><span class="loader-cursor"></span>
  </p>
</div>

<script is:inline>
  try {
    if (sessionStorage.getItem('roda:visto')) document.documentElement.classList.add('ya-visto');
    sessionStorage.setItem('roda:visto', '1');
  } catch (e) {}
</script>

<style>
  .loader { display: none; }

  /* Solo con JS y movimiento permitido. Todo en CSS: se va solo antes de los 2,5 s aunque falle el JS. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js:not(.ya-visto)) .loader {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: grid;
      place-content: center;
      justify-items: start;
      gap: 1.25rem;
      padding: 1.25rem;
      background: var(--color-negro);
      color: var(--color-papel);
      /* Es un título, no una puerta: nunca intercepta toques */
      pointer-events: none;
      /* El telón sube y deja ver el papel */
      animation: loader-sale 0.65s cubic-bezier(0.7, 0, 0.2, 1) 1.7s forwards;
    }
  }

  .loader-presenta {
    color: var(--color-gris);
    opacity: 0;
    animation: aparece 0.4s linear 0.05s forwards;
  }

  .loader-linea {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 4.4vw, 2.1rem);
  }
  /* Máquina de escribir: una letra por paso */
  .loader-frase {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    animation: escribe 1.05s steps(var(--n)) 0.3s forwards;
  }
  .loader-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 0.08em;
    background: var(--color-papel);
    animation: titila 0.5s steps(1) infinite;
  }

  @keyframes escribe { to { width: calc(var(--n) * 1ch); } }
  @keyframes titila { 50% { opacity: 0; } }
  @keyframes aparece { to { opacity: 1; } }
  @keyframes loader-sale { to { clip-path: inset(0 0 100% 0); visibility: hidden; } }
</style>
