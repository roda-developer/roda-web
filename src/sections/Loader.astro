---
import { loader } from '../content/guion';
const palabras = loader.frase.split(' ');
---
<div class="loader" aria-hidden="true">
  <p class="loader-frase">
    {palabras.map((p, i) => <span style={`--i:${i}`}>{p}&nbsp;</span>)}
  </p>
  <p class="loader-presenta">{loader.presenta}</p>
</div>

<script is:inline>
  try {
    if (sessionStorage.getItem('roda:visto')) document.documentElement.classList.add('ya-visto');
    sessionStorage.setItem('roda:visto', '1');
  } catch (e) {}
</script>

<style>
  .loader { display: none; }

  /* Solo con JS y movimiento permitido. Todo en CSS: se va solo a los 2.5 s aunque falle el JS. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js:not(.ya-visto)) .loader {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: grid;
      place-content: center;
      gap: 1.5rem;
      padding: 1.5rem;
      text-align: center;
      background: var(--color-sala);
      animation: loader-sale 1s var(--ease-cine) 2.1s forwards;
    }
  }

  .loader-frase {
    font-family: var(--font-titulo);
    font-style: italic;
    font-size: clamp(1.9rem, 8vw, 3.6rem);
    line-height: 1.05;
    color: var(--color-pantalla);
  }
  .loader-frase span {
    display: inline-block;
    opacity: 0;
    filter: blur(8px);
    animation: palabra 0.9s var(--ease-cine) forwards;
    animation-delay: calc(0.15s + var(--i) * 0.125s);
  }
  .loader-presenta {
    font-size: 0.7rem;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: var(--color-tungsteno);
    opacity: 0;
    animation: palabra 0.8s var(--ease-cine) 1.15s forwards;
  }

  @keyframes palabra { to { opacity: 1; filter: blur(0); } }
  @keyframes loader-sale { to { clip-path: inset(0 0 100% 0); visibility: hidden; } }
</style>
