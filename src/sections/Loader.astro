---
import { loader } from '../content/guion';
---
<div class="loader" aria-hidden="true">
  <p class="loader-presenta mono">{loader.presenta}</p>
  <p class="loader-linea">
    <span class="loader-frase" style={`--n:${loader.frase.length}`}>{loader.frase}</span><span class="loader-cursor"></span>
  </p>
</div>

<script is:inline>
  // El loader sale cada vez que alguien entra o recarga. No sale si viene de otra página de Roda
  // (por ejemplo, volviendo de un caso de estudio). 'roda:saltar-loader' lo usan los tests y las capturas.
  try {
    var nav = performance.getEntriesByType('navigation')[0];
    var recarga = nav && nav.type === 'reload';
    var deRoda = document.referrer && new URL(document.referrer).origin === location.origin;
    if ((deRoda && !recarga) || sessionStorage.getItem('roda:saltar-loader')) document.documentElement.classList.add('ya-visto');
  } catch (e) {}
  // Quien no quiere esperar, no espera: tocar, hacer clic, apretar una tecla o scrollear lo saltea.
  ['pointerdown', 'keydown', 'wheel', 'touchmove'].forEach(function (ev) {
    addEventListener(ev, function () { document.documentElement.classList.add('loader-salteado'); }, { once: true, passive: true });
  });
</script>

<style>
  .loader { display: none; }

  /* Solo con JS y movimiento permitido. Todo en CSS: se va solo a los 3 s aunque falle el JS. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js:not(.ya-visto)) .loader {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: grid;
      place-content: center;
      justify-items: start;
      gap: 1.25rem;
      padding: 1.25rem;
      background: var(--color-negro);
      color: var(--color-papel);
      /* Es un título, no una puerta: nunca intercepta toques */
      pointer-events: none;
      /* El telón sube y deja ver el papel */
      animation: loader-sale 0.6s cubic-bezier(0.7, 0, 0.2, 1) 2.2s forwards;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js.loader-salteado:not(.ya-visto)) .loader { animation: loader-sale 0.45s cubic-bezier(0.7, 0, 0.2, 1) forwards; }
  }

  .loader-presenta {
    color: var(--color-gris);
    opacity: 0;
    animation: aparece 0.4s linear 0.05s forwards;
  }

  .loader-linea {
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 4.4vw, 2.1rem);
  }
  /* Máquina de escribir: una letra por paso */
  .loader-frase {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    animation: escribe 1.3s steps(var(--n)) 0.3s forwards;
  }
  .loader-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 0.08em;
    background: var(--color-papel);
    animation: titila 0.5s steps(1) infinite;
  }

  @keyframes escribe { to { width: calc(var(--n) * 1ch); } }
  @keyframes titila { 50% { opacity: 0; } }
  @keyframes aparece { to { opacity: 1; } }
  @keyframes loader-sale { to { clip-path: inset(0 0 100% 0); visibility: hidden; } }
</style>
