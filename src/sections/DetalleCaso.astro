---
/**
 * El estudio de caso, después del hero: texto, pantallas, celulares y detalles de cerca, sobre papel.
 * Todo sale de una sola grilla: mismos márgenes, misma separación entre piezas y entre bloques.
 * Las imágenes no se recortan: las cajas tienen la proporción de cada pieza.
 */
import { Image } from 'astro:assets';
import type { Proyecto } from '../content/proyectos';
import type { Detalle } from '../content/detalle';
import { rellenar, textos } from '../i18n';

interface Props {
  p: Proyecto;
  detalle: Detalle;
}
const { p, detalle } = Astro.props;
const { proyectosPagina: t } = textos(Astro.currentLocale);
const frase = p.testimonios?.[0];
---
<div class="estudio">
  <section class="texto-bloque">
    <h2 class="etiqueta font-titulo" data-revelar>{t.secciones.cliente}</h2>
    <div class="texto-cuerpo" data-revelar="2"><p>{p.cliente}</p></div>
  </section>
  <section class="texto-bloque">
    <h2 class="etiqueta font-titulo" data-revelar>{t.secciones.desafio}</h2>
    <div class="texto-cuerpo" data-revelar="2"><p>{p.desafio}</p></div>
  </section>

  <Image src={detalle.pantallas[0]} alt={rellenar(t.pantallaDe, { titulo: p.titulo, n: 2 })} widths={[800, 1400, 2000, 2400]} sizes="100vw" quality={88} loading="lazy" class="pieza" data-revelar />

  <div class="celulares" data-revelar>
    {detalle.celulares.map((c, i) => (
      <Image src={c} alt={i === 0 ? rellenar(t.celularDe, { titulo: p.titulo }) : ''} widths={[390, 780]} sizes="(min-width: 768px) 28vw, 40vw" quality={88} loading="lazy" class:list={['celular', { 'solo-compu': i === 2 }]} />
    ))}
  </div>

  <section class="texto-bloque">
    <h2 class="etiqueta font-titulo" data-revelar>{t.secciones.solucion}</h2>
    <div class="texto-cuerpo" data-revelar="2">{p.solucion.map((s) => <p>{s}</p>)}</div>
  </section>

  <Image src={detalle.pantallas[1]} alt={rellenar(t.pantallaDe, { titulo: p.titulo, n: 3 })} widths={[800, 1400, 2000, 2400]} sizes="100vw" quality={88} loading="lazy" class="pieza" data-revelar />

  <section class="cerca" aria-labelledby="cerca-titulo">
    <h2 id="cerca-titulo" class="etiqueta font-titulo" data-revelar>{t.secciones.deCerca}</h2>
    <figure class="cerca-ancha" data-revelar>
      <Image src={detalle.ancha} alt="" widths={[800, 1400, 2400]} sizes="100vw" quality={88} loading="lazy" class="pieza" />
    </figure>
    {detalle.par.map((pz) => {
      const texto = pz.destacado === undefined ? undefined : p.destacados[pz.destacado];
      return (
        <figure data-revelar>
          {pz.tipo === 'foto'
            ? <Image src={pz.src} alt="" widths={[640, 1000, 1600]} sizes="(min-width: 768px) 50vw, 100vw" quality={88} loading="lazy" class="pieza" />
            : <video src={pz.src} poster={pz.poster} muted loop playsinline preload="none" width="1120" height="700" aria-hidden="true" class="pieza" data-cerca-video></video>}
          {texto && <figcaption>{texto}</figcaption>}
        </figure>
      );
    })}
  </section>

  {frase && (
    <section class="frase" data-revelar>
      <blockquote class="frase-cita font-titulo">“{frase.destacado ?? frase.texto}”</blockquote>
      <p>{frase.nombre}, {p.titulo}</p>
    </section>
  )}
</div>

<style>
  /* Una sola regla para todo: los mismos márgenes y dos separaciones (entre piezas y entre bloques) */
  .estudio { --margen: 1.25rem; --pieza: 1rem; --bloque: clamp(4rem, 10svh, 7rem); display: grid; gap: var(--bloque); padding: var(--bloque) var(--margen) clamp(5rem, 12svh, 8rem); }
  @media (min-width: 768px) { .estudio { --margen: clamp(1.5rem, 3.5vw, 3rem); --pieza: 1.5rem; } }
  .estudio :global(.pieza) { display: block; width: 100%; height: auto; }

  /* Título a la izquierda, texto a la derecha, siempre en las mismas columnas */
  .texto-bloque { display: grid; gap: 1rem; }
  .etiqueta { font-size: clamp(2.4rem, 4vw, 3.5rem); line-height: 0.92; }
  .texto-cuerpo { display: grid; gap: 1rem; max-width: 40rem; }
  .texto-cuerpo p { font-size: clamp(1.25rem, 1.9vw, 1.75rem); line-height: 1.32; font-weight: 500; letter-spacing: -0.01em; }
  @media (min-width: 900px) {
    .texto-bloque { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--pieza); align-items: start; }
    .etiqueta { grid-column: 1 / span 5; }
    .texto-cuerpo { grid-column: 6 / span 7; }
    /* Cliente y desafío van juntos: menos aire entre ellos */
    .texto-bloque + .texto-bloque { margin-top: calc(var(--bloque) * -0.45); }
  }

  /* Los celulares: sobre un paso de tono, todos iguales */
  .celulares { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--pieza); padding: clamp(1.5rem, 5vw, 5rem); background: #e8e6e0; }
  .celulares :global(.celular) { display: block; width: 100%; height: auto; border: 5px solid var(--color-tinta); border-radius: 1.5rem; }
  .celulares :global(.solo-compu) { display: none; }
  @media (min-width: 768px) {
    .celulares { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 5vw, 5rem); }
    .celulares :global(.solo-compu) { display: block; }
  }

  /* De cerca: una franja a lo ancho y un par, con el texto siempre abajo y del mismo tamaño */
  .cerca { display: grid; gap: var(--pieza); }
  .cerca .etiqueta { margin-bottom: 1rem; }
  .cerca figure { margin: 0; }
  .cerca figcaption { max-width: 38ch; margin-top: 0.75rem; margin-bottom: 1.5rem; font-size: 1.0625rem; line-height: 1.4; }
  .cerca-ancha { margin-bottom: 0.25rem !important; }
  @media (min-width: 768px) {
    .cerca { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cerca .etiqueta, .cerca-ancha { grid-column: 1 / -1; }
  }

  /* La frase del cliente, una sola */
  .frase { display: grid; gap: 1.25rem; }
  .frase-cita { margin: 0; max-width: 18ch; font-size: clamp(2.6rem, 6.5vw, 6rem); line-height: 0.95; }
  .frase p { font-size: 1.0625rem; }
</style>

<script>
  import { movimientoPermitido } from '../motion/index';

  // El video corre solo mientras se ve. Sin movimiento, queda su primer cuadro
  document.querySelectorAll<HTMLVideoElement>('[data-cerca-video]').forEach((video) => {
    if (!movimientoPermitido()) return;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) void video.play().catch(() => {});
      else video.pause();
    }, { threshold: 0.2 }).observe(video);
  });
</script>
