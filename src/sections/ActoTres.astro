---
import { actoTres } from '../content/guion';
import CartaActo from '../components/CartaActo.astro';
---
<section id="acto-tres" aria-label="Acto tres: cómo filmamos tu web">
  <CartaActo texto={actoTres.rotulo} />
  <p class="tono-aviso -mt-[30svh] mb-[20svh] px-5 text-center text-sm text-niebla italic" aria-live="polite">
    <span class="solo-grita">Contado en tu tono: a los gritos.</span>
    <span class="solo-susurra">Contado en tu tono: en voz baja.</span>
  </p>

  <!-- Mobile: una lista vertical. Desktop: la hoja de rodaje corre de costado. -->
  <div class="rodaje relative" data-rodaje>
    <div class="rodaje-marco">
      <ol class="rodaje-pista" data-pista>
        {actoTres.pasos.map((paso, i) => (
          <li class="paso">
            <p class="paso-numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="paso-nombre adapta-titulo">{paso.nombre}</h3>
            <p class="paso-texto">{paso.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .paso {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    min-height: 72svh;
    padding: 4rem 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-pantalla) 12%, transparent);
  }
  .paso-numero {
    font-family: var(--font-titulo);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--acento);
  }
  .paso-nombre {
    font-family: var(--font-titulo);
    font-size: clamp(3.4rem, 17vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .paso-texto {
    max-width: 30ch;
    font-size: 1.2rem;
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-pantalla) 72%, transparent);
  }

  /* Desktop con movimiento: pista horizontal fija mientras se scrollea */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .rodaje { height: 420svh; }
    .rodaje-marco { position: sticky; top: 0; height: 100svh; overflow: hidden; display: flex; align-items: center; }
    .rodaje-pista { display: flex; gap: 0; padding-left: 8vw; will-change: transform; }
    .paso {
      flex: none;
      width: 62vw;
      min-height: 0;
      padding: 0 5vw 0 3rem;
      border-top: 0;
      border-left: 1px solid color-mix(in oklab, var(--color-pantalla) 14%, transparent);
    }
    .paso-texto { font-size: 1.45rem; }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const rodaje = document.querySelector<HTMLElement>('[data-rodaje]');
  const pista = document.querySelector<HTMLElement>('[data-pista]');
  if (rodaje && pista && movimientoPermitido()) {
    gsap.matchMedia().add('(min-width: 1024px)', () => {
      gsap.to(pista, {
        x: () => -(pista.scrollWidth - innerWidth * 0.92),
        ease: 'none',
        scrollTrigger: { trigger: rodaje, start: 'top top', end: 'bottom bottom', scrub: 0.6, invalidateOnRefresh: true },
      });
    });
    gsap.utils.toArray<HTMLElement>('.paso-nombre').forEach((el) => {
      gsap.from(el, {
        opacity: 0,
        y: 40,
        filter: 'blur(10px)',
        duration: 1.2,
        ease: 'expo.out',
        scrollTrigger: { trigger: el, start: 'top 90%', horizontal: false, once: true },
      });
    });
  }
</script>
