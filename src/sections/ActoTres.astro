---
import { textos } from '../i18n';
import Rotulo from '../components/Rotulo.astro';
const { actoTres } = textos(Astro.currentLocale);
const { obra, pasos } = actoTres;
const total = String(pasos.length).padStart(2, '0');
---
<section id="acto-tres" aria-labelledby="acto-tres-titulo">
  <!-- Una web que se arma sola mientras bajás: hoja en blanco, boceto, diseño, publicada, y llegan mensajes -->
  <div class="obra relative" data-obra>
    <div class="obra-marco">
      <header class="obra-cabeza px-5 md:px-12">
        <Rotulo rotulo={actoTres.rotulo} />
        <h2 id="acto-tres-titulo" class="mt-2.5 max-w-[20ch] font-titulo text-[clamp(1.55rem,min(7vw,4svh),2.4rem)] md:mt-6 md:text-[clamp(1.7rem,min(7.5vw,4.6svh),2.6rem)] lg:text-[clamp(2rem,min(4.4vw,6.5svh),4rem)] leading-[0.95] tracking-[-0.045em]">
          {actoTres.titulo}
        </h2>
        <div class="progreso mt-2.5 md:mt-4" aria-hidden="true"><span data-progreso></span></div>
      </header>

      <div class="obra-escena px-5 md:px-12">
        <!-- El paso de ahora. Sin movimiento, se leen todos en lista. -->
        <ol class="leyendas">
          {pasos.map((p, i) => (
            <li class="leyenda">
              <p class="mono text-gris">
                <span aria-hidden="true">({String(i + 1).padStart(2, '0')} / {total})</span>
                <span class="sr-only">Paso {i + 1} de {pasos.length}:</span>
                <span class="ml-2 normal-case italic">{p.cine}</span>
              </p>
              <h3 class="leyenda-nombre">{p.nombre}</h3>
              <p class="leyenda-texto">{p.texto}</p>
            </li>
          ))}
        </ol>

        <div class="mesa-obra" aria-hidden="true">
          <div class="navegador">
            <div class="barra">
              <span class="puntos"><i></i><i></i><i></i></span>
              <span class="url"><span class="url-texto" style={`--n:${obra.url.length}`}>{obra.url}</span></span>
              <span class="en-linea mono">● {obra.enLinea}</span>
            </div>
            <div class="lienzo">
              <!-- 1. Las notas de la primera charla -->
              <ul class="capa notas mono">
                {obra.notas.map((n) => <li>{n}</li>)}
              </ul>
              <!-- 2. El boceto: cajitas punteadas -->
              <div class="capa boceto">
                <span class="p-nav"></span><span class="p-img"></span><span class="p-tit"></span><span class="p-tit-2"></span><span class="p-btn"></span>
              </div>
              <!-- 3. El diseño de verdad, en las mismas posiciones -->
              <div class="capa diseno">
                <span class="p-nav"><b>{obra.marca}</b><span>≡</span></span>
                <span class="p-img"></span>
                <span class="p-tit">{obra.titular}</span>
                <span class="p-tit-2">{obra.bajada}</span>
                <span class="p-btn">{obra.boton} →</span>
              </div>
            </div>
          </div>

          <!-- 4. Publicada: también en el celular -->
          <div class="celu">
            <div class="celu-pantalla">
              <span class="c-nav"><b>{obra.marca}</b><span>≡</span></span>
              <span class="c-img"></span>
              <span class="c-tit">{obra.titular}</span>
              <span class="c-baj">{obra.bajada}</span>
              <span class="c-btn">{obra.boton} →</span>
            </div>
          </div>

          <!-- 5. Y llegan los mensajes -->
          <div class="aviso">
            <span class="aviso-icono">✉</span>
            <span><b class="block">{obra.mensaje[0]}</b>{obra.mensaje[1]}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #acto-tres {
    margin-bottom: clamp(3rem, 7svh, 5.5rem);
  }
  @media (min-width: 768px) {
    #acto-tres {
      margin-bottom: 0;
    }
  }

  .obra-cabeza { padding-top: clamp(3.5rem, 7svh, 5.5rem); }
  .obra-escena { display: grid; gap: 1.5rem; padding-top: 1.25rem; padding-bottom: 3.5rem; }
  @media (min-width: 1024px) {
    .obra-escena { grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr); gap: clamp(1.5rem, 3.5vw, 4rem); align-items: center; }
  }

  .progreso { height: 2px; background: color-mix(in oklab, var(--color-tinta) 12%, transparent); }
  .progreso span { display: block; height: 100%; background: var(--color-tinta); transform-origin: left; transform: scaleX(0); }

  .leyendas { display: grid; gap: 1.75rem; }
  .leyenda { display: grid; gap: 0.5rem; }
  .leyenda-nombre { font-family: var(--font-titulo); font-size: clamp(1.35rem, min(6.5vw, 3.6svh), 3.2rem); line-height: 1; letter-spacing: -0.04em; }
  .leyenda-texto { max-width: 34ch; font-size: clamp(0.95rem, 2.5vw, 1.2rem); color: color-mix(in oklab, var(--color-tinta) 68%, transparent); }

  /* ── La mesa: el navegador, el celular y el aviso ───────────────── */
  /* El tamaño sale del alto de la pantalla: en una notebook baja o un celular chico, la web que se arma entra entera */
  .mesa-obra {
    position: relative;
    width: 100%;
    max-width: min(20rem, 85vw);
    min-width: min(15rem, 100%);
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .mesa-obra {
      max-width: min(34rem, min(100%, calc((100svh - 17rem) * 1.25)));
      min-width: min(20rem, 100%);
    }
  }

  .navegador {
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-tinta) 18%, transparent);
    border-radius: 0.6rem;
    background: #fff;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.35);
  }
  .barra {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.7rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-tinta) 10%, transparent);
    background: color-mix(in oklab, var(--color-tinta) 4%, #fff);
  }
  .puntos { display: flex; gap: 0.3rem; }
  .puntos i { width: 0.5rem; height: 0.5rem; border-radius: 99px; background: color-mix(in oklab, var(--color-tinta) 22%, transparent); }
  .url { flex: 1; min-height: 1.3rem; padding: 0.15rem 0.6rem; border-radius: 99px; background: #fff; font-family: var(--font-mono); font-size: 0.7rem; }
  .url-texto { display: inline-block; overflow: hidden; white-space: nowrap; vertical-align: bottom; }
  .en-linea { font-size: 0.6rem; color: #0a8f4f; white-space: nowrap; }

  /* El lienzo mide su propio ancho: todo lo de adentro escala con el mockup, no con la pantalla */
  .lienzo { position: relative; aspect-ratio: 1; container-type: inline-size; }
  @media (min-width: 768px) { .lienzo { aspect-ratio: 16 / 10; } }
  .capa { position: absolute; inset: 0; }

  .notas { display: grid; align-content: center; gap: 0.6rem; padding: 1.5rem; font-size: 0.75rem; color: var(--color-tinta); }
  .notas li::before { content: '— '; color: var(--color-gris); }
  @media (min-width: 768px) { .notas { font-size: 1.05rem; gap: 0.9rem; padding: 3rem; } }

  /* Las mismas posiciones para el boceto y el diseño. Celular: en columna. Computadora: imagen a la izquierda. */
  .p-nav, .p-img, .p-tit, .p-tit-2, .p-btn { position: absolute; }
  .p-nav { left: 6%; right: 6%; top: 4%; height: 7%; }
  .p-img { left: 6%; right: 6%; top: 16%; height: 36%; }
  .p-tit { left: 6%; right: 6%; top: 57%; height: 15%; }
  .p-tit-2 { left: 6%; right: 30%; top: 74%; height: 5%; }
  .p-btn { left: 6%; width: 46%; top: 84%; height: 9%; }
  @media (min-width: 768px) {
    .p-nav { top: 5%; height: 8%; }
    .p-img { right: auto; width: 42%; top: 20%; height: 66%; }
    .p-tit { left: 54%; top: 24%; height: 15%; }
    .p-tit-2 { left: 54%; right: 14%; top: 44%; height: 7%; }
    .p-btn { left: 54%; width: 26%; top: 62%; height: 11%; }
  }

  .boceto > span { border: 1.5px dashed color-mix(in oklab, var(--color-tinta) 35%, transparent); border-radius: 0.3rem; }

  .diseno .p-nav { display: flex; align-items: center; justify-content: space-between; font-size: max(0.6rem, 3.6cqi); border-bottom: 1px solid color-mix(in oklab, var(--color-tinta) 12%, transparent); }
  .diseno .p-img {
    background:
      radial-gradient(circle at 70% 30%, color-mix(in oklab, var(--color-papel) 30%, transparent) 0 14%, transparent 15%),
      linear-gradient(160deg, #3a3a3a, #0f0f0f);
    border-radius: 0.2rem;
  }
  .diseno .p-tit { font-family: var(--font-titulo); font-weight: 600; font-size: 7.5cqi; line-height: 1; letter-spacing: -0.045em; color: var(--color-tinta); }
  .diseno .p-btn { display: grid; place-items: center; border-radius: 99px; background: var(--color-tinta); color: var(--color-papel); font-size: max(0.55rem, 3.4cqi); font-weight: 500; }

  .diseno .p-tit-2 { display: flex; align-items: center; font-size: max(0.6rem, 3.6cqi); color: color-mix(in oklab, var(--color-tinta) 60%, transparent); }
  @media (min-width: 768px) {
    .diseno .p-tit-2 { font-size: clamp(0.65rem, 1.8cqi, 0.95rem); }
    .diseno .p-tit { font-size: clamp(0.95rem, 3.8cqi, 1.75rem); }
    .diseno .p-nav { font-size: clamp(0.65rem, 1.8cqi, 0.95rem); }
    .diseno .p-btn { font-size: clamp(0.6rem, 1.7cqi, 0.9rem); }
  }

  /* La web que se arma tiene color: es la que vamos a hacerte */
  .diseno .p-img,
  .c-img { background: radial-gradient(circle at 75% 25%, var(--color-tc-rosa) 0 22%, transparent 23%), var(--color-tc-azul) !important; }
  .diseno .p-btn,
  .c-btn { background: var(--color-tc-rojo) !important; }

  /* El celular: aparece al publicarla, encima de la esquina del navegador */
  .celu {
    position: absolute;
    right: -0.75rem;
    bottom: -1.6rem;
    width: 41%;
    min-width: 7.75rem;
    max-width: 9.25rem;
    padding: 0.35rem;
    border-radius: 1.15rem;
    background: var(--color-tinta);
    box-shadow: 0 20px 40px -15px rgb(0 0 0 / 0.45);
  }
  @media (min-width: 768px) {
    .celu {
      width: 22%;
      min-width: 0;
      max-width: none;
      right: -1.25rem;
      bottom: -0.75rem;
      box-shadow: 0 30px 50px -20px rgb(0 0 0 / 0.5);
    }
  }
  @media (min-width: 1280px) and (min-height: 750px) {
    .celu {
      width: 22%;
      right: -2rem;
      bottom: -1.75rem;
    }
  }
  .celu-pantalla {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 9 / 19;
    overflow: hidden;
    padding: 0.55rem;
    border-radius: 0.85rem;
    background: #fff;
    color: var(--color-tinta);
  }
  .c-nav { display: flex; justify-content: space-between; font-size: 0.55rem; line-height: 1; }
  .c-img { height: 34%; min-height: 2.2rem; border-radius: 0.2rem; background: linear-gradient(160deg, #3a3a3a, #0f0f0f); }
  .c-tit { font-family: var(--font-titulo); font-weight: 600; font-size: 0.72rem; line-height: 1.1; letter-spacing: -0.04em; }
  .c-baj { font-size: 0.48rem; line-height: 1.2; color: color-mix(in oklab, var(--color-tinta) 60%, transparent); }
  .c-btn { justify-self: start; align-self: flex-start; padding: 0.3em 0.7em; border-radius: 99px; background: var(--color-tinta); color: var(--color-papel); font-size: 0.48rem; line-height: 1; }

  .aviso {
    position: absolute;
    left: -0.5rem;
    top: 12%;
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    max-width: 15.5rem;
    padding: 0.7rem 0.9rem;
    border-radius: 0.9rem;
    background: color-mix(in oklab, var(--color-papel) 85%, #fff);
    color: var(--color-tinta);
    font-size: 0.85rem;
    line-height: 1.3;
    box-shadow: 0 20px 40px -15px rgb(0 0 0 / 0.4);
  }
  @media (min-width: 768px) { .aviso { left: -1.25rem; top: 8%; font-size: 0.9rem; max-width: 17rem; } }
  @media (min-width: 1280px) and (min-height: 720px) { .aviso { left: -2.5rem; top: 12%; font-size: 0.95rem; max-width: 19rem; } }
  .aviso-icono { display: grid; place-items: center; flex: none; width: 1.8rem; height: 1.8rem; border-radius: 99px; background: #25d366; color: #fff; font-size: 0.85rem; }

  /* Sin movimiento (o sin JS): se ve la web terminada y los pasos en lista. Las notas y el boceto no hacen falta. */
  .notas, .boceto { visibility: hidden; }

  /* Con movimiento: todo fijo en pantalla y la web se arma con el scroll */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .obra { height: 260svh; }
    :global(.js) .obra-marco { position: sticky; top: 0; height: 100svh; overflow: hidden; display: flex; flex-direction: column; }
    :global(.js) .obra-cabeza { padding-top: clamp(3.25rem, 5.5svh, 4.25rem); }
    :global(.js) .obra-escena {
      flex: 1;
      align-content: center;
      padding-top: clamp(0.35rem, 1svh, 0.75rem);
      padding-bottom: clamp(2rem, 5svh, 3.5rem);
      gap: clamp(0.5rem, 1.5svh, 1rem);
    }
    :global(.js) .leyendas { display: grid; }
    :global(.js) .leyenda { grid-area: 1 / 1; }
    :global(.js) .notas, :global(.js) .boceto { visibility: visible; }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .obra { height: 260svh; }
    :global(.js) .obra-cabeza { padding-top: clamp(4rem, 7svh, 5.5rem); }
    :global(.js) .obra-escena { padding-top: 1.25rem; padding-bottom: 3.5rem; gap: clamp(1.5rem, 3.5vw, 4rem); }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const obra = document.querySelector<HTMLElement>('[data-obra]');
  if (obra && movimientoPermitido()) {
    const q = gsap.utils.selector(obra);
    const leyendas = q('.leyenda');
    const url = q('.url-texto')[0];

    // Estado inicial: hoja en blanco, sin dirección, nada publicado
    gsap.set(leyendas.slice(1), { autoAlpha: 0, y: 24 });
    gsap.set(q('.notas li'), { autoAlpha: 0, x: -10 });
    gsap.set(q('.boceto > span'), { autoAlpha: 0, scale: 0.9 });
    gsap.set(q('.diseno > span'), { autoAlpha: 0 });
    gsap.set(url, { width: 0 });
    gsap.set(q('.en-linea'), { autoAlpha: 0 });
    gsap.set(q('.celu'), { autoAlpha: 0, y: 80, rotate: 8 });
    gsap.set(q('.aviso'), { autoAlpha: 0, y: -20, scale: 0.9 });

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: obra, start: 'top top', end: 'bottom bottom', scrub: 0.5 },
    });

    const pasoA = (n: number, en: number) =>
      tl.to(leyendas[n - 1], { autoAlpha: 0, y: -24, duration: 0.15 }, en).to(leyendas[n], { autoAlpha: 1, y: 0, duration: 0.2 }, en + 0.1);

    // 1. Te escuchamos: se anotan las ideas
    tl.to(q('.notas li'), { autoAlpha: 1, x: 0, stagger: 0.25, duration: 0.25 }, 0.1);
    // 2. Boceto
    pasoA(1, 1);
    tl.to(q('.notas'), { autoAlpha: 0, duration: 0.2 }, 1)
      .to(q('.boceto > span'), { autoAlpha: 1, scale: 1, stagger: 0.12, duration: 0.25, ease: 'back.out(1.6)' }, 1.15);
    // 3. Se construye: el diseño aparece encima del boceto, pieza por pieza
    pasoA(2, 2);
    tl.to(q('.diseno > span'), { autoAlpha: 1, stagger: 0.15, duration: 0.25 }, 2.1)
      .to(q('.boceto'), { autoAlpha: 0, duration: 0.3 }, 2.6);
    // 4. Se publica: la dirección se escribe, está en línea y cae en el celular
    pasoA(3, 3);
    tl.to(url, { width: () => url.scrollWidth, duration: 0.4, ease: `steps(${url.textContent!.length})` }, 3.05)
      .to(q('.en-linea'), { autoAlpha: 1, duration: 0.1 }, 3.45)
      .to(q('.celu'), { autoAlpha: 1, y: 0, rotate: 0, duration: 0.35, ease: 'back.out(1.4)' }, 3.5);
    // 5. Y llegan los mensajes
    pasoA(4, 4);
    tl.to(q('.aviso'), { autoAlpha: 1, y: 0, scale: 1, duration: 0.25, ease: 'back.out(2)' }, 4.2)
      .to({}, { duration: 1.5 });

    const progreso = q('[data-progreso]')[0];
    if (progreso) gsap.to(progreso, { scaleX: 1, ease: 'none', scrollTrigger: { trigger: obra, start: 'top top', end: 'bottom bottom', scrub: true } });
  }
</script>
