---
import { actoTres } from '../content/guion';
import Rotulo from '../components/Rotulo.astro';
---
<section id="acto-tres" class="adapta-fondo" aria-label="Acto tres: cómo trabajamos">
  <div class="px-5 pt-24 md:px-12 md:pt-32">
    <Rotulo rotulo={actoTres.rotulo} />
    <p class="mono mt-3 text-gris" aria-live="polite">
      <span class="solo-grita">(Contado en tu tono: a los gritos)</span>
      <span class="solo-susurra">(Contado en tu tono: en voz baja)</span>
    </p>
  </div>

  <!-- La hoja de rodaje corre de costado mientras se baja -->
  <div class="rodaje relative" data-rodaje>
    <div class="rodaje-marco">
      <ol class="rodaje-pista" data-pista>
        {actoTres.pasos.map((paso, i) => (
          <li class="paso">
            <p class="mono text-gris" aria-hidden="true">({String(i + 1).padStart(2, '0')} / {String(actoTres.pasos.length).padStart(2, '0')})</p>
            <h3 class="paso-nombre adapta-titulo">{paso.nombre}</h3>
            <p class="paso-texto">{paso.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .paso {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding: 3.5rem 1.25rem;
    border-top: 1px solid color-mix(in oklab, var(--color-tinta) 15%, transparent);
  }
  .paso-nombre {
    font-family: var(--font-titulo);
    font-size: clamp(2.6rem, 11vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .paso-texto {
    max-width: 30ch;
    font-size: 1.15rem;
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-tinta) 72%, transparent);
  }

  /* Con movimiento: pista horizontal fija mientras se scrollea, en celular y en computadora */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .rodaje { height: 320svh; }
    :global(.js) .rodaje-marco { position: sticky; top: 0; height: 100svh; overflow: hidden; display: flex; align-items: center; }
    :global(.js) .rodaje-pista { display: flex; padding-left: 1.25rem; will-change: transform; }
    :global(.js) .paso {
      flex: none;
      width: 82vw;
      padding: 0 8vw 0 1.25rem;
      border-top: 0;
      border-left: 1px solid color-mix(in oklab, var(--color-tinta) 15%, transparent);
    }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .rodaje { height: 240svh; }
    :global(.js) .rodaje-pista { padding-left: 3rem; }
    :global(.js) .paso { width: 42vw; padding: 0 4vw 0 2rem; }
    /* Que "Storyboard" entre en su columna sin pisar al vecino */
    .paso-nombre { font-size: min(8.5rem, 5.4vw); }
    .paso-texto { font-size: 1.35rem; }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const rodaje = document.querySelector<HTMLElement>('[data-rodaje]');
  const pista = document.querySelector<HTMLElement>('[data-pista]');
  if (rodaje && pista && movimientoPermitido()) {
    gsap.to(pista, {
      x: () => -(pista.scrollWidth - innerWidth * 0.94),
      ease: 'none',
      scrollTrigger: { trigger: rodaje, start: 'top top', end: 'bottom bottom', scrub: 0.6, invalidateOnRefresh: true },
    });
  }
</script>
