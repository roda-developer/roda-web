---
/**
 * Lo que dicen los clientes, en la home: dos filas que corren en sentidos opuestos (idea de "Testimonials Marquee",
 * 21st.dev). En vez de la foto de la persona, cada tarjeta lleva la web que le hicimos. Los textos van completos y textuales.
 * Se frena al pasar el mouse o al enfocar una tarjeta. Sin movimiento: las filas quedan quietas y se recorren de costado.
 */
import { Image } from 'astro:assets';
import { capturas } from '../content/capturas';
import { testimoniosEn, type TestimonioDe } from '../content/proyectos';
import { idiomaDe, rellenar, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { laCritica, ui } = textos(idioma);
const todos = testimoniosEn(idioma);
// La segunda fila arranca por la mitad, así las dos nunca muestran la misma tarjeta a la misma altura
const mitad = Math.ceil(todos.length / 2);
const filas: TestimonioDe[][] = [todos, [...todos.slice(mitad), ...todos.slice(0, mitad)]];
---
{todos.length > 0 && (
  <section class="testimonios" aria-labelledby="testimonios-titulo">
    <h2 id="testimonios-titulo" class="titulo font-titulo" data-revelar>{laCritica.completo}</h2>
    <div class="filas">
      {filas.map((fila, f) => (
        <div class:list={['fila', { vuelta: f === 1 }]} data-fila>
          {/* La lista va dos veces para que el loop no tenga corte; la copia no se lee en voz alta */}
          {[0, 1].map((copia) => (
            <ul class="tira" aria-hidden={copia === 1 || f === 1 ? 'true' : undefined}>
              {fila.map((t) => (
                <li class="tarjeta">
                  <figure>
                    <blockquote class="cita">“{t.texto}”</blockquote>
                    <figcaption class="firma">
                      <Image src={capturas(t.slug).portada} alt={rellenar(ui.webDe, { marca: t.marca })} widths={[160, 240]} sizes="80px" quality={80} loading="lazy" class="web" />
                      <span><b class="font-titulo">{t.nombre}</b><span class="rol">{t.rol}{t.traducido && ` · ${ui.traducido}`}</span></span>
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          ))}
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .testimonios { padding-top: clamp(6rem, 16svh, 11rem); overflow: hidden; }
  .titulo { padding-inline: 1.25rem; font-size: clamp(2.8rem, 7vw, 6rem); line-height: 0.9; max-width: 16ch; }
  @media (min-width: 768px) { .titulo { padding-inline: clamp(1.5rem, 3.5vw, 3rem); } }
  .filas {
    display: grid; gap: 1rem; margin-top: clamp(2rem, 5svh, 3.5rem);
    /* Los bordes se desvanecen: las tarjetas entran y salen sin corte */
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }
  .fila { display: flex; width: max-content; }
  .tira { display: flex; gap: 1rem; padding-right: 1rem; }
  .tarjeta { width: min(80vw, 25rem); }
  .tarjeta figure { height: 100%; display: grid; grid-template-rows: 1fr auto; gap: 1.5rem; padding: 1.5rem; border-radius: 6px; background: #e8e6df; }
  .cita { font-size: 1.0625rem; line-height: 1.5; text-wrap: pretty; }
  .firma { display: flex; align-items: center; gap: 0.9rem; }
  .web { width: 4.5rem; height: 3rem; border-radius: 4px; object-fit: cover; object-position: top; flex: none; }
  .firma b { display: block; font-size: 1.5rem; line-height: 1; text-transform: uppercase; }
  .rol { display: block; margin-top: 0.2rem; font-size: 0.95rem; color: var(--color-gris); }

  @media (prefers-reduced-motion: no-preference) {
    .fila { animation: correr 70s linear infinite; }
    .fila.vuelta { animation-direction: reverse; animation-duration: 80s; }
    .filas:hover .fila, .filas:focus-within .fila { animation-play-state: paused; }
  }
  @keyframes correr { to { transform: translateX(-50%); } }
  /* Sin movimiento: cada fila se recorre de costado y no hay copia */
  @media (prefers-reduced-motion: reduce) {
    .filas { mask-image: none; padding-inline: 1.25rem; }
    .fila { width: auto; overflow-x: auto; scroll-snap-type: x mandatory; }
    .fila.vuelta, .tira[aria-hidden] { display: none; }
    .tarjeta { scroll-snap-align: start; }
  }
</style>
