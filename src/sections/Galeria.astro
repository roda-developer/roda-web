---
/**
 * Trabajos en la home: los afiches de /proyectos en una fila al estilo coverflow, pero al revés (idea de "Coverflow Carousel", 21st.dev).
 * La del centro de frente; las de los costados abren su borde de afuera hacia vos. Quieta, se ven todas nítidas:
 * los píxeles (el mismo lenguaje del video de Estudio) aparecen solo mientras se mueve.
 * Pasa sola, se arrastra, responde a las flechas y el nombre de abajo acompaña.
 * Al tocar la del centro, su afiche viaja al afiche del caso (View Transitions).
 */
import { Image } from 'astro:assets';
import { capturas } from '../content/capturas';
import RECORTES from '../content/recortes.json';
// Cada trabajo en píxeles (scripts/pixelar-afiches.mjs) y, encima, la foto de la que salen: el afiche o, si no tiene, la captura de celu
const pixeles = import.meta.glob<{ default: ImageMetadata }>('../assets/pixeles/*.png', { eager: true });
const pixelesMockups = import.meta.glob<{ default: ImageMetadata }>('../assets/pixeles-mockups/*.png', { eager: true });
const pixelDe = (slug: string) => pixelesMockups[`../assets/pixeles-mockups/${slug}.png`]?.default ?? pixeles[`../assets/pixeles/${slug}.png`]?.default;
// Sin afiche, la captura de celu se recorta desde arriba, o un poco más abajo si recortes.json lo dice (el mismo corte que sus píxeles)
const nitidaDe = (slug: string) => { const c = capturas(slug); if (c.mockup) return { src: c.mockup, arriba: false, bajar: 0 }; return c.afiche !== c.portada ? { src: c.afiche, arriba: false, bajar: 0 } : { src: c.mobile ?? c.portada, arriba: true, bajar: (RECORTES as Record<string, number>)[slug] ?? 0 }; };
import { ORDEN_GALERIA, proyectosEn } from '../content/proyectos';
import { nombreVt } from '../components/afiches/mapa';
import { idiomaDe, rellenar, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { inicio, proyectosPagina } = textos(idioma);
// Primero las que mejor se ven; las que no están en la lista (por ejemplo, cargadas desde el admin) van al final
const lista = [...proyectosEn(idioma)].filter((p) => pixelDe(p.slug)).sort((a, b) => {
  const pa = ORDEN_GALERIA.indexOf(a.slug), pb = ORDEN_GALERIA.indexOf(b.slug);
  return (pa < 0 ? 99 : pa) - (pb < 0 ? 99 : pb);
});
---
<section id="trabajos" class="galeria" aria-labelledby="galeria-titulo" data-galeria>
  <h2 id="galeria-titulo" class="titulo font-titulo" data-revelar>{inicio.trabajos.titulo}</h2>
  <div class="escenario" tabindex="0" aria-roledescription="carrusel" aria-label={inicio.trabajos.titulo}>
    <ul class="rack">
      {lista.map((p) => (
        <li class="tarjeta" data-slug={p.slug} data-nombre={p.titulo} data-genero={p.genero} data-vt={nombreVt(p.slug)}>
          <a href={ruta(idioma, 'proyectos', p.slug)} tabindex="-1" draggable="false">
            <Image src={pixelDe(p.slug)!} alt="" widths={[480, 900]} sizes="(min-width: 1024px) 20rem, 62vw" quality={90} format="png" loading="lazy" draggable="false" class="px" />
            <Image src={nitidaDe(p.slug).src} alt={rellenar(proyectosPagina.portadaDe, { titulo: p.titulo })} widths={[480, 900, 1200]} sizes="(min-width: 1024px) 20rem, 62vw" quality={84} loading="lazy" draggable="false" class:list={['nitida', { arriba: nitidaDe(p.slug).arriba }]} style={nitidaDe(p.slug).bajar ? `object-position: 50% ${nitidaDe(p.slug).bajar}%` : undefined} />
          </a>
        </li>
      ))}
    </ul>
    <p class="pie" aria-live="polite"><b class="font-titulo" data-pie-nombre></b><span data-pie-genero></span></p>
  </div>
  <p class="todos"><a href={ruta(idioma, 'proyectos')} class="ver-todos">{inicio.trabajos.verTodos}</a></p>
</section>

<style>
  .galeria { padding-top: clamp(3rem, 9svh, 6rem); }
  /* El título entero y centrado, arriba de la fila (nada lo tapa) */
  .titulo { text-align: center; font-size: clamp(4.5rem, 18vw, 12rem); line-height: 0.8; padding-inline: 1rem; }
  .todos { display: flex; justify-content: center; margin-top: 0.5rem; }
  .ver-todos { display: inline-flex; min-height: 2.75rem; align-items: center; font-size: 1.0625rem; text-decoration: underline; text-underline-offset: 4px; }
  /* Las tarjetas tienen la proporción de los mockups (así no se cortan); el escenario deja lugar abajo para el nombre */
  .escenario { --ancho: clamp(13rem, 21vw, 19rem); position: relative; height: calc(var(--ancho) * 1408 / 1136 + 8rem); margin-top: clamp(1.5rem, 4svh, 2.5rem); overflow: hidden; perspective: 1200px; cursor: grab; touch-action: pan-y; user-select: none; outline: none; }
  @media (max-width: 767px) { .escenario { --ancho: 62vw; } }
  .escenario:focus-visible { outline: 2px solid var(--color-tinta); outline-offset: -2px; }
  .rack { position: absolute; inset: 0; transform-style: preserve-3d; }
  .tarjeta { position: absolute; left: 50%; top: 1rem; width: var(--ancho); aspect-ratio: 1136 / 1408; margin-left: calc(var(--ancho) * -0.5); will-change: transform, opacity; }
  .tarjeta a { position: relative; display: block; width: 100%; height: 100%; background: var(--color-papel); }
  .tarjeta :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
  .tarjeta :global(.nitida) { opacity: 0; }
  .tarjeta :global(.nitida.arriba) { object-position: top; }
  .pie { font-size: 1.0625rem; position: absolute; left: 0; right: 0; bottom: 1.25rem; display: grid; gap: 0.2rem; justify-items: center; text-align: center; }
  .pie b { font-size: clamp(1.9rem, 3.4vw, 2.8rem); line-height: 1; }
  .pie span { font-size: 1.0625rem; color: var(--color-gris); }
</style>

<script>
  import { movimientoPermitido } from '../motion/index';

  const seccion = document.querySelector<HTMLElement>('[data-galeria]');
  const escenario = seccion?.querySelector<HTMLElement>('.escenario');
  if (seccion && escenario) {
    const tarjetas = [...seccion.querySelectorAll<HTMLElement>('.tarjeta')];
    const nitidas = tarjetas.map((t) => t.querySelector<HTMLElement>('.nitida')!);
    const nombre = seccion.querySelector<HTMLElement>("[data-pie-nombre]")!;
    const genero = seccion.querySelector<HTMLElement>("[data-pie-genero]")!;
    const n = tarjetas.length;
    const mover = movimientoPermitido();
    let centro = 0, destino = 0, visible = false, cuadro = 0, ultimoNombre = -1;
    // 1 = quieta (todas nítidas), 0 = en movimiento (los costados en píxeles). Sin movimiento, siempre nítidas
    let quieta = 1;
    // La distancia más corta en una ronda: la fila no tiene punta, después de la última vuelve la primera
    const ronda = (d: number) => ((((d + n / 2) % n) + n) % n) - n / 2;
    const pintar = () => {
      const paso = tarjetas[0].offsetWidth * 0.8;
      tarjetas.forEach((t, i) => {
        const d = ronda(i - centro);
        const g = Math.max(-1, Math.min(1, d));
        // Al revés del coverflow de siempre: el borde de afuera viene hacia adelante
        t.style.transform = `translateX(${d * paso}px) translateZ(${-Math.abs(g) * 40}px) rotateY(${-g * 44}deg)`;
        t.style.zIndex = String(100 - Math.round(Math.abs(d) * 10));
        t.style.opacity = String(Math.max(0, 1 - Math.max(0, Math.abs(d) - 2) * 0.9));
        t.querySelector('a')!.tabIndex = Math.abs(d) < 0.5 ? 0 : -1;
        // La del centro, siempre nítida. Las de los costados pasan a píxeles solo mientras la fila se mueve
        nitidas[i].style.opacity = String(Math.max(quieta, 1 - Math.abs(d) * 1.4));
      });
      const k = ((Math.round(centro) % n) + n) % n;
      if (k !== ultimoNombre) { ultimoNombre = k; nombre.textContent = tarjetas[k].dataset.nombre ?? ''; genero.textContent = tarjetas[k].dataset.genero ?? ''; }
    };
    const bucle = () => {
      centro += (destino - centro) * (mover ? 0.12 : 1);
      if (Math.abs(destino - centro) < 0.001) centro = destino;
      const quietaDestino = mover && (Math.abs(destino - centro) > 0.02 || arrastrando) ? 0 : 1;
      quieta += (quietaDestino - quieta) * (mover ? 0.14 : 1);
      if (Math.abs(quietaDestino - quieta) < 0.004) quieta = quietaDestino;
      pintar();
      cuadro = visible && (centro !== destino || arrastrando || quieta !== quietaDestino) ? requestAnimationFrame(bucle) : 0;
    };
    const animar = () => { if (!cuadro) cuadro = requestAnimationFrame(bucle); };
    const ir = (k: number) => { destino = k; animar(); };

    // Pasa sola cada 3 s mientras está en pantalla y nadie la está usando
    let pausa = false;
    const auto = mover ? window.setInterval(() => { if (visible && !pausa && !arrastrando) ir(Math.round(destino) + 1); }, 3000) : 0;
    escenario.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') pausa = true; });
    escenario.addEventListener('pointerleave', () => { pausa = false; });
    escenario.addEventListener('focusin', () => { pausa = true; });
    escenario.addEventListener('focusout', () => { pausa = false; });
    escenario.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); ir(Math.round(destino) + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); ir(Math.round(destino) - 1); }
    });

    // Arrastre con inercia; un toque sin arrastrar en la del centro abre el caso, en una del costado la trae al centro
    let arrastrando = false, x0 = 0, ultimoX = 0, vel = 0, t0 = 0, movido = 0;
    escenario.addEventListener('pointerdown', (e) => { arrastrando = true; movido = 0; x0 = ultimoX = e.clientX; t0 = performance.now(); vel = 0; escenario.setPointerCapture(e.pointerId); escenario.style.cursor = 'grabbing'; animar(); });
    escenario.addEventListener('pointermove', (e) => {
      if (!arrastrando) return;
      const dx = e.clientX - ultimoX, ahora = performance.now();
      vel = dx / Math.max(1, ahora - t0); t0 = ahora; ultimoX = e.clientX; movido += Math.abs(dx);
      destino -= dx / (tarjetas[0].offsetWidth * 0.8);
    });
    const soltar = (e: PointerEvent) => {
      if (!arrastrando) return;
      arrastrando = false; escenario.style.cursor = '';
      if (movido < 6) {
        const tarjeta = (document.elementsFromPoint(e.clientX, e.clientY).find((el) => el.classList?.contains('tarjeta')) as HTMLElement | undefined);
        if (tarjeta) {
          const i = tarjetas.indexOf(tarjeta);
          if (Math.abs(ronda(i - centro)) < 0.5) {
            const img = tarjeta.querySelector<HTMLElement>('.nitida');
            if (img) img.style.viewTransitionName = tarjeta.dataset.vt ?? '';
            location.href = tarjeta.querySelector('a')!.href;
            return;
          }
          ir(Math.round(destino) + Math.round(ronda(i - centro)));
          return;
        }
      }
      ir(Math.round(destino - vel * 2.5));
    };
    escenario.addEventListener('pointerup', soltar);
    escenario.addEventListener('pointercancel', () => { arrastrando = false; escenario.style.cursor = ''; ir(Math.round(destino)); });
    // Los links no navegan solos: el toque lo decide arriba (así un arrastre nunca abre un caso sin querer)
    tarjetas.forEach((t) => t.querySelector('a')!.addEventListener('click', (e) => { if (e.detail !== 0) e.preventDefault(); }));

    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) animar(); }).observe(escenario);
    addEventListener('resize', () => animar());
    addEventListener('pageshow', () => tarjetas.forEach((t) => { const img = t.querySelector<HTMLElement>('.nitida'); if (img) img.style.viewTransitionName = ''; }));
    pintar();
    void auto;
  }
</script>
