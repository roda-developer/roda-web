---
import { cartel } from '../content/guion';
import { RUBROS } from '../story/opciones';
import Eleccion from '../components/Eleccion.tsx';
import Posters from '../components/Posters.tsx';
---
<section id="cartel" aria-labelledby="cartel-titulo">
  <div class="plano">
    <div class="w-full max-w-5xl">
      <h2 id="cartel-titulo" class="adapta-titulo mb-16 text-center font-titulo text-[clamp(4rem,22vw,15rem)] leading-[0.85] tracking-[-0.03em] italic" data-revelar>
        {cartel.rotulo}
      </h2>
      <p class="mx-auto mb-12 max-w-[32ch] text-center text-lg text-pantalla/70" data-revelar="4">{cartel.bajada}</p>
      <div data-revelar="8">
        <Eleccion client:idle clave="rubro" numero={4} pregunta={cartel.pregunta} opciones={RUBROS} compacta />
      </div>
    </div>
  </div>

  <div class="pb-24 md:pb-40">
    <Posters client:idle />
  </div>
</section>

<style is:global>
  .posters {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 1.25rem 1.5rem;
    scrollbar-width: none;
  }
  .posters::-webkit-scrollbar { display: none; }
  @media (min-width: 1024px) {
    .posters {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
      overflow: visible;
      padding: 0 3rem;
    }
  }

  .poster {
    flex: none;
    width: min(78vw, 22rem);
    aspect-ratio: 2 / 3;
    scroll-snap-align: center;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 0.5rem;
    background:
      radial-gradient(120% 70% at 50% 0%, color-mix(in oklab, var(--tinta) 16%, transparent), transparent 60%),
      var(--fondo);
    color: var(--tinta);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
    transition: transform 0.8s var(--ease-cine);
  }
  @media (min-width: 1024px) { .poster { width: auto; } }
  @media (hover: hover) { .poster:hover { transform: translateY(-6px) rotate(-0.6deg); } }

  .poster > div:nth-child(2) { align-self: end; }
  .poster-titulo {
    font-family: var(--font-titulo);
    font-size: clamp(2.8rem, 14vw, 4.2rem);
    line-height: 0.88;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  @media (min-width: 1024px) { .poster-titulo { font-size: clamp(2.6rem, 3.6vw, 4rem); } }

  .poster-cerca {
    padding: 0.35em 0.7em;
    border-radius: 999px;
    background: var(--tinta);
    color: var(--fondo);
    letter-spacing: 0.18em;
  }

  .poster-creditos {
    border-top: 1px solid color-mix(in oklab, var(--tinta) 35%, transparent);
    padding-top: 0.75rem;
    font-size: 0.56rem;
    letter-spacing: 0.22em;
    line-height: 1.7;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>
