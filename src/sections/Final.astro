---
/**
 * El final: una fila curva de trabajos pasados a píxeles que no para de pasar (las fotos se curvan hacia vos en los bordes y se apagan)
 * y, abajo, la pregunta grande en una sola línea y el botón. Sin caja encima de las fotos.
 * Se pausa fuera de pantalla; sin movimiento, la fila queda quieta.
 */
import { Image } from 'astro:assets';
import { enOrden, proyectosEn } from '../content/proyectos';
import { idiomaDe, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { inicio } = textos(idioma);
// Cada trabajo pasado a píxeles (scripts/pixelar-afiches.mjs): el mismo lenguaje del video de Estudio, sin capturas recortadas
const pixeles = import.meta.glob<{ default: ImageMetadata }>('../assets/pixeles/*.png', { eager: true });
const pixelDe = (slug: string) => pixeles[`../assets/pixeles/${slug}.png`]?.default;
const trabajos = enOrden(proyectosEn(idioma)).filter((p) => pixelDe(p.slug));
// Dos vueltas, así la fila nunca se queda sin fotos al pasar
const fila = [...trabajos, ...trabajos];
---
<section class="final" aria-labelledby="final-titulo" data-final>
  <div class="curva" aria-hidden="true">
    {fila.map((p) => (
      <Image src={pixelDe(p.slug)!} alt="" widths={[480, 900, 1200]} sizes="(min-width: 1024px) 24rem, 60vw" quality={90} format="png" loading="lazy" class="foto" />
    ))}
  </div>
  <div class="cierre">
    <h2 id="final-titulo" class="font-titulo" data-revelar>{inicio.final.titulo}</h2>
    <a href={ruta(idioma, 'contacto')} class="cta" data-revelar="3">{inicio.final.cta}</a>
  </div>
</section>

<style>
  .final { padding-top: clamp(6rem, 16svh, 11rem); }
  .curva { position: relative; height: clamp(15rem, 34vw, 26rem); overflow: hidden; perspective: 1000px; }
  /* Todas con el mismo alto; cada una con su ancho (los afiches son verticales, las webs sin afiche, horizontales) */
  .curva :global(.foto) { position: absolute; top: 8%; left: 0; height: clamp(11.3rem, 20vw, 20rem); width: auto; backface-visibility: hidden; will-change: transform, opacity; }
  /* La pregunta en una sola línea, a lo ancho, y el botón grande abajo */
  .cierre { display: grid; gap: clamp(1.5rem, 4svh, 2.5rem); justify-items: center; text-align: center; padding: clamp(2rem, 6svh, 4rem) 1.25rem 0; }
  .cierre h2 { font-size: min(15.6vw, 15rem); line-height: 0.88; white-space: nowrap; }
  .cierre .cta { min-height: 4rem; padding-inline: 2.5rem; font-size: 1.25rem; }
</style>

<script>
  import { movimientoPermitido } from '../motion/index';

  const seccion = document.querySelector<HTMLElement>('[data-final]');
  const curva = seccion?.querySelector<HTMLElement>('.curva');
  if (seccion && curva) {
    const fotos = [...curva.querySelectorAll<HTMLElement>('.foto')];
    const mover = movimientoPermitido();
    let corrimiento = 0;
    // Cada foto se ubica en la fila y gira según qué tan lejos está del centro
    const ubicar = () => {
      const ancho = curva.clientWidth;
      // Cada foto arranca donde termina la anterior, con un espacio igual entre todas
      const hueco = (fotos[0]?.offsetHeight ?? 200) * 0.08;
      const inicios: number[] = [];
      let total = 0;
      fotos.forEach((f) => { inicios.push(total); total += f.offsetWidth + hueco; });
      const margen = Math.max(...fotos.map((f) => f.offsetWidth));
      fotos.forEach((f, i) => {
        const w = f.offsetWidth;
        const x = (((inicios[i] - corrimiento) % total) + total) % total - margen;
        const d = (x + w / 2 - ancho / 2) / (ancho / 2);
        const giro = Math.max(-1, Math.min(1, d));
        f.style.transform = `translate3d(${x}px, 0, ${Math.abs(giro) * 110}px) rotateY(${-giro * 38}deg)`;
        f.style.opacity = String(Math.max(0, 1 - Math.max(0, Math.abs(d) - 0.72) * 3.2));
      });
    };
    ubicar();
    addEventListener('resize', ubicar);
    if (mover) {
      let visible = false, cuadro = 0, antes = 0;
      const bucle = (ahora: number) => {
        // La misma velocidad en cualquier pantalla: 40 px por segundo
        corrimiento += antes ? ((ahora - antes) / 1000) * 40 : 0;
        antes = ahora;
        ubicar();
        cuadro = visible ? requestAnimationFrame(bucle) : 0;
      };
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible && !cuadro) { antes = 0; cuadro = requestAnimationFrame(bucle); }
      }).observe(curva);
    }
  }
</script>
