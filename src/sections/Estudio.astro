---
/**
 * La sección Estudio suelta: va después de la Linterna (con la O, Estudio vive adentro del Portal).
 * El video de la compu hecha de píxeles como banner a lo ancho, y el texto abajo.
 */
import { idiomaDe, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { inicio } = textos(idioma);
---
<section class="estudio-suelto" id="estudio" aria-labelledby="estudio-titulo" data-estudio-suelto>
  <div class="cuadro" data-revelar>
    <video src="/videos/roda-escritorio.mp4?v=7" poster="/videos/roda-escritorio.jpg?v=7" muted loop playsinline preload="metadata" aria-label={inicio.estudio.video}></video>
  </div>
  <div class="texto">
    <h2 id="estudio-titulo" class="font-titulo" data-revelar>{inicio.estudio.titulo}</h2>
    <p data-revelar="3">{inicio.estudio.texto}</p>
    <a href={ruta(idioma, 'proyectos')} class="cta" data-revelar="5">{inicio.estudio.cta}</a>
  </div>
</section>

<style>
  .estudio-suelto { display: grid; gap: 2rem; padding: clamp(5rem, 12svh, 9rem) 1.25rem 0; }
  @media (min-width: 768px) { .estudio-suelto { padding-inline: clamp(1.5rem, 3.5vw, 3rem); } }
  .cuadro { aspect-ratio: 7 / 3; margin-inline: -1.25rem; overflow: hidden; background: var(--color-papel); }
  @media (min-width: 768px) { .cuadro { margin-inline: 0; } }
  @media (min-width: 1024px) { .texto { grid-template-columns: auto 1fr auto; align-items: end; column-gap: clamp(2rem, 4vw, 4rem); } }
  .cuadro video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .texto { display: grid; gap: 1.25rem; justify-items: start; }
  .texto h2 { font-size: clamp(3rem, 8vw, 6rem); line-height: 0.9; }
  .texto p { max-width: 38ch; font-size: clamp(1.125rem, 1.5vw, 1.375rem); line-height: 1.45; }
</style>

<script>
  import { movimientoPermitido } from '../motion/index';

  // El video corre solo en pantalla y con movimiento permitido; si no, queda su portada
  const video = document.querySelector<HTMLVideoElement>('[data-estudio-suelto] video');
  if (video && movimientoPermitido()) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }).observe(video);
  }
</script>
