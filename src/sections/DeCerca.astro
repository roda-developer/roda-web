---
/**
 * Un trabajo de cerca: un caso real de punta a punta, en una tira que pasa de costado.
 * La marca, el afiche que le hicimos, la web, el celu y lo que dijo la clienta.
 * En compu la tira avanza con el scroll; en celu (y sin movimiento) se desliza con el dedo.
 * PENDIENTE (Giuli/Facu): sumar bocetos o una dirección descartada cuando los tengan.
 */
import { Image } from 'astro:assets';
import AficheEmme from '../components/afiches/AficheEmme.astro';
import { capturas } from '../content/capturas';
import { proyectosEn } from '../content/proyectos';
import { idiomaDe, rellenar, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { inicio, proyectosPagina } = textos(idioma);
const t = inicio.deCerca;
const slug = 'emme';
const p = proyectosEn(idioma).find((x) => x.slug === slug)!;
const c = capturas(slug);
const dicho = p.testimonios?.[0];
---
<section class="de-cerca" aria-labelledby="de-cerca-titulo" data-de-cerca>
  <div class="marco-pista">
    <h2 id="de-cerca-titulo" class="titulo font-titulo">{rellenar(t.titulo, { titulo: p.titulo })}</h2>
    <ol class="pista">
      <li class="panel panel-marca">
        <Image src={c.afiche} alt={p.cliente} widths={[480, 900, 1400]} sizes="(min-width: 1024px) 34vw, 80vw" loading="lazy" class="foto" />
        <p class="leyenda"><span>{t.marca}</span> {p.cliente}</p>
      </li>
      <li class="panel panel-afiche">
        <div class="afiche-caja"><AficheEmme slug={slug} /></div>
        <p class="leyenda"><span>{t.afiche}</span></p>
      </li>
      <li class="panel panel-web">
        <Image src={c.portada} alt={rellenar(proyectosPagina.portadaDe, { titulo: p.titulo })} widths={[640, 1200, 1800]} sizes="(min-width: 1024px) 52vw, 85vw" loading="lazy" class="foto" />
        <p class="leyenda"><span>{t.web}</span></p>
      </li>
      {c.mobile && (
        <li class="panel panel-celu">
          <Image src={c.mobile} alt={rellenar(proyectosPagina.celularDe, { titulo: p.titulo })} widths={[300, 600]} sizes="(min-width: 1024px) 18vw, 50vw" loading="lazy" class="foto" />
          <p class="leyenda"><span>{t.celu}</span></p>
        </li>
      )}
      <li class="panel panel-dicho">
        {dicho && (
          <figure>
            <blockquote class="font-titulo">“{dicho.destacado}”</blockquote>
            <figcaption>{dicho.nombre} · {dicho.rol}</figcaption>
          </figure>
        )}
        <a href={ruta(idioma, 'proyectos', slug)} class="cta">{t.verCaso}</a>
      </li>
    </ol>
  </div>
</section>

<style>
  .de-cerca { padding-top: clamp(5rem, 14svh, 10rem); }
  .marco-pista { display: grid; gap: 2rem; }
  .titulo { padding-inline: 1.25rem; font-size: clamp(2.8rem, 7vw, 6rem); line-height: 0.92; }
  @media (min-width: 768px) { .titulo { padding-inline: clamp(1.5rem, 3.5vw, 3rem); } }
  /* Celu y sin movimiento: se desliza con el dedo, de a un panel */
  .pista { display: flex; gap: 1.25rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 1.25rem 1rem; scrollbar-width: thin; }
  .panel { flex: 0 0 auto; scroll-snap-align: start; display: grid; gap: 0.9rem; align-content: start; }
  .panel-marca { width: min(78vw, 26rem); }
  .panel-marca :global(.foto) { aspect-ratio: 4 / 5; }
  .panel-afiche { width: min(86vw, 40rem); }
  .afiche-caja { position: relative; aspect-ratio: 3 / 2; overflow: hidden; container-type: inline-size; }
  .panel-web { width: min(86vw, 46rem); }
  .panel-web :global(.foto) { aspect-ratio: 16 / 10; object-position: top; }
  .panel-celu { width: min(48vw, 14rem); }
  .panel-celu :global(.foto) { aspect-ratio: 390 / 844; object-position: top; }
  .panel-dicho { width: min(86vw, 30rem); align-content: center; gap: 2rem; justify-items: start; }
  .panel :global(.foto) { width: 100%; height: auto; object-fit: cover; display: block; background: var(--color-tinta); }
  .leyenda { font-size: 0.9375rem; line-height: 1.45; color: var(--color-gris); max-width: 34ch; }
  .leyenda span { color: var(--color-tinta); font-weight: 600; margin-right: 0.35rem; }
  blockquote { font-size: clamp(2.2rem, 4.2vw, 3.6rem); line-height: 0.98; }
  figcaption { margin-top: 1rem; font-size: 1rem; color: var(--color-gris); }

  /* Compu con movimiento: la tira queda fija y avanza de costado con el scroll */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .de-cerca .pista { overflow: visible; scroll-snap-type: none; padding-inline: clamp(1.5rem, 3.5vw, 3rem); gap: clamp(2rem, 4vw, 4rem); align-items: center; will-change: transform; }
    :global(.js) .de-cerca .marco-pista { height: 100svh; align-content: center; overflow: hidden; }
    :global(.js) .de-cerca .panel-marca { width: 30vw; }
    :global(.js) .de-cerca .panel-afiche { width: 44vw; }
    :global(.js) .de-cerca .panel-web { width: 50vw; }
    :global(.js) .de-cerca .panel-celu { width: 16vw; }
    :global(.js) .de-cerca .panel-dicho { width: 34vw; }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const seccion = document.querySelector<HTMLElement>('[data-de-cerca]');
  if (seccion && movimientoPermitido()) {
    gsap.matchMedia().add('(min-width: 1024px)', () => {
      const pista = seccion.querySelector<HTMLElement>('.pista')!;
      const recorrido = () => Math.max(0, pista.scrollWidth - innerWidth);
      gsap.to(pista, {
        x: () => -recorrido(),
        ease: 'none',
        scrollTrigger: { trigger: seccion.querySelector('.marco-pista'), start: 'top top', end: () => `+=${recorrido()}`, pin: true, scrub: 0.5, invalidateOnRefresh: true },
      });
    });
  }
</script>
