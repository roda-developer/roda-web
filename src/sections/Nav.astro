---
import Marca from '../components/Marca.astro';
import Bandera from '../components/Bandera.astro';
import { IDIOMAS, NOMBRE_IDIOMA, equivalente, idiomaDe, rellenar, ruta, textos } from '../i18n';

interface Props {
  /** En la home el logo no es link (ya estás ahí); en las otras páginas vuelve a la home */
  enHome?: boolean;
  /** La página en la que estás: su link queda marcado */
  actual?: 'proyectos' | 'nosotros' | 'precios' | 'contacto';
}
const { enHome = true, actual } = Astro.props;
const aqui = (pagina: string) => (actual === pagina ? 'page' : undefined);
const idioma = idiomaDe(Astro.currentLocale);
const { nav, ui } = textos(idioma);
// El selector de idioma lleva a esta misma página en el otro idioma
const idiomas = IDIOMAS.map((l) => ({ l, href: equivalente(Astro.url.pathname, l), ...NOMBRE_IDIOMA[l] }));
---
<header class="nav fixed inset-x-0 top-0 z-50 px-5 py-1.5 md:px-[clamp(1.5rem,3.5vw,3rem)] md:py-1.5">
  <nav aria-label={ui.principal} class="mono w-full text-[0.8125rem] md:text-sm">
    <!-- Las columnas de los costados no se estiran con textos largos (otros idiomas): el logo queda centrado y nada se sale -->
    <div class="relative z-50 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center w-full">
      <!-- Desktop Izquierda: Proyectos, Nosotros -->
      <div class="hidden md:flex min-w-0 items-center justify-start gap-5 md:gap-8 whitespace-nowrap">
        <a href={ruta(idioma, 'proyectos')} class="enlace inline-flex min-h-11 items-center" aria-current={aqui('proyectos')}>{nav.proyectos}</a>
        <a href={ruta(idioma, 'nosotros')} class="enlace inline-flex min-h-11 items-center" aria-current={aqui('nosotros')}>{nav.nosotros}</a>
      </div>

      <!-- Mobile Izquierda: Hablemos, siempre a mano (el logo sigue centrado por la grilla) -->
      <div class="flex md:hidden min-w-0 items-center justify-start">
        <a href={ruta(idioma, 'contacto')} class="enlace inline-flex min-h-11 min-w-0 items-center overflow-hidden whitespace-nowrap" aria-current={aqui('contacto')}>({nav.atajo})</a>
      </div>

      <!-- Centro: Logo Roda (en home no tiene link para que tocar el nav no te mande arriba) -->
      <div class="flex items-center justify-center px-1 sm:px-2">
        {enHome ? (
          <span class="inline-flex min-h-11 items-center text-[1.35rem] sm:text-[1.5rem] md:text-[1.75rem] cursor-default select-none">
            <Marca />
          </span>
        ) : (
          <a href={ruta(idioma, 'inicio')} class="inline-flex min-h-11 items-center text-[1.35rem] sm:text-[1.5rem] md:text-[1.75rem]" aria-label={ui.volverInicio}>
            <Marca />
          </a>
        )}
      </div>

      <!-- Desktop Derecha: Precios, Hablemos y el idioma -->
      <div class="hidden md:flex min-w-0 items-center justify-end gap-5 md:gap-8 whitespace-nowrap">
        <a href={ruta(idioma, 'precios')} class="enlace inline-flex min-h-11 items-center" aria-current={aqui('precios')}>{nav.precios}</a>
        <a href={ruta(idioma, 'contacto')} class="enlace inline-flex min-h-11 items-center" aria-current={aqui('contacto')}>({nav.atajo})</a>
        <button type="button" class="boton-sonido hidden md:inline-flex" aria-pressed="true" aria-label={ui.sonido} data-sonido-boton data-sonido-propio>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" fill="currentColor" stroke="none" />
            <path class="ondas" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
            <path class="tachado" d="M15.5 9.5l5 5M20.5 9.5l-5 5" />
          </svg>
        </button>
        <button type="button" class="boton-cc hidden md:inline-flex" aria-expanded="false" aria-controls="subtitulos" aria-label={rellenar(ui.cambiarIdioma, { idioma: NOMBRE_IDIOMA[idioma].largo })}>
          <Bandera idioma={idioma} /><span>{NOMBRE_IDIOMA[idioma].corto}</span>
        </button>
      </div>

      <!-- Mobile Derecha: Botón Hamburguesa asimétrico (una raya más larga, otra más corta) -->
      <div class="flex md:hidden min-w-0 items-center justify-end gap-1 [&>*]:shrink-0">
        <button type="button" class="boton-sonido inline-flex md:hidden" aria-pressed="true" aria-label={ui.sonido} data-sonido-boton data-sonido-propio>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" fill="currentColor" stroke="none" />
            <path class="ondas" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" />
            <path class="tachado" d="M15.5 9.5l5 5M20.5 9.5l-5 5" />
          </svg>
        </button>
        <button type="button" class="boton-cc inline-flex min-w-11 justify-center md:hidden" aria-expanded="false" aria-controls="subtitulos" aria-label={rellenar(ui.cambiarIdioma, { idioma: NOMBRE_IDIOMA[idioma].largo })}>
          <!-- En el celu, solo la bandera: la barra queda más liviana -->
          <Bandera idioma={idioma} />
        </button>
        <button
          type="button"
          class="boton-hamburguesa inline-flex flex-col items-end justify-center w-11 h-11 p-2 gap-1.5"
          aria-label={ui.abrirMenu}
          data-abrir={ui.abrirMenu}
          data-cerrar={ui.cerrarMenu}
          aria-expanded="false"
          aria-controls="menu-movil"
        >
          <span class="linea-hamburguesa linea-arriba"></span>
          <span class="linea-hamburguesa linea-abajo"></span>
        </button>
      </div>
    </div>

    <!-- Menú desplegable Mobile: dentro de nav para accesibilidad y semántica -->
    <div id="menu-movil" class="menu-movil md:hidden" inert>
      <div class="space-y-6 pt-8">
        <div class="flex flex-col space-y-4">
          <a href={ruta(idioma, 'proyectos')} aria-current={aqui('proyectos')} class="link-movil group inline-flex min-h-11 items-baseline gap-3 text-3xl font-titulo font-bold tracking-tight">
            <span class="enlace-movil">{nav.proyectos}</span>
          </a>
          <a href={ruta(idioma, 'nosotros')} aria-current={aqui('nosotros')} class="link-movil group inline-flex min-h-11 items-baseline gap-3 text-3xl font-titulo font-bold tracking-tight">
            <span class="enlace-movil">{nav.nosotros}</span>
          </a>
          <a href={ruta(idioma, 'precios')} aria-current={aqui('precios')} class="link-movil group inline-flex min-h-11 items-baseline gap-3 text-3xl font-titulo font-bold tracking-tight">
            <span class="enlace-movil">{nav.precios}</span>
          </a>
          <a href={ruta(idioma, 'contacto')} aria-current={aqui('contacto')} class="link-movil group inline-flex min-h-11 items-baseline gap-3 text-3xl font-titulo font-bold tracking-tight">
            <span class="enlace-movil">({nav.atajo})</span>
          </a>
        </div>
      </div>

      <div class="border-t border-tinta/10 pt-6 flex items-center justify-between mono text-tinta/70">
        <span>{ui.estudio}</span>
        <span>{ui.desde}</span>
      </div>
    </div>
  </nav>
</header>

<!-- Subtítulos: el idioma se elige como en una plataforma de streaming.
     En compu cae debajo del botón; en el celu sube desde abajo, a lo ancho. -->
<div class="velo-cc" data-velo-cc hidden></div>
<div id="subtitulos" class="panel-cc" role="group" aria-label={ui.idioma} hidden>
  <p class="titulo-cc">{ui.subtitulos}</p>
  <ul>
    {idiomas.map((i) => (
      <li>
        <a href={i.href} hreflang={i.l} lang={i.l} aria-current={i.l === idioma ? 'true' : undefined} class="opcion-cc">
          <svg class="check-cc" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.2 11.5 13 4.5" /></svg><Bandera idioma={i.l} />{i.largo}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  /* Arriba de todo: transparente y compacto */
  .nav {
    color: var(--color-tinta);
    background-color: transparent;
    transition: color 200ms ease, background-color 200ms ease, box-shadow 200ms ease, transform 250ms var(--ease-ui);
  }

  /* Al subir o desplazarse: fondo menos transparente, consistente con el diseño de PC */
  .nav.con-fondo {
    background-color: color-mix(in oklab, var(--color-papel) 92%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: 0 4px 20px -8px rgb(0 0 0 / 0.08);
  }

  /* Cuando el menú móvil está abierto, la barra superior se mimetiza con el fondo sólido del menú */
  .nav.menu-abierto {
    background-color: var(--color-papel) !important;
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
    box-shadow: none !important;
  }
  .nav.sobre-oscuro.menu-abierto {
    background-color: var(--color-negro) !important;
  }

  /* Al bajar se esconde; al subir vuelve */
  .nav.escondida:not(.menu-abierto):not(.cc-abierto) {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav {
      transition: color 200ms ease, background-color 200ms ease;
    }
  }

  /* Sobre fondo oscuro (la pantalla del tráiler o secciones oscuras) */
  .nav.sobre-oscuro {
    color: var(--color-papel);
  }
  .nav.sobre-oscuro.con-fondo {
    background-color: color-mix(in oklab, var(--color-negro) 92%, transparent);
    box-shadow: 0 4px 20px -8px rgb(0 0 0 / 0.35);
  }

  /* Botón hamburguesa: dos rayas asimétricas (la de arriba más larga, la de abajo más corta) */
  .boton-hamburguesa {
    color: currentColor;
    background: transparent;
    border: none;
    cursor: pointer;
    touch-action: manipulation;
  }
  .linea-hamburguesa {
    display: block;
    height: 2px;
    background-color: currentColor;
    border-radius: 999px;
    width: 22px;
    transform-origin: center;
    transition: transform 250ms var(--ease-ui);
  }
  /* Las dos miden lo mismo: el largo se cambia con scaleX (la de abajo se ve de 14px, pegada a la derecha) */
  .linea-arriba {
    transform: translate(0, 0) rotate(0) scaleX(1);
  }
  .linea-abajo {
    transform: translate(4px, 0) rotate(0) scaleX(0.636);
  }

  /* Cuando el menú está abierto: las líneas se cruzan formando una X */
  .nav.menu-abierto .linea-arriba {
    transform: translate(0, 4px) rotate(45deg) scaleX(0.91);
  }
  .nav.menu-abierto .linea-abajo {
    transform: translate(0, -4px) rotate(-45deg) scaleX(0.91);
  }

  /* Menú desplegable Mobile: Color sólido, no transparente, pantalla completa */
  .menu-movil {
    position: fixed;
    inset: 0;
    z-index: 45;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 6.5rem 1.5rem 2.5rem;
    background-color: var(--color-papel);
    color: var(--color-tinta);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 220ms var(--ease-ui), transform 220ms var(--ease-ui), visibility 220ms;
    pointer-events: none;
    overscroll-behavior: contain;
  }
  .menu-movil.sobre-oscuro {
    background-color: var(--color-negro);
    color: var(--color-papel);
  }
  .menu-movil.abierto {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Animación de entrada y toque de los links móviles */
  .link-movil {
    transition: transform 160ms var(--ease-ui);
  }
  .link-movil:active {
    transform: scale(0.97);
  }

  /* El subrayado de los links: una raya que crece con scaleX (no se anima el fondo) */
  .enlace { position: relative; }
  .enlace::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + 0.8em);
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-ui);
  }
  /* Subtítulos: el botón es la banderita + la sigla del idioma */
  .boton-cc {
    min-height: 2.75rem; align-items: center; gap: 0.4rem; padding: 0 0.25rem;
    color: currentColor; background: transparent; border: 0; cursor: pointer; touch-action: manipulation;
    opacity: 0.85; transition: opacity 200ms ease, transform 160ms var(--ease-ui);
  }
  .boton-cc:active { transform: scale(0.97); }
  .boton-cc[aria-expanded='true'] { opacity: 1; }
  /* El parlante: con ondas cuando suena, tachado cuando está apagado */
  .boton-sonido { min-width: 2.75rem; min-height: 2.75rem; align-items: center; justify-content: center; color: inherit; transition: transform 160ms var(--ease-ui), opacity 160ms ease; }
  .boton-sonido svg { width: 1.25rem; height: 1.25rem; }
  .boton-sonido:active { transform: scale(0.94); }
  .boton-sonido .tachado { display: none; }
  .boton-sonido[aria-pressed='false'] { opacity: 0.6; }
  .boton-sonido[aria-pressed='false'] .ondas { display: none; }
  .boton-sonido[aria-pressed='false'] .tachado { display: inline; }
  @media (hover: hover) and (pointer: fine) { .boton-cc:hover { opacity: 1; } }

  /* El panel: una tarjeta de papel, como el menú de un reproductor */
  .panel-cc {
    position: fixed; z-index: 60; inset: auto 0 0 0;
    padding: 1.25rem 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
    background: var(--color-papel); color: var(--color-tinta);
    border-radius: 1.25rem 1.25rem 0 0; box-shadow: 0 -12px 40px -12px rgb(0 0 0 / 0.25);
    transform: translateY(100%); transition: transform 250ms var(--ease-ui);
  }
  .panel-cc.abierto { transform: translateY(0); }
  .titulo-cc { font-size: 0.875rem; opacity: 0.75; margin-bottom: 0.5rem; }
  .opcion-cc {
    display: flex; align-items: center; gap: 0.75rem; min-height: 3rem;
    font-family: var(--font-titulo); font-size: 1.5rem; letter-spacing: -0.02em; text-transform: none;
    color: color-mix(in oklab, var(--color-tinta) 65%, transparent); transition: color 200ms ease, transform 160ms var(--ease-ui);
  }
  .opcion-cc:active { transform: scale(0.97); }
  .opcion-cc:focus-visible, .opcion-cc[aria-current='true'] { color: var(--color-tinta); }
  @media (hover: hover) and (pointer: fine) { .opcion-cc:hover { color: var(--color-tinta); } }
  .check-cc { flex: none; width: 1rem; height: 1rem; color: var(--color-tc-rosa); visibility: hidden; }
  .opcion-cc[aria-current='true'] .check-cc { visibility: visible; }
  .velo-cc { position: fixed; inset: 0; z-index: 55; background: rgb(0 0 0 / 0.3); opacity: 0; transition: opacity 200ms ease-out; }
  .velo-cc.abierto { opacity: 1; }

  @media (min-width: 768px) {
    .panel-cc {
      position: fixed; inset: 3.4rem 2rem auto auto; min-width: 13rem;
      padding: 0.9rem 1.1rem 0.7rem; border-radius: 0.9rem;
      border: 1px solid color-mix(in oklab, var(--color-tinta) 12%, transparent);
      box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.25);
      transform: translateY(-6px); opacity: 0; transition: transform 200ms var(--ease-ui), opacity 200ms ease-out;
    }
    .panel-cc.abierto { transform: translateY(0); opacity: 1; }
    .opcion-cc { font-size: 1.1rem; min-height: 2.5rem; }
    .velo-cc { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel-cc, .velo-cc { transition: none; }
  }
  .enlace[aria-current='page']::after { transform: scaleX(1); }
  @media (hover: hover) and (pointer: fine) {
    .enlace:hover::after { transform: scaleX(1); }
  }
  /* En el menú del celu, la página actual lleva el puntito rosa */
  .link-movil[aria-current='page'] .enlace-movil::after {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-left: 0.6rem;
    border-radius: 999px;
    background: var(--color-tc-rosa);
    vertical-align: middle;
  }
</style>

<script>
  import { cambiarSonido, iniciarSonidos, sonar, sonidoPrendido } from '../motion/sonido';
  import { iniciarCursor } from '../motion/cursor';

  // El cursor propio (solo con mouse)
  iniciarCursor();

  // ── Sonidos: arrancan prendidos; el parlante los apaga o los prende ──
  iniciarSonidos();
  const botonesSonido = [...document.querySelectorAll<HTMLButtonElement>('[data-sonido-boton]')];
  const pintarSonido = () => botonesSonido.forEach((b) => b.setAttribute('aria-pressed', String(sonidoPrendido())));
  pintarSonido();
  botonesSonido.forEach((b) => b.addEventListener('click', () => {
    const prender = !sonidoPrendido();
    cambiarSonido(prender);
    pintarSonido();
    if (prender) sonar('prende');
  }));

  import { pausarScroll } from '../motion/index';

  // Control del menú hamburguesa en mobile
  const nav = document.querySelector<HTMLElement>('.nav');
  const botonHamburguesa = document.querySelector<HTMLButtonElement>('.boton-hamburguesa');
  const menuMovil = document.getElementById('menu-movil');

  if (nav && botonHamburguesa && menuMovil) {
    const toggleMenu = (abrir?: boolean) => {
      const nuevoEstado = typeof abrir === 'boolean' ? abrir : !nav.classList.contains('menu-abierto');
      nav.classList.toggle('menu-abierto', nuevoEstado);
      menuMovil.classList.toggle('abierto', nuevoEstado);
      botonHamburguesa.setAttribute('aria-expanded', String(nuevoEstado));
      botonHamburguesa.setAttribute('aria-label', (nuevoEstado ? botonHamburguesa.dataset.cerrar : botonHamburguesa.dataset.abrir) ?? '');
      // Con el menú abierto, el resto de la página no se puede tocar ni tabular; el foco entra al menú y, al cerrar, vuelve al botón
      const focoAdentro = menuMovil.contains(document.activeElement);
      menuMovil.inert = !nuevoEstado;
      [...document.body.children].forEach((el) => { if (!el.contains(nav)) (el as HTMLElement).inert = nuevoEstado; });
      if (nuevoEstado) setTimeout(() => menuMovil.querySelector<HTMLAnchorElement>('a')?.focus({ preventScroll: true }), 30);
      else if (focoAdentro) botonHamburguesa.focus({ preventScroll: true });

      // Bloquear scroll de fondo mientras el menú está abierto
      pausarScroll(nuevoEstado);
      if (nuevoEstado) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.removeProperty('overflow');
      }
    };

    botonHamburguesa.addEventListener('click', () => toggleMenu());

    // Evitar arrastre de scroll de la página de fondo desde el menú
    menuMovil.addEventListener('touchmove', (e) => {
      e.preventDefault();
    }, { passive: false });

    // Al tocar links del menú móvil: cerrar y navegar de forma precisa
    menuMovil.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', (e) => {
        const href = link.getAttribute('href');
        if (href && (href.startsWith('#') || href.startsWith('/#'))) {
          const targetId = href.replace(/^\//, '');
          const target = document.querySelector(targetId);
          if (target) {
            e.preventDefault();
            toggleMenu(false);
            // Esperar que cierre el menú para que el cálculo de scroll sea 100% exacto
            setTimeout(() => {
              const y = target.getBoundingClientRect().top + window.scrollY - 15;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }, 60);
            return;
          }
        }
        toggleMenu(false);
      });
    });

    // Cerrar con Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('menu-abierto')) {
        toggleMenu(false);
      }
    });
  }

  // ── Subtítulos: abrir y cerrar el panel de idiomas ──
  const panelCC = document.getElementById('subtitulos');
  const veloCC = document.querySelector<HTMLElement>('[data-velo-cc]');
  const botonesCC = [...document.querySelectorAll<HTMLButtonElement>('.boton-cc')];
  if (panelCC && veloCC && botonesCC.length) {
    let origen: HTMLButtonElement | null = null;
    const estaAbierto = () => panelCC.classList.contains('abierto');
    const abrirCC = (boton: HTMLButtonElement | null) => {
      const abrir = boton !== null;
      if (abrir) {
        origen = boton;
        panelCC.hidden = false;
        veloCC.hidden = false;
        // un cuadro después, para que la transición arranque desde afuera
        requestAnimationFrame(() => requestAnimationFrame(() => { panelCC.classList.add('abierto'); veloCC.classList.add('abierto'); }));
        setTimeout(() => panelCC.querySelector<HTMLAnchorElement>('[aria-current="true"]')?.focus({ preventScroll: true }), 60);
      } else {
        panelCC.classList.remove('abierto');
        veloCC.classList.remove('abierto');
        setTimeout(() => { if (!estaAbierto()) { panelCC.hidden = true; veloCC.hidden = true; } }, 400);
        origen?.focus({ preventScroll: true });
      }
      botonesCC.forEach((b) => b.setAttribute('aria-expanded', String(abrir && b === boton)));
      // Mientras está abierto, el nav no se esconde
      nav?.classList.toggle('cc-abierto', abrir);
    };
    botonesCC.forEach((b) => b.addEventListener('click', (e) => {
      e.stopPropagation();
      abrirCC(estaAbierto() ? null : b);
    }));
    document.addEventListener('click', (e) => { if (estaAbierto() && !panelCC.contains(e.target as Node)) abrirCC(null); });
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape' && estaAbierto()) abrirCC(null); });
  }

  // Cuando algo oscuro (data-nav-oscuro, la pantalla del tráiler) pasa por debajo del menú, el menú pasa a papel.
  if (nav) {
    let pendiente = false;
    let ultimoY = Math.max(0, scrollY);
    let acumuladoBajar = 0;
    let acumuladoSubir = 0;


    const revisar = () => {
      pendiente = false;
      const y = Math.max(0, scrollY);
      const alto = nav.offsetHeight;
      const encima = [...document.querySelectorAll('[data-nav-oscuro]')].some((el) => {
        const r = el.getBoundingClientRect();
        return r.top < alto && r.bottom > alto / 2;
      });
      nav.classList.toggle('sobre-oscuro', encima);
      menuMovil?.classList.toggle('sobre-oscuro', encima);

      // Al despegarse de arriba se activa el velo transparente sutil
      nav.classList.toggle('con-fondo', y > 20);


      if (nav.classList.contains('menu-abierto')) {
        // Con el menú abierto nunca se esconde
        nav.classList.remove('escondida');
        acumuladoBajar = 0;
        acumuladoSubir = 0;
      } else if (y <= 20) {
        // Arriba de todo, siempre visible
        nav.classList.remove('escondida');
        acumuladoBajar = 0;
        acumuladoSubir = 0;
      } else {
        const diff = y - ultimoY;
        if (diff > 0) {
          // Bajando: acumular distancia hacia abajo
          acumuladoBajar += diff;
          acumuladoSubir = 0;
          if (acumuladoBajar > 10 && y > 60) {
            nav.classList.add('escondida');
          }
        } else if (diff < 0) {
          // Subiendo: acumular distancia hacia arriba
          acumuladoSubir += Math.abs(diff);
          acumuladoBajar = 0;
          if (acumuladoSubir > 8) {
            nav.classList.remove('escondida');
          }
        }
      }
      ultimoY = y;
    };

    const alScroll = () => {
      if (!pendiente) { pendiente = true; requestAnimationFrame(revisar); }
    };

    addEventListener('scroll', alScroll, { passive: true });
    addEventListener('touchmove', alScroll, { passive: true });
    addEventListener('wheel', alScroll, { passive: true });
    revisar();
  }
</script>
