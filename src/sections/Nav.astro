---
import Marca from '../components/Marca.astro';
import { nav } from '../content/guion';

interface Props {
  /** En la home los links son anclas; en las otras páginas vuelven a la home */
  enHome?: boolean;
}
const { enHome = true } = Astro.props;
const raiz = enHome ? '' : '/';
---
<header class="nav fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-4 px-5 py-3 md:px-8 md:py-4">
  <a href={enHome ? '#inicio' : '/'} class="inline-flex min-h-11 items-center text-[1.5rem] md:text-[1.75rem]" aria-label="Roda, volver al inicio"><Marca /></a>
  <nav aria-label="Principal" class="mono flex items-center gap-5 md:gap-8">
    <a href="/proyectos" class="enlace inline-flex min-h-11 items-center">{nav.proyectos}</a>
    <a href={`${raiz}#final`} class="enlace inline-flex min-h-11 items-center" data-atajo data-con={nav.atajo}>({nav.atajoSinRespuestas})</a>
  </nav>
</header>

<style>
  /* Tinta sobre el papel y los colores; papel cuando pasa por encima de algo oscuro (la pantalla del tráiler) */
  .nav { color: var(--color-tinta); transition: color 0.4s, transform 0.5s var(--ease-cine); }
  /* Al bajar se esconde para no pisar los títulos; al subir (o con el teclado adentro) vuelve */
  .nav.escondida:not(:focus-within) { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) { .nav { transition: color 0.4s; } }
  .nav.sobre-oscuro { color: var(--color-papel); }
  .enlace { background: linear-gradient(currentColor, currentColor) 0 calc(50% + 0.8em) / 0 1px no-repeat; transition: background-size 0.5s var(--ease-cine); }
  .enlace:hover { background-size: 100% 1px; }
</style>

<script>
  import { $respuestas } from '../story/store';
  import { fragmentosSinopsis } from '../story/sinopsis';

  // Con alguna respuesta, el atajo promete ver la web; sin respuestas, invita a contar la historia.
  const atajo = document.querySelector<HTMLElement>('[data-atajo]');
  if (atajo) {
    const sin = atajo.textContent;
    $respuestas.subscribe((r) => {
      atajo.textContent = fragmentosSinopsis(r).length ? `(${atajo.dataset.con})` : sin;
    });
  }

  // Cuando algo oscuro (data-nav-oscuro, la pantalla del tráiler) pasa por debajo del menú, el menú pasa a papel.
  // Se busca en cada scroll porque la pantalla aparece recién cuando carga el tráiler.
  const nav = document.querySelector<HTMLElement>('.nav');
  if (nav) {
    let pendiente = false;
    let ultimoY = scrollY;
    const revisar = () => {
      pendiente = false;
      const alto = nav.offsetHeight;
      const encima = [...document.querySelectorAll('[data-nav-oscuro]')].some((el) => {
        const r = el.getBoundingClientRect();
        return r.top < alto && r.bottom > alto / 2;
      });
      nav.classList.toggle('sobre-oscuro', encima);
      // Bajando se esconde; subiendo vuelve. Arriba de todo, siempre a la vista.
      const y = scrollY;
      if (Math.abs(y - ultimoY) > 8) {
        nav.classList.toggle('escondida', y > ultimoY && y > alto * 2);
        ultimoY = y;
      }
    };
    addEventListener('scroll', () => {
      if (!pendiente) { pendiente = true; requestAnimationFrame(revisar); }
    }, { passive: true });
    revisar();
  }
</script>
