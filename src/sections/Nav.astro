---
import Marca from '../components/Marca.astro';
import { nav } from '../content/guion';

interface Props {
  /** En la home los links son anclas; en las otras páginas vuelven a la home */
  enHome?: boolean;
}
const { enHome = true } = Astro.props;
const raiz = enHome ? '' : '/';
---
<header class="nav fixed inset-x-0 top-0 z-50 flex items-center justify-between gap-4 px-5 py-3 md:px-8 md:py-4">
  <a href={enHome ? '#inicio' : '/'} class="inline-flex min-h-11 items-center text-[1.5rem] md:text-[1.75rem]" aria-label="Roda, volver al inicio"><Marca /></a>
  <nav aria-label="Principal" class="mono flex items-center gap-5 md:gap-8">
    <a href="/proyectos" class="enlace inline-flex min-h-11 items-center">{nav.proyectos}</a>
    <a href={`${raiz}#final`} class="enlace inline-flex min-h-11 items-center">({nav.atajo})</a>
  </nav>
</header>

<style>
  /* Se invierte sobre lo que pase por debajo: tinta sobre papel, papel sobre la pantalla negra */
  .nav { color: var(--color-papel); mix-blend-mode: difference; }
  .enlace { background: linear-gradient(currentColor, currentColor) 0 calc(50% + 0.8em) / 0 1px no-repeat; transition: background-size 0.5s var(--ease-cine); }
  .enlace:hover { background-size: 100% 1px; }
</style>
