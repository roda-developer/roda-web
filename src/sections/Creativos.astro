---
import { creativos } from '../content/guion';
---
<section id="creativos" class="plano" aria-labelledby="creativos-titulo">
  <div class="w-full max-w-5xl">
    <h2 id="creativos-titulo" class="mb-10 flex items-center gap-3 text-[0.7rem] tracking-[0.32em] text-[var(--acento)] uppercase" data-revelar>
      <span class="h-px w-8 bg-current" aria-hidden="true"></span>{creativos.pregunta}
    </h2>
    <p class="adapta-titulo font-titulo text-[clamp(2.8rem,12vw,8.5rem)] leading-[0.92] tracking-[-0.025em]">
      <span class="block text-pantalla/55" data-revelar>{creativos.lineas[0]}</span>
      <span class="block" data-revelar="6">{creativos.lineas[1]}</span>
    </p>

    <!-- Marcas de corte: el idioma de quien diseña -->
    <div class="corte relative mt-14 inline-block px-7 py-5 md:mt-20 md:px-12 md:py-8" data-revelar="12">
      <span class="marca-corte tl" aria-hidden="true"></span>
      <span class="marca-corte tr" aria-hidden="true"></span>
      <span class="marca-corte bl" aria-hidden="true"></span>
      <span class="marca-corte br" aria-hidden="true"></span>
      <p class="adapta-titulo font-titulo text-[clamp(3rem,13vw,9rem)] leading-none text-[var(--acento)] italic">{creativos.firma}</p>
    </div>

    <p class="mt-12 max-w-[42ch] text-lg leading-relaxed text-pantalla/70 md:text-xl" data-revelar="4">{creativos.texto}</p>
  </div>
</section>

<style>
  .marca-corte {
    position: absolute;
    width: 1.4rem;
    height: 1.4rem;
    border-color: var(--acento);
  }
  .tl { top: 0; left: 0; border-top: 1px solid; border-left: 1px solid; translate: -0.7rem -0.7rem; }
  .tr { top: 0; right: 0; border-top: 1px solid; border-right: 1px solid; translate: 0.7rem -0.7rem; }
  .bl { bottom: 0; left: 0; border-bottom: 1px solid; border-left: 1px solid; translate: -0.7rem 0.7rem; }
  .br { bottom: 0; right: 0; border-bottom: 1px solid; border-right: 1px solid; translate: 0.7rem 0.7rem; }
</style>
