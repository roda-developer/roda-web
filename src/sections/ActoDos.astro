---
import { actoDos } from '../content/guion';
import { OBJETIVOS } from '../story/opciones';
import Rotulo from '../components/Rotulo.astro';
import Eleccion from '../components/Eleccion.tsx';
const [entiende, carga, lugar] = actoDos.planos;
const total = String(actoDos.planos.length).padStart(2, '0');
---
<section id="acto-dos" aria-label="Acto dos: lo que hace una buena web">
  <div class="px-5 pt-24 md:px-12 md:pt-32">
    <Rotulo rotulo={actoDos.rotulo} />
  </div>

  <!-- 01: el título no se anima. Aparece al instante, como dice. -->
  <article class="plano principio">
    <div class="principio-grilla">
      <p class="indice mono">(01 / {total})</p>
      <div>
        <h3 class="titulo">{entiende.titulo.replace('instante.', '')}<em>instante.</em></h3>
        <p class="bajada" data-revelar="10">{entiende.texto}</p>
      </div>
    </div>
  </article>

  <!-- 02: el peso real de esta página, medido en el navegador del visitante -->
  <article class="plano principio">
    <div class="principio-grilla">
      <p class="indice mono" data-revelar>(02 / {total})</p>
      <div>
        <h3 class="titulo" data-revelar="2">{carga.titulo}</h3>
        <p class="bajada" data-revelar="8">{carga.texto}</p>
        <div class="mt-10 grid max-w-md grid-cols-2 gap-6 border-t border-tinta/15 pt-4" data-revelar="12">
          <p>
            <span class="mono block text-gris">Esta página</span>
            <span class="font-titulo text-5xl md:text-6xl" data-peso>liviana</span>
          </p>
          <p>
            <span class="mono block text-gris">Una foto de tu celular</span>
            <span class="font-titulo text-5xl text-tinta/35 md:text-6xl">3.000 KB</span>
          </p>
        </div>
      </div>
    </div>
  </article>

  <article class="plano principio">
    <div class="principio-grilla">
      <p class="indice mono" data-revelar>(03 / {total})</p>
      <div class="space-y-14">
        <div>
          <h3 class="titulo" data-revelar="2">{lugar.titulo}</h3>
          <p class="bajada" data-revelar="8">{lugar.texto}</p>
        </div>
        <div data-revelar="12">
          <Eleccion client:idle clave="objetivo" numero={2} pregunta={lugar.pregunta!} opciones={OBJETIVOS} />
        </div>
      </div>
    </div>
  </article>
</section>

<style>
  .principio { place-items: center stretch; min-height: 88svh; }
  .principio-grilla {
    display: grid;
    gap: 2rem;
    width: 100%;
    max-width: 72rem;
  }
  @media (min-width: 1024px) {
    .principio-grilla { grid-template-columns: 10rem 1fr; gap: 3rem; }
    .indice { padding-top: 1.2rem; }
  }
  .indice { color: var(--color-gris); }
  .titulo {
    font-family: var(--font-titulo);
    font-size: clamp(2.9rem, 12.5vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .bajada {
    margin-top: 1.75rem;
    max-width: 30ch;
    font-size: 1.2rem;
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-tinta) 70%, transparent);
  }
  @media (min-width: 768px) { .bajada { font-size: 1.45rem; } }
</style>

<script>
  import { pesoDeLaPagina } from '../story/peso';

  const salida = document.querySelector<HTMLElement>('[data-peso]');
  const pintar = () => {
    const kb = pesoDeLaPagina(performance);
    if (salida && kb) salida.textContent = `${kb.toLocaleString('es-AR')} KB`;
  };
  if (document.readyState === 'complete') pintar();
  else addEventListener('load', pintar);
</script>
