---
import { actoDos } from '../content/guion';
import { OBJETIVOS } from '../story/opciones';
import Rotulo from '../components/Rotulo.astro';
import Eleccion from '../components/Eleccion.tsx';
---
<section id="acto-dos" class="plano !place-items-stretch !content-center" aria-labelledby="acto-dos-titulo">
  <div class="w-full space-y-14 md:space-y-20">
    <Rotulo rotulo={actoDos.rotulo} />

    <div class="grid gap-12 lg:grid-cols-[1fr_1.1fr] lg:gap-20">
      <!-- Primero el contexto, grande. Después las tres cosas, chicas y en lista. -->
      <h2 id="acto-dos-titulo" class="max-w-[12ch] font-titulo text-[clamp(2.8rem,11vw,7rem)] leading-[0.92] tracking-[-0.045em]" data-revelar>
        {actoDos.titulo}
      </h2>

      <ol class="divide-y divide-tinta/15 border-y border-tinta/15">
        {actoDos.planos.map((p, i) => (
          <li class="grid grid-cols-[2.75rem_1fr] gap-x-3 py-5 md:py-6" data-revelar={4 + i * 4}>
            <span class="mono pt-1.5 text-gris">({String(i + 1).padStart(2, '0')})</span>
            <div>
              <h3 class="text-[clamp(1.45rem,5vw,2.1rem)] leading-tight font-medium tracking-[-0.035em]">{p.titulo}</h3>
              <p class="mt-1.5 max-w-[40ch] text-tinta/65 md:text-lg">
                {p.texto}
                {i === 1 && <> Esta página pesa <strong class="font-medium text-tinta" data-peso>poco</strong>.</>}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <div class="pt-10" data-revelar="6">
      <Eleccion client:idle clave="objetivo" numero={2} pregunta={actoDos.pregunta} opciones={OBJETIVOS} />
    </div>
  </div>
</section>

<script>
  import { pesoDeLaPagina } from '../story/peso';

  const salida = document.querySelector<HTMLElement>('[data-peso]');
  const pintar = () => {
    const kb = pesoDeLaPagina(performance);
    if (salida && kb) salida.textContent = `${kb.toLocaleString('es-AR')} KB`;
  };
  if (document.readyState === 'complete') pintar();
  else addEventListener('load', pintar);
</script>
