---
import { idiomaDe, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { apertura } = textos(idioma);

---
<section id="inicio" class="plano !place-items-stretch" aria-labelledby="apertura-titulo">
  <!-- Como el original, pero el título también mira el alto: en pantallas bajas se achica para que entre todo -->
  <div class="flex min-h-[calc(100svh-12rem)] flex-col justify-end gap-8 md:min-h-[calc(100svh-clamp(10rem,18svh,16rem))] md:gap-[clamp(2rem,5svh,3.5rem)]">
    <h1 id="apertura-titulo" class="font-titulo text-[clamp(2.8rem,min(14.5vw,19svh),11.5rem)] leading-[1] tracking-[-0.045em]">
      <span class="mascara block"><span class="entra block [text-wrap:balance]" style="--d:0">{apertura.titulo[0]}</span></span>
      <span class="mascara block"><span class="entra block" style="--d:1">{apertura.titulo[1]}</span></span>
    </h1>
    <!-- Qué hacemos, dicho claro desde la primera pantalla, el botón para escribirnos y el atajo a los precios -->
    <div class="grid gap-6 border-t border-tinta/15 pt-5 md:grid-cols-[1fr_auto] md:items-center">
      <p class="entra-suave max-w-[34ch] text-xl md:max-w-[44ch] leading-snug [text-wrap:balance] text-tinta md:text-[clamp(1.25rem,2.6svh,1.5rem)]" style="--d:0">{apertura.queHacemos}</p>
      <div class="entra-suave flex flex-wrap items-center gap-x-6 gap-y-3" style="--d:1">
        <a href={ruta(idioma, 'contacto')} class="cta">{apertura.cta}</a>
        <a href={ruta(idioma, 'precios')} class="enlace inline-flex min-h-11 items-center text-base underline underline-offset-4">{apertura.verPrecios}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Lugar para las colas de la y, la g y la j; el margen negativo lo compensa, así el interlineado es el mismo entre renglones y cuando una línea se parte sola */
  .mascara { overflow: hidden; padding-bottom: 0.22em; margin-bottom: -0.22em; }

  /* La línea y el botón llegan apenas después del título (0,45 s), no al final de su entrada */
  @media (prefers-reduced-motion: no-preference) {
    .entra {
      transform: translateY(105%);
      animation: sube 1.25s var(--ease-cine) forwards;
      animation-delay: calc(2.2s + var(--d) * 0.12s);
    }
    .entra-suave {
      opacity: 0;
      transform: translateY(12px);
      animation: aparece 0.7s var(--ease-cine) forwards;
      animation-delay: calc(2.65s + var(--d) * 0.1s);
    }
    :global(.ya-visto) .entra, :global(.loader-salteado) .entra { animation-delay: calc(0.2s + var(--d) * 0.14s); }
    :global(.ya-visto) .entra-suave, :global(.loader-salteado) .entra-suave { animation-delay: calc(0.65s + var(--d) * 0.1s); }
  }

  @keyframes sube { to { transform: translateY(0); } }
  @keyframes aparece { to { opacity: 1; transform: translateY(0); } }
</style>
