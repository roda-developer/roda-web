---
import { apertura } from '../content/guion';
---
<section id="inicio" class="plano !place-items-stretch" aria-labelledby="apertura-titulo">
  <div class="flex min-h-[calc(100svh-12rem)] flex-col justify-end gap-10 md:min-h-[calc(100svh-16rem)] md:gap-14">
    <h1 id="apertura-titulo" class="font-titulo text-[clamp(3.1rem,14.5vw,11.5rem)] leading-[0.88] tracking-[-0.025em]">
      <span class="mascara block"><span class="entra block" style="--d:0">{apertura.titulo[0]}</span></span>
      <span class="mascara block"><span class="entra block" style="--d:1">contando una <em class="text-tungsteno">historia.</em></span></span>
    </h1>
    <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
      <p class="entra-suave max-w-[22ch] text-xl leading-snug text-pantalla/80 md:text-2xl" style="--d:2">{apertura.bajada}</p>
      <p class="entra-suave flex items-center gap-4 text-[0.72rem] tracking-[0.28em] text-niebla uppercase" style="--d:3">
        <span class="guia" aria-hidden="true"></span>{apertura.promesa}
      </p>
    </div>
  </div>
</section>

<style>
  .mascara { overflow: hidden; padding-bottom: 0.06em; }

  @media (prefers-reduced-motion: no-preference) {
    .entra {
      transform: translateY(105%);
      animation: sube 1.25s var(--ease-cine) forwards;
      animation-delay: calc(1.75s + var(--d) * 0.12s);
    }
    .entra-suave {
      opacity: 0;
      animation: aparece 1.2s var(--ease-cine) forwards;
      animation-delay: calc(1.95s + var(--d) * 0.14s);
    }
    :global(.ya-visto) .entra { animation-delay: calc(0.2s + var(--d) * 0.14s); }
    :global(.ya-visto) .entra-suave { animation-delay: calc(0.35s + var(--d) * 0.16s); }
  }

  .guia {
    display: block;
    flex: none;
    width: 1px;
    height: 3.25rem;
    background: linear-gradient(var(--color-tungsteno), transparent);
    transform-origin: top;
    animation: guia 2.4s var(--ease-cine) infinite;
  }
  @media (prefers-reduced-motion: reduce) { .guia { animation: none; } }

  @keyframes sube { to { transform: translateY(0); } }
  @keyframes aparece { to { opacity: 1; } }
  @keyframes guia {
    0% { transform: scaleY(0); opacity: 1; }
    60% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }
</style>
