---
import { apertura } from '../content/guion';
---
<section id="inicio" class="plano !place-items-stretch" aria-labelledby="apertura-titulo">
  <div class="flex min-h-[calc(100svh-clamp(6rem,11svh,14rem))] flex-col justify-end gap-6 md:gap-[clamp(1.75rem,3.5svh,3.5rem)]">
    <h1 id="apertura-titulo" class="font-titulo text-[clamp(2.8rem,min(14.5vw,13.5svh),11.5rem)] leading-[0.88] tracking-[-0.045em]">
      <span class="mascara block"><span class="entra block" style="--d:0">{apertura.titulo[0]}</span></span>
      <span class="mascara block"><span class="entra block" style="--d:1">una <em>historia.</em></span></span>
    </h1>
    <div class="grid gap-6 border-t border-tinta/15 pt-4 md:grid-cols-[1fr_auto] md:items-start md:pt-5">
      <p class="entra-suave max-w-[22ch] text-lg leading-snug text-tinta/75 md:text-[clamp(1.15rem,2.2svh,1.5rem)]" style="--d:2">{apertura.bajada}</p>
    </div>
  </div>
</section>

<style>
  .mascara { overflow: hidden; padding-bottom: 0.06em; }

  @media (prefers-reduced-motion: no-preference) {
    .entra {
      transform: translateY(105%);
      animation: sube 1.25s var(--ease-cine) forwards;
      animation-delay: calc(2.4s + var(--d) * 0.12s);
    }
    .entra-suave {
      opacity: 0;
      animation: aparece 1.2s var(--ease-cine) forwards;
      animation-delay: calc(2.6s + var(--d) * 0.14s);
    }
    :global(.ya-visto) .entra, :global(.loader-salteado) .entra { animation-delay: calc(0.2s + var(--d) * 0.14s); }
    :global(.ya-visto) .entra-suave, :global(.loader-salteado) .entra-suave { animation-delay: calc(0.35s + var(--d) * 0.16s); }
  }

  @keyframes sube { to { transform: translateY(0); } }
  @keyframes aparece { to { opacity: 1; } }
</style>
