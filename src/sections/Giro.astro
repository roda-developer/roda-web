---
import { textos } from '../i18n';
const { giro, ui } = textos(Astro.currentLocale);

---
<section id="giro" class="giro relative h-[120svh]" aria-label={ui.giro} data-giro>
  <div class="sticky top-0 grid h-svh place-items-center px-5">
    <figure class="text-center">
      <blockquote class="cita font-titulo text-[clamp(3rem,min(16vw,13.5svh),12rem)] leading-[0.9] tracking-[-0.045em]">
        {giro.cita}
      </blockquote>
      <figcaption class="autor mono mt-6 text-gris md:mt-8">— {giro.autor}</figcaption>
    </figure>
    <p class="replica absolute right-5 bottom-[10svh] font-titulo text-[clamp(2.4rem,min(11vw,10svh),7.5rem)] italic md:right-[8vw]">
      {giro.replica}
    </p>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .giro { height: auto; }
    .giro > div { position: relative; height: auto; min-height: 100svh; gap: 3rem; padding-block: 8rem; }
    .replica { position: static; }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const giro = document.querySelector<HTMLElement>('[data-giro]');
  if (giro && movimientoPermitido()) {
    const q = gsap.utils.selector(giro);
    gsap.set(q('.replica'), { opacity: 0, y: 30, filter: 'blur(12px)' });
    gsap
      .timeline({ scrollTrigger: { trigger: giro, start: 'top 60%', end: 'bottom bottom', scrub: 0.8 } })
      .from(q('.cita'), { opacity: 0, filter: 'blur(14px)', duration: 1 })
      .from(q('.autor'), { opacity: 0, duration: 0.5 })
      // El silencio: una pausa larga donde no pasa nada.
      .to({}, { duration: 1.1 })
      .to(q('.cita, .autor'), { opacity: 0.25, duration: 0.6 })
      .to(q('.replica'), { opacity: 1, y: 0, filter: 'blur(0px)', duration: 0.8 }, '<')
      .to({}, { duration: 0.6 });
  }
</script>
