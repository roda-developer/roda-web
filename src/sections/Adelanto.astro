---
import { adelanto } from '../content/guion';
import Rotulo from '../components/Rotulo.astro';
import TiraProyectos from '../components/TiraProyectos.astro';
---
<section id="adelanto" class="adapta-fondo-rosa pb-24 md:pb-32" aria-labelledby="adelanto-titulo">
  <div class="px-5 pt-24 md:px-12 md:pt-32">
    <Rotulo rotulo={adelanto.rotulo} />
    <h2 id="adelanto-titulo" class="adapta-titulo mt-14 max-w-[14ch] font-titulo text-[clamp(2.8rem,11vw,7.5rem)] leading-[0.92] tracking-[-0.045em]" data-revelar>
      {adelanto.titulo}
    </h2>
  </div>

  <div class="mt-14 md:mt-20" data-revelar="6">
    <TiraProyectos />
  </div>

  <div class="mt-12 px-5 md:px-12">
    <a href="/proyectos" class="cta">{adelanto.verTodos}</a>
  </div>
</section>
