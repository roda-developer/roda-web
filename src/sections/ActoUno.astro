---
import { actoUno } from '../content/guion';
import { SITUACIONES } from '../story/opciones';
import Rotulo from '../components/Rotulo.astro';
import Eleccion from '../components/Eleccion.tsx';
const g = actoUno.generica;
---
<section id="acto-uno" aria-label="Acto uno: la primera impresión">
  <div class="plano !place-items-stretch !content-center">
    <div class="w-full space-y-16 md:space-y-24">
      <Rotulo rotulo={actoUno.rotulo} />
      <div class="max-w-4xl space-y-6">
        <p class="font-titulo text-[clamp(2.4rem,10vw,6rem)] leading-[0.98] tracking-[-0.045em]" data-revelar>{actoUno.lineas[0]}</p>
        <p class="font-titulo text-[clamp(2.4rem,10vw,6rem)] leading-[0.98] tracking-[-0.045em] text-tinta/45" data-revelar="6">{actoUno.lineas[1]}</p>
      </div>
      <p class="pr-4 text-right md:pr-0">
        <span class="block font-titulo text-[clamp(1.75rem,6.8vw,4.25rem)] leading-none tracking-[-0.045em] text-tinta/45" data-revelar>{actoUno.golpe[0]}</span>
        <span class="block font-titulo text-[clamp(6rem,36vw,22rem)] leading-[0.85] italic" data-revelar="8">{actoUno.golpe[1]}</span>
      </p>
    </div>
  </div>

  <!-- Lo que suele encontrar: una web genérica, con notas pegadas encima, mientras corren tres segundos -->
  <div class="secuencia relative h-[260svh]" data-secuencia-generica>
    <div class="escenario sticky top-0 flex h-svh flex-col overflow-hidden px-5 pt-24 pb-10 md:px-12 md:pt-28">
      <div class="flex items-start justify-between gap-6">
        <p class="encabezado font-titulo text-[clamp(1.6rem,5.5vw,3rem)] leading-none tracking-[-0.04em]">{actoUno.encuentra}</p>
        <p class="cuenta text-right" aria-hidden="true">
          <span class="cuenta-numeros font-titulo">
            <span class="numero">3</span><span class="numero">2</span><span class="numero">1</span><span class="numero">0</span>
          </span>
          <span class="mt-1 block max-w-[12ch] text-[clamp(1rem,2.4vw,1.35rem)] leading-tight tracking-[-0.02em] ml-auto text-tinta/55">{actoUno.cuenta}</span>
        </p>
      </div>

      <div class="relative grid flex-1 place-items-center">
        <div class="escena relative w-full max-w-[21rem] md:max-w-2xl">
          <div class="generica overflow-hidden rounded-xl bg-white text-[#333] shadow-[0_40px_80px_-30px_rgb(0_0_0/0.35)]" aria-hidden="true">
            <div class="flex items-center justify-between border-b border-black/10 px-4 py-3 text-[11px] md:px-6">
              <span class="font-bold text-[#1e3a8a]">{g.marca}</span>
              <span class="hidden gap-4 text-black/60 md:flex"><span>Inicio</span><span>Nosotros</span><span>Servicios</span><span>Contacto</span></span>
              <span class="text-black/60 md:hidden">☰</span>
            </div>
            <div class="stock relative grid h-36 place-items-center bg-gradient-to-br from-sky-300 via-sky-200 to-emerald-200 md:h-60">
              <svg viewBox="0 0 120 60" class="w-36 opacity-70 md:w-60"><circle cx="92" cy="16" r="8" fill="#fde68a"/><path d="M0 60 L35 22 L55 42 L75 18 L120 60 Z" fill="#34d399"/><path d="M0 60 L25 38 L50 60 Z" fill="#059669"/></svg>
            </div>
            <div class="space-y-3 px-5 py-6 text-center md:px-10 md:py-8">
              <p class="text-lg font-bold md:text-2xl">{g.titulo}</p>
              <p class="text-xs leading-relaxed text-black/55 md:text-sm">{g.texto}</p>
              <span class="boton-generico inline-block rounded bg-[#3b82f6] px-5 py-2 text-xs font-semibold text-white">{g.boton}</span>
            </div>
          </div>

          <!-- Las notas, pegadas sobre cada parte: menú, foto, botón -->
          <ol class="notas">
            {actoUno.notas.map((n, i) => (
              <li class={`nota nota-${i + 1}`}><span class="mono nota-n" aria-hidden="true">({String(i + 1).padStart(2, '0')})</span> {n}</li>
            ))}
          </ol>
        </div>
        <p class="se-va pointer-events-none absolute inset-0 grid place-items-center font-titulo text-[clamp(3.5rem,16vw,12rem)] leading-none italic">{actoUno.cierre[0]}</p>
      </div>
    </div>
  </div>

  <div class="plano !place-items-start !content-center">
    <p class="max-w-5xl font-titulo text-[clamp(2.4rem,10vw,7rem)] leading-[0.98] tracking-[-0.045em]">
      <span class="block text-tinta/45" data-revelar>{actoUno.cierre[1]}</span>
      <span class="block" data-revelar="10">Perdiste un <em>cliente.</em></span>
    </p>
  </div>

  <div class="plano !pt-0">
    <div data-revelar class="w-full max-w-3xl">
      <Eleccion client:idle clave="situacion" numero={1} pregunta={actoUno.pregunta} opciones={SITUACIONES} />
    </div>
  </div>
</section>

<style>
  /* Las notas: etiquetas negras, legibles, pegadas un poco torcidas sobre la parte que señalan */
  .nota {
    position: absolute;
    z-index: 2;
    max-width: 17rem;
    padding: 0.55rem 0.8rem;
    background: var(--color-tinta);
    color: var(--color-papel);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    box-shadow: 0 14px 30px -12px rgb(0 0 0 / 0.5);
  }
  @media (min-width: 768px) { .nota { font-size: 1.3rem; max-width: 22rem; padding: 0.7rem 1rem; } }
  .nota-n { opacity: 0.6; }
  .nota-1 { top: -1.4rem; right: -0.5rem; rotate: 2deg; }
  .nota-2 { top: 38%; left: -0.75rem; rotate: -2.5deg; }
  .nota-3 { bottom: -1.2rem; right: -0.5rem; rotate: 1.5deg; }
  @media (min-width: 768px) {
    .nota-1 { right: -3rem; }
    .nota-2 { left: -3rem; }
    .nota-3 { right: -2rem; }
  }

  .cuenta-numeros {
    display: grid;
    font-size: clamp(3.5rem, 13vw, 7rem);
    line-height: 0.85;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }
  .numero { grid-area: 1 / 1; }
  .numero:not(:first-child) { visibility: hidden; }

  /* Sin movimiento: se ve todo junto, la web ya apagada con sus notas */
  @media (prefers-reduced-motion: reduce) {
    .secuencia { height: auto; }
    .escenario { position: relative; height: auto; gap: 3rem; padding-block: 6rem; }
    .generica { filter: grayscale(1); }
    .cuenta { display: none; }
    .se-va { position: static; }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const secuencia = document.querySelector<HTMLElement>('[data-secuencia-generica]');
  if (secuencia && movimientoPermitido()) {
    const q = gsap.utils.selector(secuencia);
    const notas = q('.nota');
    const numeros = q('.numero');
    gsap.set(notas, { autoAlpha: 0, scale: 1.25 });
    gsap.set(q('.se-va'), { autoAlpha: 0 });
    gsap.set(numeros, { visibility: 'visible', autoAlpha: 0 });
    gsap.set(numeros[0], { autoAlpha: 1 });

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: secuencia, start: 'top top', end: 'bottom bottom', scrub: 0.5 },
    });
    // Llega la web
    tl.from(q('.escena'), { y: 60, autoAlpha: 0, scale: 0.92, duration: 0.5 });
    // Cada segundo, una nota pegada encima y un poco menos de color
    const pasos = [q('.generica > div:first-child'), q('.stock'), q('.boton-generico')];
    notas.forEach((nota, i) => {
      tl.to(nota, { autoAlpha: 1, scale: 1, duration: 0.25, ease: 'back.out(2)' })
        .to(pasos[i], { filter: 'grayscale(1)', duration: 0.4 }, '<')
        .to(numeros[i], { autoAlpha: 0, duration: 0.1 }, '+=0.35')
        .to(numeros[i + 1], { autoAlpha: 1, duration: 0.1 }, '<');
    });
    // Cero: vuelve atrás. La web se va de costado y queda la frase.
    tl.to(q('.escena'), { xPercent: -140, rotate: -6, autoAlpha: 0, duration: 0.7, ease: 'power2.in' }, '+=0.2')
      .to(q('.se-va'), { autoAlpha: 1, duration: 0.4 }, '-=0.15')
      .to({}, { duration: 0.4 });
  }
</script>
