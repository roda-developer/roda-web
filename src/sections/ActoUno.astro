---
import { actoUno } from '../content/guion';
import { SITUACIONES } from '../story/opciones';
import Rotulo from '../components/Rotulo.astro';
import Eleccion from '../components/Eleccion.tsx';
const g = actoUno.generica;
---
<section id="acto-uno" aria-label="Acto uno: la primera impresión">
  <div class="plano !place-items-start !content-center gap-10">
    <Rotulo texto={actoUno.rotulo} />
    <div class="max-w-4xl space-y-6">
      <p class="font-titulo text-[clamp(2.4rem,10vw,6rem)] leading-[0.98] tracking-[-0.02em]" data-revelar>{actoUno.lineas[0]}</p>
      <p class="font-titulo text-[clamp(2.4rem,10vw,6rem)] leading-[0.98] tracking-[-0.02em] text-pantalla/55" data-revelar="6">{actoUno.lineas[1]}</p>
    </div>
  </div>

  <div class="plano">
    <p class="text-center">
      <span class="block text-xl tracking-[0.3em] text-niebla uppercase" data-revelar>{actoUno.golpe[0]}</span>
      <span class="block font-titulo text-[clamp(7rem,42vw,26rem)] leading-[0.85] italic" data-revelar="8">{actoUno.golpe[1]}</span>
    </p>
  </div>

  <!-- La web genérica: se apaga mientras el visitante la mira -->
  <div class="secuencia relative h-[290svh]" data-secuencia-generica>
    <div class="sticky top-0 grid h-svh place-items-center overflow-hidden px-5">
      <div class="generica w-full max-w-[22rem] overflow-hidden rounded-xl bg-white text-[#333] shadow-2xl md:max-w-2xl" aria-hidden="true">
        <div class="flex items-center justify-between border-b border-black/10 px-4 py-3 text-[11px] md:px-6">
          <span class="font-bold text-[#1e3a8a]">{g.marca}</span>
          <span class="hidden gap-4 text-black/60 md:flex"><span>Inicio</span><span>Nosotros</span><span>Servicios</span><span>Contacto</span></span>
          <span class="text-black/60 md:hidden">☰</span>
        </div>
        <div class="stock relative grid h-40 place-items-center bg-gradient-to-br from-sky-300 via-sky-200 to-emerald-200 md:h-64">
          <svg viewBox="0 0 120 60" class="w-40 opacity-70 md:w-64"><circle cx="92" cy="16" r="8" fill="#fde68a"/><path d="M0 60 L35 22 L55 42 L75 18 L120 60 Z" fill="#34d399"/><path d="M0 60 L25 38 L50 60 Z" fill="#059669"/></svg>
        </div>
        <div class="space-y-3 px-5 py-6 text-center md:px-10 md:py-9">
          <p class="text-lg font-bold md:text-2xl">{g.titulo}</p>
          <p class="text-xs leading-relaxed text-black/55 md:text-sm">{g.texto}</p>
          <span class="boton-generico inline-block rounded bg-[#3b82f6] px-5 py-2 text-xs font-semibold text-white">{g.boton}</span>
        </div>
      </div>

      <ul class="pies pointer-events-none absolute inset-x-5 bottom-[12svh] space-y-1 text-center font-titulo text-3xl italic md:text-5xl">
        {actoUno.pies.map((p) => <li class="pie">{p}</li>)}
      </ul>
      <p class="se-va pointer-events-none absolute inset-0 grid place-items-center font-titulo text-[clamp(3.5rem,16vw,12rem)] leading-none">{actoUno.cierre[0]}</p>
    </div>
  </div>

  <div class="plano !place-items-start !content-center">
    <p class="max-w-5xl font-titulo text-[clamp(2.4rem,10vw,7rem)] leading-[0.98] tracking-[-0.02em]">
      <span class="block text-pantalla/55" data-revelar>{actoUno.cierre[1]}</span>
      <span class="block" data-revelar="10">Perdiste un <em class="text-tungsteno">cliente.</em></span>
    </p>
  </div>

  <div class="plano">
    <div data-revelar class="w-full max-w-3xl">
      <Eleccion client:idle clave="situacion" numero={1} pregunta={actoUno.pregunta} opciones={SITUACIONES} />
    </div>
  </div>
</section>

<style>
  /* Sin movimiento: se ve la web ya apagada, con sus tres pies de foto. */
  @media (prefers-reduced-motion: reduce) {
    .secuencia { height: auto; }
    .secuencia > div { position: relative; height: auto; padding-block: 6rem; display: flex; flex-direction: column; gap: 2rem; }
    .generica { filter: grayscale(1) brightness(0.8); }
    .pies, .se-va { position: static; }
  }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  const secuencia = document.querySelector<HTMLElement>('[data-secuencia-generica]');
  if (secuencia && movimientoPermitido()) {
    const q = gsap.utils.selector(secuencia);
    gsap.set(q('.pie'), { opacity: 0, y: 20 });
    gsap.set(q('.se-va'), { opacity: 0 });
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: secuencia, start: 'top 70%', end: 'bottom bottom', scrub: 0.6 },
    });
    tl.from(q('.generica'), { scale: 0.86, opacity: 0, duration: 0.6 })
      .to(q('.pie')[0], { opacity: 1, y: 0, duration: 0.5 })
      .to(q('.stock'), { filter: 'grayscale(1)', duration: 1 }, '<')
      .to(q('.pie')[1], { opacity: 1, y: 0, duration: 0.5 })
      .to(q('.boton-generico'), { filter: 'grayscale(1)', duration: 0.8 }, '<')
      .to(q('.pie')[2], { opacity: 1, y: 0, duration: 0.5 })
      .to(q('.generica'), { filter: 'grayscale(1) brightness(0.35)', duration: 1 })
      .to(q('.pies'), { opacity: 0, duration: 0.5 })
      .to(q('.generica'), { scale: 0.6, opacity: 0, y: -60, duration: 1.2 }, '<')
      .to(q('.se-va'), { opacity: 1, duration: 0.8 })
      .to({}, { duration: 0.6 });
  }
</script>
