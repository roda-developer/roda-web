---
/**
 * La home: la O (que se abre a Estudio), la galería de trabajos, por qué no funcionan la mayoría de las webs,
 * por qué Roda, lo que dicen los clientes, cómo trabajamos y el final.
 * hero: 'o' (la principal) o 'linterna' (la segunda opción, se ve en /prueba-linterna para comparar).
 */
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Portal from '../sections/Portal.astro';
import Linterna from '../sections/Linterna.astro';
import Estudio from '../sections/Estudio.astro';
import Galeria from '../sections/Galeria.astro';
import Gente from '../sections/Gente.astro';
import PorQue from '../sections/PorQue.astro';
import Testimonios from '../sections/Testimonios.astro';
import Niveles from '../sections/Niveles.astro';
import Final from '../sections/Final.astro';
import Pie from '../components/Pie.astro';

interface Props {
  hero?: 'o' | 'linterna';
  /** false en las páginas de prueba: Google no las guarda */
  indexable?: boolean;
}
const { hero = 'o', indexable = true } = Astro.props;
---
<Base indexable={indexable}>
  <Nav />
  <main id="contenido" class="relative z-10">
    {hero === 'linterna' ? <><Linterna /><Estudio /></> : <Portal />}
    <Galeria />
    <Gente />
    <PorQue />
    <Testimonios />
    <Niveles />
    <Final />
  </main>
  <Pie />
  <Motion />
</Base>
