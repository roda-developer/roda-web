---
/**
 * La home: la O (que se abre a Estudio), la galería de trabajos, lo que dicen los clientes, cómo trabajamos,
 * probá una (tres webs reales funcionando, para el que todavía duda) y el final.
 */
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Portal from '../sections/Portal.astro';
import Galeria from '../sections/Galeria.astro';
import Probar from '../sections/Probar.astro';
import Criticas from '../components/Criticas.astro';
import { testimoniosEn } from '../content/proyectos';
import { idiomaDe } from '../i18n';
import Niveles from '../sections/Niveles.astro';
import Final from '../sections/Final.astro';
import Pie from '../components/Pie.astro';

const testimonios = testimoniosEn(idiomaDe(Astro.currentLocale));
---
<Base>
  <Nav />
  <main id="contenido" class="relative z-10">
    <Portal />
    <Galeria />
    {testimonios.length > 0 && <div class="testimonios"><Criticas testimonios={testimonios} /></div>}
    <Niveles />
    <Probar />
    <Final />
  </main>
  <Pie corto />
  <Motion />
</Base>

<style>
  /* Los mismos márgenes que el resto de las secciones de la home */
  .testimonios { padding: clamp(6rem, 16svh, 11rem) 1.25rem 0; }
  @media (min-width: 768px) { .testimonios { padding-inline: clamp(1.5rem, 3.5vw, 3rem); } }
</style>
