---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Pie from '../components/Pie.astro';
import { proyectosEn } from '../content/proyectos';
import { capturas } from '../content/capturas';
import { idiomaDe, rellenar, ruta, textos } from '../i18n';
import juntos from '../assets/nosotros/juntos.jpg';
const idioma = idiomaDe(Astro.currentLocale);
const { nosotros: t, metas, ui, inicio } = textos(idioma);
const link = ruta(idioma, 'contacto');
const [giuli, facu] = t.equipo.personas;

// Cuatro trabajos que se vean bien distintos entre sí; el resto está en /proyectos
const proyectos = proyectosEn(idioma);
const elegidos = ['emme', 'craft', 'eber', 'newave'].flatMap((slug) => proyectos.filter((p) => p.slug === slug));
---
<Base titulo={metas.nosotros.titulo} descripcion={metas.nosotros.descripcion}>
  <Nav enHome={false} actual="nosotros" />
  <main class="relative z-10">
    <!-- La apertura, como la de la home: el texto arriba y la palabra de borde a borde, apoyada abajo -->
    <section class="apertura" aria-labelledby="sobre-titulo">
      <p class="bajada" data-revelar="2">{t.bajada}</p>
      <h1 id="sobre-titulo" class="palabra font-titulo" data-revelar>{t.grande}</h1>
    </section>

    <!-- La foto se abre desde un círculo al bajar, como la O de la home. Cada nombre, del lado donde está en la foto -->
    <section class="pareja" data-pareja aria-label={t.equipo.titulo}>
      <div class="persona persona-izq" data-revelar>
        <p class="nombre font-titulo">{facu.nombre}</p>
        <p class="rol">{facu.rol}</p>
      </div>
      <figure class="foto">
        <Image src={juntos} alt={t.foto.alt} widths={[640, 1080, 1600]} sizes="(min-width: 900px) 40vw, 100vw" quality={90} loading="eager" data-foto-o />
      </figure>
      <div class="persona persona-der" data-revelar>
        <p class="nombre font-titulo">{giuli.nombre}</p>
        <p class="rol">{giuli.rol}</p>
      </div>
    </section>

    <section class="bloque" aria-labelledby="proceso-titulo">
      <h2 id="proceso-titulo" class="etiqueta font-titulo" data-revelar>{t.proceso}</h2>
      <p class="parrafo" data-revelar="2">{inicio.niveles.proceso}</p>
    </section>

    <section class="hechas" aria-labelledby="hechas-titulo">
      <div class="bloque bloque-sin-aire">
        <h2 id="hechas-titulo" class="etiqueta font-titulo" data-revelar>{t.hicimos.titulo}</h2>
        <p class="parrafo" data-revelar="2">{rellenar(t.hicimos.texto, { n: proyectos.length }).replace(/:$/, '.')}</p>
      </div>
      <ul class="hechas-fila">
        {elegidos.map((p) => {
          const { mockup } = capturas(p.slug);
          return mockup && (
            <li data-revelar>
              <a href={ruta(idioma, 'proyectos', p.slug)} class="hecha">
                <Image src={mockup} alt="" widths={[320, 480, 800]} sizes="(min-width: 768px) 24vw, 45vw" quality={84} loading="lazy" />
                <span>{p.titulo}</span>
              </a>
            </li>
          );
        })}
      </ul>
      <a href={ruta(idioma, 'proyectos')} class="ver-todos" data-revelar>{t.hicimos.verTodos}</a>
    </section>

    <!-- El cierre: la pregunta y el botón -->
    <section class="flex flex-col items-center gap-10 px-5 py-28 text-center md:py-40" aria-label={ui.contacto}>
      <p class="font-titulo text-[clamp(2.8rem,9vw,6.5rem)] leading-[0.92] tracking-[-0.01em]">
        {t.filmamos[0]}<br />{t.filmamos[1]}
      </p>
      <a href={link} class="cta">{t.cta}</a>
    </section>
  </main>
  <Pie corto />
  <Motion />
</Base>

<style>
  /* La apertura: en compu ocupa casi toda la pantalla; la palabra entra justa de borde a borde */
  .apertura { display: flex; flex-direction: column; justify-content: flex-end; gap: clamp(1.5rem, 4svh, 2.5rem); min-height: 62svh; padding: 6.5rem 1.25rem 0; overflow: hidden; }
  .bajada { max-width: 34ch; font-size: clamp(1.25rem, 1.9vw, 1.75rem); line-height: 1.32; font-weight: 500; letter-spacing: -0.01em; }
  /* NOSOTROS mide 3,235 veces su tamaño de letra: así llena justo el ancho entre márgenes */
  .palabra { font-size: calc((100vw - 2.5rem) / 3.235); font-weight: 800; line-height: 0.8; white-space: nowrap; }
  @media (min-width: 768px) {
    .apertura { min-height: calc(100svh - 2rem); padding-inline: clamp(1.5rem, 3.5vw, 3rem); }
    .palabra { font-size: calc((100vw - 2 * clamp(1.5rem, 3.5vw, 3rem)) / 3.235); }
  }

  /* La foto entera, con un nombre a cada lado */
  .pareja { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; padding: clamp(3rem, 8svh, 5rem) 1.25rem 0; }
  .foto { grid-column: 1 / -1; grid-row: 1; margin: 0; }
  .foto :global(img) { display: block; width: 100%; height: auto; }
  .nombre { font-size: clamp(3rem, 7.5vw, 7rem); line-height: 0.88; }
  .rol { margin-top: 0.5rem; max-width: 22ch; font-size: 1.0625rem; line-height: 1.35; }
  @media (min-width: 900px) {
    .pareja { grid-template-columns: minmax(0, 1fr) min(40vw, calc((100svh - 4rem) * 2240 / 3382)) minmax(0, 1fr); column-gap: clamp(1.5rem, 3vw, 3rem); align-items: center; padding-inline: clamp(1.5rem, 3.5vw, 3rem); }
    .foto { grid-column: 2; }
    .persona-der { grid-column: 3; grid-row: 1; }
    .persona-izq { grid-column: 1; grid-row: 1; text-align: right; justify-self: end; }
    .persona-izq .rol { margin-left: auto; }
  }

  /* Los bloques de texto: la misma grilla que los proyectos */
  .bloque { display: grid; gap: 1rem; padding: clamp(5rem, 12svh, 8rem) 1.25rem 0; }
  .bloque-sin-aire { padding: 0; }
  .etiqueta { font-size: clamp(2.4rem, 4vw, 3.5rem); line-height: 0.92; }
  .parrafo { max-width: 40rem; font-size: clamp(1.25rem, 1.9vw, 1.75rem); line-height: 1.32; font-weight: 500; letter-spacing: -0.01em; }
  @media (min-width: 900px) {
    .bloque { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.5rem; align-items: start; padding-inline: clamp(1.5rem, 3.5vw, 3rem); }
    .bloque-sin-aire { padding-inline: 0; }
    .etiqueta { grid-column: 1 / span 5; }
    .parrafo { grid-column: 6 / span 7; }
  }

  /* Lo que ya hicimos: cuatro mockups, enteros */
  .hechas { display: grid; gap: 2rem; justify-items: start; padding: clamp(5rem, 12svh, 8rem) 1.25rem 0; }
  .hechas > .bloque { width: 100%; }
  .hechas-fila { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem 1rem; width: 100%; }
  .hecha { display: grid; gap: 0.6rem; font-size: 1.0625rem; font-weight: 500; }
  .hecha :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1136 / 1408; transition: transform 250ms var(--ease-ui); }
  .hecha:active :global(img) { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) { .hecha:hover :global(img) { transform: translateY(-6px); } }
  .ver-todos { display: inline-flex; min-height: 2.75rem; align-items: center; font-size: 1.0625rem; text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 900px) {
    .hechas { padding-inline: clamp(1.5rem, 3.5vw, 3rem); }
    .hechas-fila { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .hecha :global(img) { transition: none; } }
</style>

<script>
  import { gsap, movimientoPermitido } from '../motion/index';

  // La foto se abre desde un círculo a medida que bajás. Sin movimiento o sin JS, se ve entera
  const seccion = document.querySelector<HTMLElement>('[data-pareja]');
  const foto = seccion?.querySelector<HTMLElement>('[data-foto-o]');
  if (seccion && foto && movimientoPermitido()) {
    gsap.fromTo(foto, { clipPath: 'circle(16% at 50% 45%)' }, {
      clipPath: 'circle(75% at 50% 45%)',
      ease: 'none',
      scrollTrigger: { trigger: seccion, start: 'top 85%', end: 'top 15%', scrub: 0.5 },
    });
  }
</script>
