---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Pie from '../components/Pie.astro';
import Criticas from '../components/Criticas.astro';
import { proyectosEn } from '../content/proyectos';
import { idiomaDe, rellenar, ruta, textos } from '../i18n';
import juntos from '../assets/nosotros/juntos.jpg';
const idioma = idiomaDe(Astro.currentLocale);
const { nosotros: t, metas, ui } = textos(idioma);
const link = ruta(idioma, 'contacto');

// Lo que ya hicimos: las webs de /proyectos y los testimonios reales de sus clientes
const proyectos = proyectosEn(idioma);
const testimonios = proyectos.flatMap((p) => p.testimonios ?? []);

---
<Base titulo={metas.nosotros.titulo} descripcion={metas.nosotros.descripcion}>
  <Nav enHome={false} actual="nosotros" />
  <main class="relative z-10">
    <!-- Nosotros, como la página de un libro: la palabra gigante y la foto que se le cruza -->
    <section class="sobre px-5 pt-24 md:px-12 md:pt-32" aria-labelledby="sobre-titulo">
      <h1 id="sobre-titulo" class="palabra font-titulo" data-revelar>{t.grande}</h1>
      <div class="cuerpo">
        <figure class="foto" data-revelar="4">
          <Image src={juntos} alt={t.foto.alt} widths={[640, 1080, 1600]} sizes="(min-width: 768px) 40vw, 80vw" quality={90} />
        </figure>
        <div class="textos" data-revelar="6">
          <p class="text-lg leading-relaxed md:text-xl">{t.bajada}</p>
          <!-- Primero lo que hicimos: las webs publicadas, cada una con su caso -->
          <h2 class="mt-10 text-xl font-medium tracking-[-0.02em] md:text-2xl">{t.hicimos.titulo}</h2>
          <p class="mt-3 text-lg leading-relaxed md:text-xl">{rellenar(t.hicimos.texto, { n: proyectos.length })}</p>
          <ul class="hicimos mt-4">
            {proyectos.map((p) => (
              <li><a href={ruta(idioma, 'proyectos', p.slug)} class="underline underline-offset-4">{p.titulo}</a></li>
            ))}
          </ul>
          <a href={ruta(idioma, 'proyectos')} class="cta mt-8">{t.hicimos.verTodos}</a>
        </div>
      </div>
    </section>

    {testimonios.length > 0 && (
      <div class="mt-24 px-5 md:mt-32 md:px-12">
        <Criticas testimonios={testimonios} />
      </div>
    )}

    <!-- La formación, después de lo que hicimos. En compu, el título a la izquierda y cada uno en su columna: así no queda media pantalla vacía -->
    <section class="mt-24 px-5 md:mt-32 md:px-12" aria-labelledby="formacion-titulo">
      <div class="grid gap-5 border-t border-tinta/15 pt-6 md:grid-cols-[1fr_1fr_1fr] md:gap-10">
        <h2 id="formacion-titulo" class="text-xl font-medium tracking-[-0.02em] md:text-2xl" data-revelar>{t.formacion}</h2>
        {t.personas.map((p) => (
          <p class="max-w-[42ch] text-lg leading-relaxed md:text-xl" data-revelar><strong class="font-medium">{p.nombre}.</strong> {p.texto}</p>
        ))}
      </div>
    </section>

    <!-- Los créditos, en rosa -->
    <section class="creditos mt-24 md:mt-32" aria-labelledby="creditos-titulo">
      <h2 id="creditos-titulo" class="mono text-center">Roda</h2>
      <dl class="rollo">
        {t.creditos.map(([rol, quien]) => (
          <div><dt>{rol}</dt><dd>{quien}</dd></div>
        ))}
      </dl>
      <p class="aviso">{t.aviso}</p>
    </section>

    <!-- El cierre: la pregunta y el botón -->
    <section class="flex flex-col items-center gap-10 px-5 py-28 text-center md:py-40" aria-label={ui.contacto}>
      <p class="font-titulo text-[clamp(2.8rem,9vw,6.5rem)] leading-[0.92] tracking-[-0.01em]">
        {t.filmamos[0]}<br />{t.filmamos[1]}
      </p>
      <a href={link} class="cta">{t.cta}</a>
    </section>
  </main>
  <Pie corto />
  <Motion />
</Base>

<style>
  /* Las webs que hicimos: una lista corta, de a dos columnas */
  .hicimos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.25rem 1.5rem; font-size: 1.125rem; }
  .hicimos a { display: inline-flex; align-items: center; min-height: 2.75rem; }

  /* ── Nosotros: la palabra gigante y la foto que se le cruza ───── */
  .sobre .mono { color: var(--color-gris); }
  .palabra {
    margin-top: 1rem;
    font-size: 27vw;
    line-height: 0.8;
    text-align: center;
  }
  .cuerpo { display: grid; gap: 2.5rem; margin-top: -6vw; }
  .foto { position: relative; z-index: 1; width: 78%; margin: 0; }
  .foto :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 35%; }
  @media (min-width: 768px) {
    .cuerpo { grid-template-columns: 0.9fr 1fr; gap: 4rem; align-items: end; padding-inline: 2vw; margin-top: -9vw; }
    .foto { width: 100%; }
    .textos { max-width: 38ch; }
  }


  /* ── Los créditos ─────────────────────────────────────────────── */
  .creditos { background: var(--color-tc-rosa); color: var(--color-tinta); padding: 5rem 1.25rem; }
  .rollo { display: grid; gap: 1.6rem; max-width: 46rem; margin: 3rem auto 0; }
  /* Cada crédito, centrado: el rol arriba y el nombre abajo */
  .rollo div { display: grid; gap: 0.2rem; text-align: center; }
  .rollo dt { font-style: italic; font-size: clamp(0.95rem, 2vw, 1.15rem); }
  .rollo dd { margin: 0; font-weight: 600; font-size: clamp(0.95rem, 2vw, 1.15rem); }
  .aviso { margin-top: 3.5rem; text-align: center; font-style: italic; }
</style>
