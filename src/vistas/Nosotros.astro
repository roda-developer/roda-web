---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Pie from '../components/Pie.astro';
import Criticas from '../components/Criticas.astro';
import { proyectosEn, testimoniosEn } from '../content/proyectos';
import { idiomaDe, rellenar, ruta, textos } from '../i18n';
import juntos from '../assets/nosotros/juntos.jpg';
import giuliPix from '../assets/nosotros/giuli-pix.png';
import facuPix from '../assets/nosotros/facu-pix.png';
// Los retratos en píxeles (scripts/pixelar-retratos.mjs), en el orden de t.equipo.personas
const retratos = [giuliPix, facuPix];
const idioma = idiomaDe(Astro.currentLocale);
const { nosotros: t, metas, ui } = textos(idioma);
const link = ruta(idioma, 'contacto');

// Lo que ya hicimos: las webs de /proyectos y los testimonios reales de sus clientes
const proyectos = proyectosEn(idioma);
const testimonios = testimoniosEn(idioma);

---
<Base titulo={metas.nosotros.titulo} descripcion={metas.nosotros.descripcion}>
  <Nav enHome={false} actual="nosotros" />
  <main class="relative z-10">
    <!-- Nosotros, como la página de un libro: la palabra gigante y la foto que se le cruza -->
    <section class="sobre px-5 pt-24 md:px-12 md:pt-32" aria-labelledby="sobre-titulo">
      <h1 id="sobre-titulo" class="palabra font-titulo" data-revelar>{t.grande}</h1>
      <div class="cuerpo">
        <figure class="foto" data-revelar="4">
          <Image src={juntos} alt={t.foto.alt} widths={[640, 1080, 1600]} sizes="(min-width: 768px) 40vw, 80vw" quality={90} />
        </figure>
        <div class="textos" data-revelar="6">
          <p class="text-lg leading-relaxed md:text-xl">{t.bajada}</p>
          <!-- Primero lo que hicimos: las webs publicadas, cada una con su caso -->
          <h2 class="mt-10 text-xl font-medium tracking-[-0.02em] md:text-2xl">{t.hicimos.titulo}</h2>
          <p class="mt-3 text-lg leading-relaxed md:text-xl">{rellenar(t.hicimos.texto, { n: proyectos.length })}</p>
          <ul class="hicimos mt-4">
            {proyectos.map((p) => (
              <li><a href={ruta(idioma, 'proyectos', p.slug)} class="underline underline-offset-4">{p.titulo}</a></li>
            ))}
          </ul>
          <a href={ruta(idioma, 'proyectos')} class="cta mt-8">{t.hicimos.verTodos}</a>
        </div>
      </div>
    </section>

    {testimonios.length > 0 && (
      <div class="mt-24 px-5 md:mt-32 md:px-12">
        <Criticas testimonios={testimonios} />
      </div>
    )}

    <!-- Quiénes somos: Giuli y Facu en píxeles, el mismo lenguaje del video de Estudio y del cierre de la home -->
    <section class="equipo mt-24 px-5 md:mt-32 md:px-12" aria-labelledby="equipo-titulo">
      <h2 id="equipo-titulo" class="equipo-titulo font-titulo" data-revelar>{t.equipo.titulo}</h2>
      <ul class="retratos">
        {t.equipo.personas.map((p, i) => (
          <li class="retrato" data-revelar={String(i * 3)}>
            <Image src={retratos[i]} alt={p.alt} widths={[480, 900]} sizes="(min-width: 768px) 44vw, 90vw" format="png" loading="lazy" class="retrato-foto" />
            <p class="retrato-nombre font-titulo">{p.nombre}</p>
            <p class="retrato-rol">{p.rol}</p>
            <p class="retrato-texto">{p.texto}</p>
          </li>
        ))}
      </ul>
      <p class="equipo-aviso">{t.equipo.aviso}</p>
    </section>

    <!-- El cierre: la pregunta y el botón -->
    <section class="flex flex-col items-center gap-10 px-5 py-28 text-center md:py-40" aria-label={ui.contacto}>
      <p class="font-titulo text-[clamp(2.8rem,9vw,6.5rem)] leading-[0.92] tracking-[-0.01em]">
        {t.filmamos[0]}<br />{t.filmamos[1]}
      </p>
      <a href={link} class="cta">{t.cta}</a>
    </section>
  </main>
  <Pie corto />
  <Motion />
</Base>

<style>
  /* Las webs que hicimos: una lista corta, de a dos columnas */
  .hicimos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.25rem 1.5rem; font-size: 1.125rem; }
  .hicimos a { display: inline-flex; align-items: center; min-height: 2.75rem; }

  /* ── Nosotros: la palabra gigante y la foto que se le cruza ───── */
  .sobre .mono { color: var(--color-gris); }
  .palabra {
    margin-top: 1rem;
    font-size: 27vw;
    line-height: 0.8;
    text-align: center;
  }
  .cuerpo { display: grid; gap: 2.5rem; margin-top: -6vw; }
  .foto { position: relative; z-index: 1; width: 78%; margin: 0; }
  .foto :global(img) { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 35%; }
  @media (min-width: 768px) {
    .cuerpo { grid-template-columns: 0.9fr 1fr; gap: 4rem; align-items: end; padding-inline: 2vw; margin-top: -9vw; }
    .foto { width: 100%; }
    .textos { max-width: 38ch; }
  }


  /* ── Quiénes somos ─────────────────────────────────────────────── */
  .equipo-titulo { font-size: clamp(2.8rem, 7vw, 6rem); line-height: 0.9; }
  .retratos { display: grid; gap: 3rem; margin-top: 2.5rem; }
  /* Los dos perfiles del mismo ancho, con un espacio parejo entre ellos */
  @media (min-width: 768px) { .retratos { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(2rem, 4vw, 4rem); } }
  /* En compu, el título a la izquierda y los perfiles en el resto del ancho: así no queda un costado vacío */
  @media (min-width: 1024px) {
    .equipo { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr); column-gap: clamp(2rem, 4vw, 4rem); align-items: start; }
    .equipo-titulo { position: sticky; top: 7rem; max-width: 6ch; }
    .retratos { margin-top: 0; }
    .equipo-aviso { grid-column: 2; }
  }
  .retrato :global(.retrato-foto) { width: 100%; height: auto; aspect-ratio: 1; border-radius: 6px; }
  @media (max-width: 767px) { .retrato :global(.retrato-foto) { max-width: 26rem; } }
  .retrato-nombre { margin-top: 1.25rem; font-size: clamp(2.6rem, 5vw, 4.2rem); line-height: 0.9; text-transform: uppercase; }
  .retrato-rol { margin-top: 0.4rem; font-weight: 600; font-size: 1.0625rem; }
  .retrato-texto { margin-top: 0.5rem; max-width: 40ch; font-size: 1.125rem; line-height: 1.45; }
  .equipo-aviso { margin-top: 2.5rem; font-size: 1.125rem; color: var(--color-gris); }
</style>
