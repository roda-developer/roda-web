---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Pie from '../components/Pie.astro';
import Creativos from '../components/Creativos.astro';
import { AFICHES, aficheDe, nombreVt } from '../components/afiches/mapa';
import { capturas } from '../content/capturas';
import { proyectosEn } from '../content/proyectos';
import { idiomaDe, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { proyectosPagina: t, metas, inicio } = textos(idioma);
const PROYECTOS = proyectosEn(idioma);

const orden = Object.keys(AFICHES);
// Los cargados desde el admin no están en AFICHES: van primero, con el afiche genérico
const cartelera = [...PROYECTOS].sort((a, b) => orden.indexOf(a.slug) - orden.indexOf(b.slug));

// La fila escalonada: cada afiche con su alto (parte del alto de la fila) y cuánto baja desde arriba.
// Se repite cada ocho, así nunca quedan dos iguales al lado.
const RITMO = [
  { alto: 0.72, baja: 0.16 },
  { alto: 1, baja: 0 },
  { alto: 0.64, baja: 0.08 },
  { alto: 0.86, baja: 0.14 },
  { alto: 0.7, baja: 0.02 },
  { alto: 0.94, baja: 0.06 },
  { alto: 0.62, baja: 0.3 },
  { alto: 0.84, baja: 0 },
];
---
<Base titulo={metas.proyectos.titulo} descripcion={metas.proyectos.descripcion}>
  <Nav enHome={false} actual="proyectos" />
  <main class="relative z-10">
    <!-- La sala: la palabra gigante arriba y la fila de afiches que pasa de costado mientras bajás (en celu, uno abajo del otro) -->
    <section class="sala" data-sala aria-labelledby="proyectos-titulo">
      <header class="encabezado">
        <h1 id="proyectos-titulo" class="palabra font-titulo" data-revelar>
          <span class="sr-only">{t.titulo}</span>
          <span aria-hidden="true">{t.palabra}</span>
        </h1>
        <p class="bajada" data-revelar="4">{t.bajada}</p>
      </header>

      <div class="ventana">
        <ul class="fila" data-fila>
          {cartelera.map((p, i) => {
            const { Afiche, quad } = aficheDe(p.slug);
            const { mockup } = capturas(p.slug);
            const r = RITMO[i % RITMO.length];
            return (
              <li class:list={['obra', mockup ? 'obra-mockup' : quad && 'obra-quad']} style={`--alto: ${r.alto}; --baja: ${r.baja}`}>
                <a href={ruta(idioma, 'proyectos', p.slug)} class="obra-link" aria-label={`${p.titulo}: ${p.logline}`}>
                  <span class="afiche vt-afiche" style={`--vt: ${nombreVt(p.slug)}`}>
                    {mockup
                      ? <Image src={mockup} alt="" widths={[480, 800, 1136]} sizes="(min-width: 768px) 34vw, 100vw" quality={84} loading={i < 2 ? 'eager' : 'lazy'} class="foto-mockup" />
                      : <Afiche slug={p.slug} />}
                  </span>
                  <span class="ficha">
                    <span class="ficha-titulo">{p.titulo}</span>
                    <span class="ficha-dato">{p.genero} · {p.anio}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <!-- El cierre: la pregunta grande y el botón entero, al lado -->
    <section class="cierre" aria-labelledby="proyectos-cierre">
      <h2 id="proyectos-cierre" class="cierre-titulo font-titulo" data-revelar>{inicio.final.titulo}</h2>
      <a href={ruta(idioma, 'contacto')} class="cta cta-flecha" data-revelar="2">
        {inicio.final.cta}
        <span class="cta-circulo" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </span>
      </a>
    </section>

    <Creativos />
  </main>
  <Pie corto />
  <Motion />
</Base>

<style>
  .sala { --margen: 1.25rem; padding-top: 7.5rem; }
  @media (min-width: 768px) { .sala { --margen: clamp(1.5rem, 3.5vw, 3rem); } }

  /* La palabra gigante centrada y la bajada chica abajo, como la portada de un catálogo */
  .encabezado { display: grid; justify-items: center; gap: 1.25rem; padding-inline: var(--margen); text-align: center; }
  .palabra { font-weight: 800; font-size: clamp(5rem, 16vw, 14rem); line-height: 0.8; letter-spacing: 0; }
  .bajada { max-width: 34ch; font-size: clamp(1.0625rem, 1.3vw, 1.25rem); line-height: 1.4; }

  /* La fila: en celu, uno abajo del otro a todo el ancho */
  .ventana { margin-top: 3rem; }
  .fila { display: grid; gap: 2.75rem; padding-inline: var(--margen); }
  .obra-link { display: flex; flex-direction: column; gap: 0.75rem; }
  .afiche {
    position: relative;
    display: block;
    container-type: inline-size;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background: var(--color-tinta);
    transition: transform 250ms var(--ease-ui);
  }
  .obra-quad .afiche { aspect-ratio: 4 / 5; }
  /* El mockup va entero: la caja tiene su misma proporción, así nunca se corta */
  .obra-mockup .afiche { aspect-ratio: 1136 / 1408; }
  .afiche :global(.foto-mockup) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ficha { display: grid; gap: 0.15rem; }
  .ficha-titulo { font-size: 0.9375rem; font-weight: 600; line-height: 1.3; }
  .ficha-dato { font-size: 0.875rem; color: var(--color-gris); }
  .obra-link:focus-visible .afiche { transform: translateY(-6px); }
  .obra-link:active .afiche { transform: scale(0.98); }
  @media (hover: hover) and (pointer: fine) {
    .obra-link:hover .afiche { transform: translateY(-6px); }
    .obra-link:hover:active .afiche { transform: translateY(-6px) scale(0.98); }
  }

  /* En compu: una fila escalonada, con afiches de distintos tamaños, que se sale por los costados.
     El alto de la fila es lo que queda de pantalla debajo de la palabra (así la sala entra entera al quedar fija). */
  @media (min-width: 768px) {
    .ventana { --fila: max(220px, min(62vw, calc(100svh - 12.8vw - 19rem))); margin-top: 2.5rem; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; }
    .ventana::-webkit-scrollbar { display: none; }
    .fila { display: flex; align-items: flex-start; gap: clamp(1rem, 1.6vw, 1.5rem); width: max-content; padding-bottom: 1rem; }
    .obra { margin-top: calc(var(--fila) * var(--baja)); }
    .obra .afiche { height: calc(var(--fila) * var(--alto)); width: auto; }
    .obra-quad .afiche { aspect-ratio: 4 / 3; }
    /* El ancho sale de la foto, no del texto de abajo: un texto largo se parte en dos renglones y no recorta el mockup */
    .obra-mockup { flex: none; width: calc(var(--fila) * var(--alto) * 1136 / 1408); }
    .obra-mockup .afiche { width: 100%; aspect-ratio: 1136 / 1408; }
  }
  /* Con movimiento la fila la corre el scroll: la ventana deja de tener barra propia */
  @media (min-width: 768px) and (prefers-reduced-motion: no-preference) {
    .sala.corre { overflow-x: clip; }
    .sala.corre .ventana { overflow: visible; }
  }

  .cierre { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1.5rem 2rem; padding: clamp(5rem, 14svh, 9rem) 1.25rem 0; }
  @media (min-width: 768px) { .cierre { padding-inline: clamp(1.5rem, 3.5vw, 3rem); } }
  .cierre-titulo { font-weight: 800; font-size: clamp(3.25rem, 9vw, 8.5rem); line-height: 0.85; }

  @media (prefers-reduced-motion: reduce) {
    .afiche { transition: none; }
    .obra-link:hover .afiche, .obra-link:active .afiche { transform: none; }
  }
</style>

<script>
  import { gsap, ScrollTrigger, movimientoPermitido } from '../motion/index';

  // En compu, la sala se queda quieta mientras la fila pasa de costado: el scroll de arriba a abajo la mueve.
  const sala = document.querySelector<HTMLElement>('[data-sala]');
  const fila = document.querySelector<HTMLElement>('[data-fila]');
  if (sala && fila && movimientoPermitido()) {
    ScrollTrigger.matchMedia({
      '(min-width: 768px)': () => {
        sala.classList.add('corre');
        const recorrido = () => Math.max(0, fila.scrollWidth - innerWidth);
        const viaje = gsap.to(fila, {
          x: () => -recorrido(),
          ease: 'none',
          scrollTrigger: { trigger: sala, start: 'top top', end: () => `+=${recorrido()}`, pin: true, scrub: 0.6, invalidateOnRefresh: true },
        });
        return () => { viaje.scrollTrigger?.kill(); viaje.kill(); gsap.set(fila, { clearProps: 'transform' }); sala.classList.remove('corre'); };
      },
    });
  }
</script>
