---
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Pie from '../components/Pie.astro';
import Volver from '../components/Volver.astro';
import Creativos from '../components/Creativos.astro';
import AficheEmme from '../components/afiches/AficheEmme.astro';
import AficheMuda from '../components/afiches/AficheMuda.astro';
import AficheEber from '../components/afiches/AficheEber.astro';
import AficheCraft from '../components/afiches/AficheCraft.astro';
import AficheUnik from '../components/afiches/AficheUnik.astro';
import AficheFidalgo from '../components/afiches/AficheFidalgo.astro';
import AficheTmd from '../components/afiches/AficheTmd.astro';
import AficheNewave from '../components/afiches/AficheNewave.astro';
import AficheGenerico from '../components/afiches/AficheGenerico.astro';
import { proyectosEn } from '../content/proyectos';
import { RUBROS } from '../story/opciones';
import { idiomaDe, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { proyectosPagina: t, rubros: nombresRubro, metas } = textos(idioma);
const PROYECTOS = proyectosEn(idioma);

// Solo los rubros que tienen algún proyecto, en el orden de la pregunta
const rubros = RUBROS.filter((r) => PROYECTOS.some((p) => p.rubro === r.id));
const etiqueta = (id: string) => nombresRubro[id as keyof typeof nombresRubro] ?? id;

// La cartelera: cada proyecto con su afiche. Los apaisados (quad) ocupan dos columnas y se alternan con los verticales,
// así cada fila de la compu es un apaisado + un vertical.
const AFICHES = {
  emme: { Afiche: AficheEmme, quad: true },
  muda: { Afiche: AficheMuda, quad: false },
  eber: { Afiche: AficheEber, quad: false },
  craft: { Afiche: AficheCraft, quad: true },
  tmd: { Afiche: AficheTmd, quad: false },
  newave: { Afiche: AficheNewave, quad: true },
  unik: { Afiche: AficheUnik, quad: true },
  fidalgo: { Afiche: AficheFidalgo, quad: false },
} as const;
const orden = Object.keys(AFICHES);
// Los cargados desde el admin no están en AFICHES: van primero, con el afiche genérico
const cartelera = [...PROYECTOS].sort((a, b) => orden.indexOf(a.slug) - orden.indexOf(b.slug));
---
<Base titulo={metas.proyectos.titulo} descripcion={metas.proyectos.descripcion}>
  <Nav enHome={false} actual="proyectos" />
  <main class="relative z-10">
    <header class="px-5 pt-32 md:px-12 md:pt-40">
      <p class="mono flex items-baseline gap-4 border-t border-tinta/15 pt-3">
        <Volver />
      </p>
      <h1 class="mt-14 max-w-[16ch] font-titulo text-[clamp(3rem,12vw,9rem)] leading-[0.9] tracking-[-0.045em]" data-revelar>
        {t.titulo}.
      </h1>
      <p class="mt-8 max-w-[34ch] text-xl leading-snug text-tinta/70 md:text-2xl" data-revelar="4">{t.bajada}</p>
    </header>

    <!-- Filtro por rubro: es la pregunta 4 de la historia, y se guarda para el tráiler -->
    <div class="mt-16 px-5 md:px-12" role="group" aria-labelledby="filtro-titulo">
      <p id="filtro-titulo" class="max-w-[60ch] text-lg leading-snug"><span class="font-medium">{t.pregunta}</span> <span class="text-tinta/75">{t.ayuda}</span></p>
      <ul class="mono mt-4 flex flex-wrap gap-2">
        <li><button type="button" class="chip" data-rubro="" aria-pressed="true">{t.todos}</button></li>
        {rubros.map((r) => (
          <li><button type="button" class="chip" data-rubro={r.id} data-nombre={etiqueta(r.id).toLowerCase()} aria-pressed="false">{etiqueta(r.id)}</button></li>
        ))}
      </ul>
      <p role="status" class="sr-only" data-estado data-plantilla={t.mostrandoPrimero}></p>
    </div>

    <!-- La cartelera: el afiche es pura imagen; los datos van abajo, como en la web de un cine -->
    <ul class="cartelera mt-12 px-5 md:px-12">
      {cartelera.map((p, i) => {
        const { Afiche, quad } = AFICHES[p.slug as keyof typeof AFICHES] ?? { Afiche: AficheGenerico, quad: false };
        return (
          <li class:list={['funcion', quad && 'funcion-quad']} data-rubro={p.rubro} data-orden={i}>
            <a href={ruta(idioma, 'proyectos', p.slug)} class="funcion-link group" aria-label={`${p.titulo}: ${p.logline}`}>
              <span class="afiche-caja"><span class="afiche"><Afiche slug={p.slug} /></span></span>
              <span class="ficha">
                <span class="ficha-titulo">{p.titulo}</span>
                <span class="mono ficha-ver" aria-hidden="true">{t.verCaso}</span>
                <span class="mono text-gris">{p.genero} · {p.anio}<span class="tira-cerca text-tinta" hidden> · {t.cerca}</span></span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <Creativos />

  </main>
  <Pie />
  <Motion />
</Base>

<style>
  .chip {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid color-mix(in oklab, var(--color-tinta) 25%, transparent);
    border-radius: 999px;
    transition: transform 160ms var(--ease-ui), background-color 200ms ease, color 200ms ease;
  }
  .chip:active { transform: scale(0.97); }
  .chip[aria-pressed='true'] { background: var(--color-tinta); color: var(--color-papel); border-color: var(--color-tinta); }

  /* ── La cartelera ─────────────────────────────────────────── */
  .cartelera { display: grid; gap: 3rem; }
  .funcion-link { display: flex; flex-direction: column; gap: 1rem; height: 100%; }

  .afiche {
    position: relative;
    display: block;
    container-type: inline-size;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    background: var(--color-tinta);
    box-shadow: 0 24px 40px -28px rgb(0 0 0 / 0.55);
    transition: transform 250ms var(--ease-ui);
  }
  .funcion-quad .afiche { aspect-ratio: 4 / 5; }
  /* La sombra grande vive en la caja (quieta) y aparece con opacidad: no se anima box-shadow */
  .afiche-caja { position: relative; display: block; isolation: isolate; }
  .afiche-caja::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    box-shadow: 0 40px 60px -30px rgb(0 0 0 / 0.6);
    opacity: 0;
    transition: opacity 250ms var(--ease-ui);
    pointer-events: none;
  }
  .funcion-link:focus-visible .afiche { transform: translateY(-6px); }
  .funcion-link:focus-visible .afiche-caja::after { opacity: 1; }
  .funcion-link:active .afiche { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .funcion-link:hover .afiche { transform: translateY(-6px); }
    .funcion-link:hover .afiche-caja::after { opacity: 1; }
    .funcion-link:hover:active .afiche { transform: translateY(-6px) scale(0.97); }
  }

  .ficha { display: grid; grid-template-columns: 1fr auto; row-gap: 0.3rem; align-items: baseline; }
  .ficha-titulo { font-family: var(--font-titulo); font-weight: 500; font-size: clamp(1.4rem, 2.2vw, 1.9rem); line-height: 1; letter-spacing: -0.04em; }
  .ficha-ver { grid-row: span 2; align-self: start; padding-top: 0.35rem; white-space: nowrap; }

  @media (min-width: 768px) {
    /* Tres columnas: un apaisado (dos columnas) y un vertical por fila; el apaisado toma el alto del vertical */
    .cartelera { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-flow: row dense; gap: 4.5rem 1.5rem; }
    .funcion-quad { grid-column: span 2; }
    .funcion-quad .afiche-caja { display: flex; flex: 1; min-height: 0; }
    .funcion-quad .afiche { aspect-ratio: auto; flex: 1; min-height: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .afiche, .afiche-caja::after { transition: none; }
    .funcion-link:hover .afiche, .funcion-link:active .afiche { transform: none; }
  }
</style>

<script>
  import { $respuestas, responder } from '../story/store';
  import { type RubroId } from '../story/opciones';

  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const estado = document.querySelector<HTMLElement>('[data-estado]');

  /** Lo del rubro elegido va primero; el resto conserva su orden. */
  function aplicar(rubro: RubroId | null) {
    chips.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.rubro || null) === rubro)));
    document.querySelectorAll<HTMLElement>('[data-rubro][data-orden]').forEach((el) => {
      const cerca = rubro !== null && el.dataset.rubro === rubro;
      el.style.order = String(cerca ? -1 : 0);
      el.querySelector<HTMLElement>('.tira-cerca')?.toggleAttribute('hidden', !cerca);
    });
    if (estado) {
      // El aviso para lectores de pantalla, en el idioma de la página (la plantilla viene del HTML)
      const label = chips.find((c) => c.dataset.rubro === rubro)?.dataset.nombre;
      estado.textContent = rubro && label ? (estado.dataset.plantilla ?? '').replace('{rubro}', label) : '';
    }
  }

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      const rubro = (c.dataset.rubro || null) as RubroId | null;
      responder('rubro', rubro);
      aplicar(rubro);
    }),
  );

  // Si ya respondió el rubro en esta visita, arrancamos con eso
  const guardado = $respuestas.get().rubro;
  if (guardado && chips.some((c) => c.dataset.rubro === guardado)) aplicar(guardado);
</script>
