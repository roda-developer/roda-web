---
import { Image } from 'astro:assets';
import { capturas } from '../content/capturas';
import { proyectosEn } from '../content/proyectos';
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Pie from '../components/Pie.astro';
import Volver from '../components/Volver.astro';
import { idiomaDe, rellenar, ruta, textos } from '../i18n';
const idioma = idiomaDe(Astro.currentLocale);
const { planes, preciosPagina: t, metas } = textos(idioma);
const contacto = ruta(idioma, 'contacto');

const { moneda, adicionales, aMedida } = planes;
// Una web real de cada plan, para que se vea qué estás comprando
const EJEMPLOS: Record<string, string> = { landing: 'eber', multiseccion: 'craft', tienda: 'newave', 'a-medida': 'fidalgo' };
const ejemploDe = (plan: string) => { const slug = EJEMPLOS[plan]; const mockup = slug ? capturas(slug).mockup : null; const titulo = proyectosEn(idiomaDe(Astro.currentLocale)).find((x) => x.slug === slug)?.titulo; return mockup && titulo ? { mockup, titulo } : null; };
---
<Base titulo={metas.precios.titulo} descripcion={metas.precios.descripcion}>
  <Nav enHome={false} actual="precios" />
  <main class="relative z-10">
    <!-- Encabezado corto: quien entra a Precios quiere ver números, la lista tiene que asomar en la primera pantalla -->
    <header class="px-5 pt-28 md:px-12 md:pt-32">
      <p class="mono flex items-baseline gap-4">
        <Volver />
      </p>
      <h1 class="mt-8 font-titulo [text-wrap:balance] text-[clamp(2.6rem,8vw,5.2rem)] leading-[0.92] tracking-[-0.01em]" data-revelar>
        <span>{t.titulo[0]}</span> {t.titulo[1]}
      </h1>
      <p class="mt-5 max-w-[34ch] text-lg leading-snug text-tinta/70 md:text-xl" data-revelar="4">{t.bajada}</p>
    </header>

    <section class="mt-12 px-5 md:mt-14 md:px-12" aria-labelledby="precios-planes">
      <h2 id="precios-planes" class="sr-only">{t.rotulos.planes[1]}</h2>
      {t.moneda.tipo && (
      <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2" data-moneda data-tipo={t.moneda.tipo} data-simbolo={t.moneda.simbolo} data-sigla={t.moneda.sigla} data-referencia={t.moneda.referencia} data-cotizacion-texto={t.moneda.cotizacion}>
        <button type="button" role="switch" aria-checked="false" class="interruptor mono" data-interruptor-pesos disabled>
          <span class="perilla" aria-hidden="true"></span>{t.moneda.etiqueta}
        </button>
        <p class="mono text-gris" data-cotizacion aria-live="polite" hidden></p>
      </div>
      )}

      <!-- Los planes como la lista de precios de una galería: una franja a lo ancho por plan, el nombre y el precio grandes.
           De la más barata a la más cara: A medida cierra la lista, en tinta (sistemas y webs grandes, a consulta) -->
      <ul class="lista mt-10">
        {planes.lista.map((p) => {
          const ficha = t.fichas[p.id as keyof typeof t.fichas];
          return (
            <li id={p.id} class="fila vt-plan" style={`--vt: plan-${p.id}`} data-revelar>
              <div class="fila-cabeza">
                <h3 class="fila-nombre font-titulo">{p.nombre}</h3>
                {ejemploDe(p.id) && <figure class="ejemplo"><Image src={ejemploDe(p.id)!.mockup} alt="" widths={[320, 480]} sizes="11rem" quality={84} loading="lazy" /><figcaption>{rellenar(t.ejemplo, { titulo: ejemploDe(p.id)!.titulo })}</figcaption></figure>}
              </div>
              <div class="fila-info">
                <p class="ideal">{ficha.ideal}</p>
                <p class="claves">{ficha.clave.map((c, k) => <>{k > 0 && <span aria-hidden="true"> · </span>}{c.split(/(US\$ \d+)/).map((parte) => (/^US\$ \d+$/.test(parte) ? <span data-usd-texto={parte.slice(4)}>{parte}</span> : parte))}</>)}</p>
                {'detalle' in ficha && <p class="detalle-plan">{ficha.detalle}</p>}
                <div class="fila-accion">
                  <a href={`${contacto}?plan=${p.id}`} class="cta">{t.pedir}<span class="sr-only"> ({p.nombre})</span></a>
                  <p class="mantenimiento">{t.mantenimiento.linea.split('US$ {precio}').map((parte, k) => (k === 0 ? parte : <><span data-usd-texto={ficha.mantenimiento}>US$ {ficha.mantenimiento}</span>{parte}</>))}</p>
                </div>
              </div>
              <div class="fila-precio">
                <p data-precio-usd={p.precio}><span class="sr-only">{rellenar(t.precio, { moneda, precio: p.precio })}</span><span class="precio-moneda" aria-hidden="true">{moneda}</span><span class="precio-num" aria-hidden="true">{p.precio}</span></p>
                <p class="hoy" data-hoy={p.precio} hidden></p>
              </div>
            </li>
          );
        })}
        <li id="a-medida" class="fila medida" data-revelar>
          <div class="fila-cabeza">
            <h3 class="fila-nombre font-titulo">{aMedida.rotulo}</h3>
            {ejemploDe('a-medida') && <figure class="ejemplo"><Image src={ejemploDe('a-medida')!.mockup} alt="" widths={[320, 480]} sizes="11rem" quality={84} loading="lazy" /><figcaption>{rellenar(t.ejemplo, { titulo: ejemploDe('a-medida')!.titulo })}</figcaption></figure>}
          </div>
          <div class="fila-info">
            <p class="ideal">{aMedida.titulo}</p>
            <p class="claves">{aMedida.texto}</p>
            <div class="fila-accion">
              <a href={`${contacto}?tipo=sistema`} class="cta medida-cta">{aMedida.cta}</a>
            </div>
          </div>
          <p class="fila-precio medida-precio">{aMedida.precio}</p>
        </li>
      </ul>

    </section>

    <!-- Todas incluyen: lo que trae cualquiera de las webs, en un paso de tono del papel -->
    <section class="creditos mt-24 md:mt-32" aria-labelledby="precios-creditos">
      <h2 id="precios-creditos" class="font-titulo text-center">{t.creditos.titulo}</h2>
      <dl class="rollo">
        {t.creditos.lista.map(([rol, quien]) => (
          <div class="credito"><dt>{rol}</dt><dd>{quien}</dd></div>
        ))}
      </dl>
      <p class="aviso">{t.creditos.aviso}</p>
    </section>

    <!-- Sumale: los adicionales como los renglones de una lista de precios (nombre, puntos, precio) -->
    <section id="adicionales" class="mt-24 px-5 md:mt-32 md:px-12" aria-labelledby="precios-extras">
      <h2 id="precios-extras" class="adicionales-titulo font-titulo" data-revelar>{adicionales.titulo}</h2>
      <ul class="renglones mt-10">
        {adicionales.lista.map((a, i) => (
          <li class="renglon" data-revelar={i * 2}>
            <p class="renglon-linea">
              <span class="renglon-nombre">{a.nombre}</span>
              <span class="puntos" aria-hidden="true"></span>
              <span class="renglon-precio">+ <span data-moneda-simbolo>{moneda}</span> <span data-usd-num={a.precio}>{a.precio}</span></span>
            </p>
            <p class="renglon-detalle">{a.detalle}</p>
            {'nota' in a && a.nota && <p class="renglon-nota">{a.nota}</p>}
            <p class="hoy mono" data-hoy={a.precio} hidden></p>
          </li>
        ))}
      </ul>
    </section>

    <!-- Preguntas frecuentes: se abren de a una. En compu, el título a la izquierda y la lista a la derecha (si no, media pantalla queda vacía) -->
    <section class="mt-24 grid px-5 md:mt-32 md:px-12 lg:grid-cols-[1fr_2fr] lg:gap-16" aria-labelledby="precios-preguntas">
      <h2 id="precios-preguntas" class="font-titulo text-[clamp(2.4rem,6vw,4rem)] leading-[0.9] [text-wrap:balance] lg:sticky lg:top-28 lg:self-start" data-revelar>{t.rotulos.preguntas[1]}</h2>
      <div class="mt-10 border-t border-tinta lg:mt-0">
        {t.preguntas.map((q) => (
          <details class="pregunta border-b border-tinta/15">
            <summary class="flex min-h-11 cursor-pointer items-center justify-between gap-6 py-5 text-lg font-medium tracking-[-0.02em] md:text-2xl">
              {q.p}<span class="signo" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></span>
            </summary>
            <div class="space-y-3 pb-6 text-tinta/70 md:text-lg">
              {q.r.map((r) => <p class="max-w-[60ch]">{r.split(/(US\$ \d+)/).map((parte) => (/^US\$ \d+$/.test(parte) ? <span data-usd-texto={parte.slice(4)}>{parte}</span> : parte))}</p>)}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- El cierre: una pregunta y el botón -->
    <section class="mt-24 px-5 pb-16 md:mt-32 md:px-12" aria-labelledby="precios-final">
      <div>
        <h2 id="precios-final" class="font-titulo text-[clamp(3rem,13vw,9rem)] leading-[0.9] tracking-[-0.01em]" data-revelar>{t.final.titulo}</h2>
        <p class="mt-6 max-w-[34ch] text-xl text-tinta/70 md:text-2xl" data-revelar="4">{t.final.texto}</p>
        <a href={contacto} class="cta mt-10" data-revelar="6">{t.final.cta}</a>
      </div>
    </section>
  </main>
  <Pie corto />
  <Motion />
</Base>

<style>
  /* ── La lista: una franja por nivel, separadas por un paso de tono (sin líneas ni sombras) ── */
  .lista { display: grid; margin-inline: -1.25rem; }
  @media (min-width: 768px) { .lista { margin-inline: -3rem; } }
  .fila {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 1rem 1.5rem; align-items: baseline;
    padding: 2.25rem 1.25rem; scroll-margin-top: 6rem;
  }
  .fila:nth-child(odd) { background: color-mix(in oklab, var(--color-papel) 88%, #cfc8ba); }
  @media (min-width: 768px) { .fila { padding-inline: 3rem; } }
  .fila-nombre { font-size: clamp(2.6rem, 7vw, 5.5rem); line-height: 0.86; }
  .ejemplo { width: min(44vw, 11rem); margin: 1rem 0 0; }
  .ejemplo :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1136 / 1408; }
  .ejemplo figcaption { margin-top: 0.5rem; font-size: 0.875rem; }
  .fila-info { grid-column: 1 / -1; display: grid; gap: 0.75rem; max-width: 44rem; }
  .fila-precio { grid-row: 1; grid-column: 2; text-align: right; font-family: var(--font-titulo); font-weight: 800; font-size: clamp(2.6rem, 7vw, 5.5rem); line-height: 0.86; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .precio-moneda { margin-right: 0.15em; font-size: 0.36em; vertical-align: 0.95em; }
  .fila-precio .hoy { font-family: var(--font-texto); font-weight: 400; }
  @media (min-width: 1024px) {
    .fila { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) auto; column-gap: clamp(2rem, 4vw, 4rem); align-items: start; padding-block: 2.75rem; }
    .fila-info { grid-column: 2; }
    .fila-precio { grid-column: 3; }
  }
  .ideal { font-size: clamp(1.125rem, 1.5vw, 1.3rem); line-height: 1.4; font-weight: 600; }
  .claves { font-size: 1.0625rem; line-height: 1.45; }
  .detalle-plan { font-size: 0.875rem; line-height: 1.45; color: color-mix(in oklab, var(--color-tinta) 75%, var(--color-papel)); }
  .fila-accion { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; margin-top: 0.75rem; }
  .mantenimiento { font-size: 0.875rem; line-height: 1.35; }

  /* ── A medida: en tinta, con el precio en rosa ── */
  .fila.medida { background: var(--color-tinta); color: var(--color-papel); }
  .medida .claves, .medida .detalle-plan { color: color-mix(in oklab, var(--color-papel) 86%, var(--color-tinta)); }
  .medida-precio { color: var(--color-tc-rosa); font-size: clamp(1.5rem, 3vw, 2.4rem); line-height: 1; }
  .medida-cta { background: var(--color-papel); color: var(--color-tinta); }

  /* ── Todas incluyen: un paso de tono del papel (el rosa queda para Más es más y Nosotros) ── */
  .creditos { background: color-mix(in oklab, var(--color-papel) 82%, #cfc8ba); color: var(--color-tinta); padding: 4.5rem 1.25rem; }
  .creditos h2 { font-size: clamp(2.4rem, 6vw, 4rem); line-height: 0.9; }
  .rollo { display: grid; gap: 1.6rem; max-width: 58rem; margin: 2.5rem auto 0; text-align: center; }
  @media (min-width: 768px) { .rollo { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.25rem 2rem; } }
  /* Si sobra uno solo en la última fila, va al medio */
  @media (min-width: 768px) { .credito:last-child:nth-child(3n + 1) { grid-column: 2; } }
  .credito dt { font-style: italic; font-size: 0.875rem; opacity: 0.75; }
  .credito dd { margin-top: 0.25rem; font-weight: 600; font-size: clamp(1.05rem, 2.2vw, 1.25rem); line-height: 1.25; }
  .aviso { margin-top: 3rem; text-align: center; font-style: italic; }

  /* ── Sumale: renglones de una lista de precios ── */
  #adicionales { scroll-margin-top: 6rem; }
  .adicionales-titulo { font-size: clamp(2.4rem, 6vw, 4rem); line-height: 0.9; }
  .renglones { display: grid; gap: 2rem; max-width: 64rem; }
  @media (min-width: 1024px) { .renglones { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 4rem; } }
  .renglon { display: grid; gap: 0.4rem; align-content: start; }
  .renglon-linea { display: flex; align-items: baseline; gap: 0.6rem; font-size: clamp(1.25rem, 2vw, 1.5rem); font-weight: 600; }
  /* Los puntos entre el nombre y el precio, como en una carta */
  .puntos { flex: 1; min-width: 1.5rem; height: 0.2em; background: radial-gradient(circle, currentColor 1.2px, transparent 1.6px) 0 50% / 0.5em 100% repeat-x; opacity: 0.45; }
  .renglon-precio { white-space: nowrap; font-variant-numeric: tabular-nums; }
  .renglon-detalle { max-width: 46ch; line-height: 1.4; color: color-mix(in oklab, var(--color-tinta) 78%, var(--color-papel)); }
  .renglon-nota { max-width: 52ch; font-size: 0.875rem; line-height: 1.45; color: var(--color-gris); }

  /* El interruptor de pesos: un switch con perilla */
  .interruptor { display: inline-flex; align-items: center; gap: 0.7rem; min-height: 2.75rem; font-size: 0.875rem; cursor: pointer; }
  .interruptor:disabled { opacity: 0.4; cursor: wait; }
  .perilla { position: relative; flex-shrink: 0; width: 2.6rem; height: 1.5rem; border-radius: 999px; background: color-mix(in oklab, var(--color-tinta) 18%, transparent); transition: background-color 200ms ease; }
  .perilla::after { content: ''; position: absolute; top: 0.2rem; left: 0.2rem; width: 1.1rem; height: 1.1rem; border-radius: 999px; background: var(--color-papel); box-shadow: 0 1px 3px rgb(0 0 0 / 0.3); transition: transform 0.2s var(--ease-cine); }
  .interruptor[aria-checked='true'] .perilla { background: var(--color-tinta); }
  .interruptor[aria-checked='true'] .perilla::after { transform: translateX(1.1rem); }
  .interruptor:focus-visible { outline: 2px solid var(--color-tinta); outline-offset: 4px; border-radius: 4px; }
  /* Con la moneda local prendida: el precio fijo en dólares, chico, debajo */
  .hoy { margin-top: 0.5rem; font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--color-gris); }
  .hoy[hidden] { display: none; }

  .pregunta summary { list-style: none; transition: transform 160ms var(--ease-ui); }
  .pregunta summary:active { transform: scale(0.97); }
  .pregunta summary::-webkit-details-marker { display: none; }
  .signo { flex-shrink: 0; display: inline-grid; place-items: center; width: 2.2rem; height: 2.2rem; border: 1px solid color-mix(in oklab, var(--color-tinta) 30%, transparent); border-radius: 999px; font-size: 1.25rem; transition: transform 200ms var(--ease-ui); }
  .pregunta[open] .signo { transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) { .signo { transition: none; } }
</style>
<script>
  // ── Cuánto sale hoy en moneda local ─────────────────────────────────────────────
  // El precio real es en dólares y no cambia. Con el interruptor, la moneda local reemplaza a los dólares en toda la página
  // y el precio fijo en dólares queda chico debajo de cada plan y adicional.
  // Español: pesos con DolarApi (dólar oficial a la venta; para otro, cambiar "oficial" por "blue" o "bolsa").
  // Portugués: reales con Frankfurter v2 (cotizaciones de bancos centrales). Inglés: no hay interruptor.
  // Los textos y el tipo de moneda vienen del HTML (data-*), así el navegador no carga los guiones.
  const control = document.querySelector<HTMLElement>('[data-moneda]');
  if (control) {
    const tipo = control.dataset.tipo as 'ars' | 'brl';
    const simbolo = control.dataset.simbolo ?? '';
    const sigla = control.dataset.sigla ?? '';
    const referencia = control.dataset.referencia ?? '';
    const plantillaCotizacion = control.dataset.cotizacionTexto ?? '';
    const idioma = document.documentElement.lang;
    const CLAVE = 'roda-moneda-' + tipo;
    const interruptor = control.querySelector<HTMLButtonElement>('[data-interruptor-pesos]');
    const aviso = control.querySelector<HTMLElement>('[data-cotizacion]');
    const numero = new Intl.NumberFormat(idioma);
    let valor = 0;

    // Redondeado para arriba: los pesos a los mil ($ 462.000), los reales a los diez (R$ 1.500)
    const redondeo = tipo === 'ars' ? 1000 : 10;
    const local = (usd: number) => Math.ceil((usd * valor) / redondeo) * redondeo;
    // Guarda el texto original (en dólares) la primera vez, para poder volver
    const cambiar = (el: HTMLElement, texto: string | null) => {
      if (el.dataset.original === undefined) el.dataset.original = el.textContent ?? '';
      el.textContent = texto ?? el.dataset.original;
    };

    const mostrar = (si: boolean) => {
      const activo = si && valor > 0;
      interruptor?.setAttribute('aria-checked', String(activo));
      if (aviso) aviso.hidden = !activo;
      document.querySelectorAll<HTMLElement>('[data-precio-usd]').forEach((s) => {
        const n = local(Number(s.dataset.precioUsd));
        const num = s.querySelector<HTMLElement>('.precio-num'), mon = s.querySelector<HTMLElement>('.precio-moneda');
        if (num) cambiar(num, activo ? numero.format(n) : null);
        if (mon) cambiar(mon, activo ? sigla : null);
      });
      document.querySelectorAll<HTMLElement>('[data-usd-num]').forEach((el) => cambiar(el, activo ? numero.format(local(Number(el.dataset.usdNum))) : null));
      document.querySelectorAll<HTMLElement>('[data-usd-texto]').forEach((el) => cambiar(el, activo ? `${simbolo} ${numero.format(local(Number(el.dataset.usdTexto)))}` : null));
      document.querySelectorAll<HTMLElement>('[data-moneda-simbolo]').forEach((el) => cambiar(el, activo ? simbolo : null));
      document.querySelectorAll<HTMLElement>('[data-hoy]').forEach((el) => {
        el.textContent = activo ? referencia.replace('{valor}', el.dataset.hoy ?? '') : '';
        el.hidden = !activo;
      });
      try { localStorage.setItem(CLAVE, activo ? 'si' : 'no'); } catch {}
    };
    interruptor?.addEventListener('click', () => mostrar(interruptor.getAttribute('aria-checked') !== 'true'));

    const fechaCorta = (d: Date, conHora: boolean) =>
      new Intl.DateTimeFormat(idioma, { day: 'numeric', month: 'numeric', ...(conHora ? { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' } : {}), timeZone: 'America/Argentina/Buenos_Aires' }).format(d);

    const pedir: Promise<{ valor: number; fecha: string }> =
      tipo === 'ars'
        ? fetch('https://dolarapi.com/v1/dolares/oficial', { signal: AbortSignal.timeout(8000) })
            .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
            .then((d: { venta: number; fechaActualizacion: string }) => ({ valor: d.venta, fecha: fechaCorta(new Date(d.fechaActualizacion), true) }))
        : fetch('https://api.frankfurter.dev/v2/rates?base=USD&quotes=BRL', { signal: AbortSignal.timeout(8000) })
            .then((r) => (r.ok ? r.json() : Promise.reject(new Error(String(r.status)))))
            .then(([d]: { date: string; rate: number }[]) => ({ valor: d.rate, fecha: fechaCorta(new Date(d.date + 'T12:00:00Z'), false) }));

    pedir
      .then(({ valor: v, fecha }) => {
        if (!(v > 0)) throw new Error('cotización vacía');
        valor = v;
        const formato = new Intl.NumberFormat(idioma, { maximumFractionDigits: tipo === 'ars' ? 0 : 2 });
        if (aviso) aviso.textContent = plantillaCotizacion.replace('{valor}', formato.format(valor)).replace('{fecha}', fecha);
        if (interruptor) interruptor.disabled = false;
        let guardado: string | null = null;
        try { guardado = localStorage.getItem(CLAVE); } catch {}
        if (guardado === 'si') mostrar(true);
      })
      .catch(() => {
        // Sin cotización no inventamos un número: el interruptor se va y quedan los dólares
        control.remove();
      });
  }
</script>
