---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Motion from '../components/Motion.astro';
import Nav from '../sections/Nav.astro';
import Pie from '../components/Pie.astro';
import Volver from '../components/Volver.astro';
import Criticas from '../components/Criticas.astro';
import { proyectosEn, proyectoSiguiente, testimoniosDe } from '../content/proyectos';
import { capturas } from '../content/capturas';
import { aficheDe, nombreVt } from '../components/afiches/mapa';
import { idiomaDe, rellenar, ruta, textos } from '../i18n';

// La ruta (src/pages/…/[slug].astro) pasa el slug; los textos salen del idioma de la dirección
const idioma = idiomaDe(Astro.currentLocale);
const { proyectosPagina: t, rubros, metas } = textos(idioma);
const lista = proyectosEn(idioma);
const p = lista.find((x) => x.slug === Astro.props.slug)!;
const fotos = capturas(p.slug);
const siguiente = proyectoSiguiente(p.slug, idioma);
const fotosSiguiente = capturas(siguiente.slug);
const rubro = rubros[p.rubro];
const { Afiche, quad } = aficheDe(p.slug);
const ficha: [string, string | number | undefined][] = [
  [t.ficha.genero, p.genero],
  [t.ficha.rubro, rubro],
  [t.ficha.rol, p.rol],
  [t.ficha.anio, p.anio],
];
---
<Base titulo={rellenar(metas.caso, { titulo: p.titulo })} descripcion={`${p.titulo}: ${p.logline} ${p.cliente}`}>
  <Nav enHome={false} actual="proyectos" />
  <main class="relative z-10">
    <!-- En compu, el afiche vertical va al costado del título; el apaisado, a lo ancho abajo -->
    <div class:list={['apertura-caso', { vertical: !quad }]}>
    <header class="px-5 pt-32 md:px-12 md:pt-40">
      <p class="mono flex items-baseline gap-4">
        <Volver alternativa={ruta(idioma, 'proyectos')} />
      </p>
      <h1 class="mt-12 font-titulo text-[clamp(3.6rem,17vw,14rem)] leading-[0.85] tracking-[-0.01em]" data-revelar>{p.titulo}</h1>
      <p class="mt-6 max-w-[24ch] text-2xl leading-tight text-tinta/70 italic md:text-4xl" data-revelar="4">{p.logline}</p>

      <div class="mt-14 grid gap-8 border-t border-tinta/15 pt-4 md:grid-cols-[1fr_auto] md:items-start">
        <dl class="mono grid grid-cols-2 gap-x-6 gap-y-4 md:grid-cols-4">
          {ficha.map(([k, v]) => (
            <div><dt class="text-gris">{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
        <a href={p.url} target="_blank" rel="noopener" class="cta self-start">{t.verEnVivo}<span class="sr-only"> {t.otraPestana}</span></a>
      </div>
    </header>

    <!-- El caso abre con su afiche (el mismo de /proyectos). Sin data-revelar: tiene que estar visible cuando llega
         el afiche desde /proyectos o la foto desde Trabajos en la home (View Transitions) -->
    <figure class="mt-14 px-5 md:mt-20 md:px-12">
      <span class:list={['afiche-caso vt-afiche', { 'afiche-quad': quad }]} style={`--vt: ${nombreVt(p.slug)}`}><Afiche slug={p.slug} /></span>
    </figure>
    </div>

    <article class="caso trio grid gap-16 px-5 py-24 md:px-12 md:py-32">
      <section class="bloque">
        <h2 class="text-xl font-medium tracking-[-0.02em] md:text-2xl">{t.secciones.cliente}</h2>
        <p class="texto-grande" data-revelar>{p.cliente}</p>
      </section>
      <section class="bloque">
        <h2 class="text-xl font-medium tracking-[-0.02em] md:text-2xl">{t.secciones.desafio}</h2>
        <p class="texto-grande" data-revelar>{p.desafio}</p>
      </section>
      <section class="bloque">
        <h2 class="text-xl font-medium tracking-[-0.02em] md:text-2xl">{t.secciones.solucion}</h2>
        <div class="space-y-5">
          {p.solucion.map((s) => <p class="texto" data-revelar>{s}</p>)}
        </div>
      </section>
    </article>

    <!-- Las capturas: pantallas de computadora y una de celular -->
    <div class="galeria grid gap-4 px-5 md:grid-cols-[1fr_0.42fr] md:gap-6 md:px-12">
      <div class="grid gap-4 md:gap-6">
        <Image src={fotos.portada} alt={rellenar(t.portadaDe, { titulo: p.titulo })} widths={[640, 1200, 1800]} sizes="(min-width: 768px) 60vw, calc(100vw - 2.5rem)" loading="lazy" class="block w-full border border-tinta/10" data-revelar />
        {fotos.pantallas.map((img, i) => (
          <Image src={img} alt={rellenar(t.pantallaDe, { titulo: p.titulo, n: i + 2 })} widths={[640, 1200]} sizes="(min-width: 768px) 60vw, calc(100vw - 2.5rem)" loading="lazy" class="block w-full border border-tinta/10" data-revelar />
        ))}
      </div>
      {fotos.mobile && (
        <figure class="md:sticky md:top-24 md:self-start" data-revelar>
          <Image src={fotos.mobile} alt={rellenar(t.celularDe, { titulo: p.titulo })} widths={[390, 780]} sizes="(min-width: 768px) 24vw, 70vw" loading="lazy" class="celular block w-[70vw] md:w-full" />
          <figcaption class="mono mt-3 text-gris">{t.enCelular}</figcaption>
        </figure>
      )}
    </div>

    <article class="caso grid gap-16 px-5 py-24 md:px-12 md:py-32">
      <section class="bloque">
        <h2 class="text-xl font-medium tracking-[-0.02em] md:text-2xl">{t.secciones.destacados}</h2>
        <ul class="detalles">
          {p.destacados.map((d) => (
            <li data-revelar>
              {d}
            </li>
          ))}
        </ul>
      </section>
      {p.resultado && (
        <section class="bloque">
          <h2 class="text-xl font-medium tracking-[-0.02em] md:text-2xl">{t.secciones.resultado}</h2>
          <p class="texto-grande" data-revelar>{p.resultado}</p>
        </section>
      )}
    </article>

    {p.testimonios?.length && (
      <div class="px-5 pb-24 md:px-12 md:pb-32">
        <Criticas testimonios={testimoniosDe(p)} />
      </div>
    )}

    <!-- El siguiente: la portada entra con un barrido al aparecer y, al tocarla, viaja al afiche del próximo caso -->
    <a href={ruta(idioma, 'proyectos', siguiente.slug)} class="siguiente group block px-5 pb-24 md:px-12" data-siguiente data-vt={nombreVt(siguiente.slug)}>
      <p class="border-t border-tinta/15 pt-3 text-lg text-tinta/75">{t.siguiente}</p>
      <div class="mt-8 grid gap-6 md:grid-cols-[1fr_0.8fr] md:items-end">
        <p class="font-titulo text-[clamp(3rem,13vw,10rem)] leading-[0.85] tracking-[-0.01em] siguiente-titulo">
          {siguiente.titulo}
        </p>
        <Image src={fotosSiguiente.portada} alt="" widths={[480, 800]} sizes="(min-width: 768px) 40vw, 100vw" loading="lazy" class="siguiente-foto block w-full" />
      </div>
    </a>

  </main>
  <Pie corto />
  <Motion />
</Base>

<style>
  .bloque {
    display: grid;
    gap: 1.25rem;
    max-width: 72rem;
  }
  @media (min-width: 1024px) {
    .bloque { grid-template-columns: 16rem 1fr; gap: 3rem; }
    .bloque > h2 { padding-top: 0.5rem; }
  }
  /* Cliente, desafío y lo que hicimos: en compu, tres columnas a lo ancho (si no, media pantalla queda vacía) */
  @media (min-width: 1024px) {
    .trio { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: clamp(2rem, 4vw, 4rem); }
    .trio .bloque { grid-template-columns: 1fr; gap: 1rem; }
    .trio .texto-grande { font-size: clamp(1.3rem, 1.8vw, 1.6rem); }
    .trio .texto { font-size: 1.2rem; }
  }
  /* Los detalles, uno al lado del otro, con el mismo trazo corto de la home en vez de rayas */
  .detalles { display: grid; gap: 1.5rem; }
  @media (min-width: 768px) { .detalles { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; } }
  .detalles li { position: relative; padding-top: 1.1rem; font-size: clamp(1.125rem, 1.5vw, 1.35rem); line-height: 1.35; }
  .detalles li::before { content: ''; position: absolute; left: 0; top: 0; width: 0.9rem; height: 3px; border-radius: 3px; background: var(--color-tinta); }
  /* Se lee como un párrafo de revista, no como un título: más chico y con más aire */
  .texto-grande { max-width: 38ch; font-size: clamp(1.3rem, 2.6vw, 1.9rem); line-height: 1.25; letter-spacing: -0.02em; font-weight: 500; }
  .texto { max-width: 46ch; font-size: 1.2rem; line-height: 1.5; color: color-mix(in oklab, var(--color-tinta) 78%, transparent); }
  @media (min-width: 768px) { .texto { font-size: 1.4rem; } }
  .celular { border-radius: 1.75rem; border: 6px solid var(--color-tinta); }
  /* El afiche del caso: vertical o apaisado, como en /proyectos */
  .afiche-caso { position: relative; display: block; container-type: inline-size; overflow: hidden; aspect-ratio: 2 / 3; max-width: min(100%, 34rem); background: var(--color-tinta); }
  .afiche-caso.afiche-quad { aspect-ratio: 16 / 10; max-width: 100%; }
  @media (min-width: 1024px) {
    .apertura-caso.vertical { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 30rem); align-items: end; }
    .apertura-caso.vertical > figure { margin-top: 0; padding-left: 0; padding-top: 10rem; }
    .apertura-caso.vertical .afiche-caso { max-width: none; }
  }
  /* La portada del siguiente entra con un barrido de izquierda a derecha cuando aparece */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .siguiente-foto { clip-path: inset(0 100% 0 0); transition: clip-path 700ms cubic-bezier(0.77, 0, 0.18, 1); }
    :global(.js) .siguiente.visto .siguiente-foto { clip-path: inset(0 0 0 0); }
  }
  /* El título del siguiente proyecto se corre apenas al pasar el mouse */
  .siguiente-titulo { transition: transform 250ms var(--ease-ui); }
  @media (hover: hover) and (pointer: fine) { .group:hover .siguiente-titulo { transform: translateX(0.5rem); } }
</style>

<script>
  const siguiente = document.querySelector<HTMLAnchorElement>('[data-siguiente]');
  if (siguiente) {
    new IntersectionObserver(([e], o) => {
      if (e.isIntersecting) { siguiente.classList.add('visto'); o.disconnect(); }
    }, { rootMargin: '0px 0px -20% 0px' }).observe(siguiente);
    // Al tocarlo, la portada lleva el nombre del afiche del próximo caso y viaja hasta ahí
    siguiente.addEventListener('click', () => {
      const foto = siguiente.querySelector<HTMLElement>('.siguiente-foto');
      if (foto) foto.style.viewTransitionName = siguiente.dataset.vt ?? '';
    });
    addEventListener('pageshow', () => {
      const foto = siguiente.querySelector<HTMLElement>('.siguiente-foto');
      if (foto) foto.style.viewTransitionName = '';
    });
  }
</script>
